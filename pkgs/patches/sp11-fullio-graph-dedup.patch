Subject: [EXPERIMENT] ASoC: AudioReach: avoid duplicate FullIO mixer edges

If a FullIO module already connects the same instance/port endpoints,
do not add the mixer edge a second time. Use a single decision for both
GRAPH_OPEN sizing and serialization; preserve ordinary graphs.

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index 078978c..1a0b2c5 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -668,11 +668,41 @@ static void apm_populate_module_list_obj(struct apm_mod_list_obj *obj,
 	}
 }
 
+/* A topology edge and its DPCM mixer route can describe the same DSP edge. */
+static bool audioreach_needs_mixer_edge(const struct audioreach_graph_info *info)
+{
+	struct audioreach_sub_graph *sg;
+	struct audioreach_container *container;
+	struct audioreach_module *module;
+	int port;
+
+	if (!info->src_mod_inst_id || !info->dst_mod_inst_id)
+		return false;
+	if (!audioreach_fullio_graph(info))
+		return true;
+
+	list_for_each_entry(sg, &info->sg_list, node) {
+		list_for_each_entry(container, &sg->container_list, node) {
+			list_for_each_entry(module, &container->modules_list, node) {
+				if (module->instance_id != info->src_mod_inst_id)
+					continue;
+				for (port = 0; port < module->max_op_port; port++) {
+					if (module->src_mod_op_port_id[port] == info->src_mod_op_port_id &&
+					    module->dst_mod_inst_id[port] == info->dst_mod_inst_id &&
+					    module->dst_mod_ip_port_id[port] == info->dst_mod_ip_port_id)
+						return false;
+				}
+			}
+		}
+	}
+	return true;
+}
+
 static void audioreach_populate_graph(struct q6apm *apm,
 				      const struct audioreach_graph_info *info,
 				      struct apm_graph_open_params *open,
 				      const struct list_head *sg_list,
-				      int num_sub_graphs)
+				      bool needs_mixer_edge)
 {
 	struct apm_mod_conn_list_params *mc_data = open->mod_conn_list_data;
 	struct apm_module_list_params *ml_data = open->mod_list_data;
@@ -693,7 +723,7 @@ static void audioreach_populate_graph(struct q6apm *apm,
 	mlobj = &ml_data->mod_list_obj[0];
 
 
-	if (info->dst_mod_inst_id && info->src_mod_inst_id) {
+	if (needs_mixer_edge) {
 		conn_obj = &mc_data->conn_obj[nconn];
 		conn_obj->src_mod_inst_id = info->src_mod_inst_id;
 		conn_obj->src_mod_op_port_id = info->src_mod_op_port_id;
@@ -773,6 +803,7 @@ void *audioreach_alloc_graph_pkt(struct q6apm *apm,
 	int num_sub_graphs = 0;
 	int num_modules = 0;
 	int num_modules_list;
+	bool needs_mixer_edge = audioreach_needs_mixer_edge(info);
 	struct gpr_pkt *pkt;
 	void *p;
 
@@ -780,7 +811,7 @@ void *audioreach_alloc_graph_pkt(struct q6apm *apm,
 	ml_sz = 0;
 
 	/* add FE-BE connections */
-	if (info->dst_mod_inst_id && info->src_mod_inst_id)
+	if (needs_mixer_edge)
 		num_connections++;
 
 	list_for_each_entry(sgs, sg_list, node) {
@@ -894,7 +925,7 @@ void *audioreach_alloc_graph_pkt(struct q6apm *apm,
 		params.fullio_links->num_ctrl_links = num_ctrl_links;
 	}
 
-	audioreach_populate_graph(apm, info, &params, sg_list, num_sub_graphs);
+	audioreach_populate_graph(apm, info, &params, sg_list, needs_mixer_edge);
 
 	return pkt;
 }
