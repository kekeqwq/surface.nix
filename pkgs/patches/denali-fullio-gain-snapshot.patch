+/* Opt-in, read-only audit of the protected graph's own live endpoint gain.
+ * No write, no retry and no wake: a read is taken only while the render
+ * graph this driver already prepared is published. It is the discriminator
+ * between DSP-side attenuation and anything downstream of every readable
+ * hardware register.
+ */
+static bool fullio_gain_audit;
+module_param(fullio_gain_audit, bool, 0400);
+MODULE_PARM_DESC(fullio_gain_audit, "Expose read-only Denali FullIO DSP master gain");
+
+static ssize_t fullio_master_gain_show(struct device *dev,
+					     struct device_attribute *attr, char *buf)
+{
+	struct q6apm *apm = dev_get_drvdata(dev);
+	struct q6apm_graph *graph;
+	static const struct { u32 iid, param, bytes; const char *name; } sp[] = {
+		{ 0x4027, 0x080011e8, 68, "sp" },
+		{ 0x4024, 0x080011f6, 44, "spvi" },
+		{ 0x4001, 0x0800101e, 4, "sal" },
+		{ 0x4663, 0x08001035, 4, "vol1" },
+		{ 0x4669, 0x08001035, 4, "vol2" },
+		{ 0x4026, 0x08001017, 12, "vimedia" },
+		{ 0x4026, 0x08001063, 12, "viintf" },
+	};
+	u8 blob[68];
+	__le16 words[2];
+	unsigned int crc;
+	int ret, n, len, i, j;
+
+	guard(mutex)(&apm->graph_lock);
+	graph = apm->fullio_active_render;
+	if (!graph)
+		return -EAGAIN;
+	ret = q6apm_fullio_get_cfg(graph, 0x4a63, 0x08001035, words, sizeof(words));
+	if (ret)
+		return ret < 0 ? ret : -EPROTO;
+	n = sysfs_emit(buf, "vol=%#x,%#x", le16_to_cpu(words[0]), le16_to_cpu(words[1]));
+	if (n < 0)
+		return n;
+	/* SP and SPVI live immediately upstream of the DAC sink, downstream of
+	 * VOL_CTRL. Their accepted GET_CFG payloads are already allow-listed,
+	 * so compare the same bounded configuration without any write.
+	 */
+	for (i = 0; i < ARRAY_SIZE(sp); i++) {
+		ret = q6apm_fullio_get_cfg(graph, sp[i].iid, sp[i].param, blob, sp[i].bytes);
+		if (ret) {
+			len = snprintf(buf + n, PAGE_SIZE - n, " %s=err%d", sp[i].name, ret);
+			if (len < 0)
+				return len;
+			n += len;
+			continue;
+		}
+		crc = 0;
+		for (j = 0; j < (int)sp[i].bytes; j++)
+			crc = crc * 33 + ((u8 *)blob)[j];
+		len = snprintf(buf + n, PAGE_SIZE - n, " %s=%#x", sp[i].name, crc);
+		if (len < 0)
+			return len;
+		n += len;
+	}
+	len = snprintf(buf + n, PAGE_SIZE - n, "\n");
+	return len < 0 ? len : n + len;
+}
+static DEVICE_ATTR_ADMIN_RO(fullio_master_gain);
+
+static const struct attribute_group q6apm_fullio_gain_group = {
+	.attrs = (struct attribute *[]){ &dev_attr_fullio_master_gain.attr, NULL },
+};
+
 static const struct snd_kcontrol_new q6apm_fullio_endpoint_controls[] = {
 	SND_SOC_BYTES_TLV("SP11 Windows Volume Transaction", FULLIO_ENDPOINT_TLV_HEADER_BYTES +
 			  FULLIO_ENDPOINT_GAIN_BYTES + FULLIO_GAINSTEP_LARGE_BYTES,
@@ -2504,9 +2575,16 @@ static int q6apm_audio_probe(struct snd_soc_component *component)
 
 	ret = snd_soc_add_component_controls(component, q6apm_fullio_endpoint_controls,
 					     ARRAY_SIZE(q6apm_fullio_endpoint_controls));
-	if (ret)
+	if (ret) {
 		snd_soc_tplg_component_remove(component);
-	return ret;
+		return ret;
+	}
+	if (fullio_gain_audit && of_machine_is_compatible("microsoft,denali")) {
+		ret = devm_device_add_group(component->dev, &q6apm_fullio_gain_group);
+		if (ret)
+			dev_warn(component->dev, "FullIO read-only gain audit unavailable: %d\n", ret);
+	}
+	return 0;
 }
 
