@@ -255,6 +257,8 @@
 	struct gpio_desc *interrupt_gpio;
 	struct gpio_desc *power_gpio;
 	struct gpio_desc *reset_gpio;
+	struct regulator *vdd;
+	bool vdd_enabled;
 	u8 *body;
 	u8 heatmap[G6TS_HEAT_SAMPLES];
 	u8 heat_seen[G6TS_HEAT_SAMPLES];
@@ -480,6 +484,21 @@
 {
 	int ret;
 
+	if (ts->vdd) {
+		/* Denali already owns GPIO64 through its fixed regulator. */
+		gpiod_set_value_cansleep(ts->reset_gpio, 1);
+		if (!ts->vdd_enabled) {
+			ret = regulator_enable(ts->vdd);
+			if (ret)
+				return ret;
+			ts->vdd_enabled = true;
+		}
+		msleep(500);
+		gpiod_set_value_cansleep(ts->reset_gpio, 0);
+		msleep(300);
+		return 0;
+	}
+
 	if (ts->power_gpio && ts->reset_gpio) {
 		gpiod_set_value_cansleep(ts->reset_gpio, 0);
 		gpiod_set_value_cansleep(ts->power_gpio, 1);
@@ -506,6 +525,19 @@
 
 static int g6ts_power_off(struct g6ts *ts)
 {
+	if (ts->vdd) {
+		int ret;
+
+		gpiod_set_value_cansleep(ts->reset_gpio, 1);
+		if (!ts->vdd_enabled)
+			return 0;
+		usleep_range(10000, 12000);
+		ret = regulator_disable(ts->vdd);
+		if (!ret)
+			ts->vdd_enabled = false;
+		return ret;
+	}
+
 	if (ts->power_gpio && ts->reset_gpio) {
 		gpiod_set_value_cansleep(ts->reset_gpio, 0);
 		usleep_range(10000, 12000);
@@ -2833,17 +2865,28 @@
 	if (ret)
 		return dev_err_probe(&spi->dev, ret,
 				     "failed to request interrupt\n");
-	ts->power_gpio =
-		devm_gpiod_get_optional(&spi->dev, "power", GPIOD_OUT_LOW);
-	if (IS_ERR(ts->power_gpio))
-		return dev_err_probe(&spi->dev, PTR_ERR(ts->power_gpio),
-				     "failed to get power GPIO\n");
-	ts->reset_gpio =
-		devm_gpiod_get_optional(&spi->dev, "reset", GPIOD_OUT_LOW);
+	if (device_property_present(&spi->dev, "vdd-supply")) {
+		if (device_property_present(&spi->dev, "power-gpios"))
+			return dev_err_probe(&spi->dev, -EINVAL,
+					     "vdd-supply and power-gpios are mutually exclusive\n");
+		ts->vdd = devm_regulator_get(&spi->dev, "vdd");
+		if (IS_ERR(ts->vdd))
+			return dev_err_probe(&spi->dev, PTR_ERR(ts->vdd),
+					     "failed to get vdd regulator\n");
+		ts->reset_gpio = devm_gpiod_get(&spi->dev, "reset", GPIOD_OUT_HIGH);
+	} else {
+		ts->power_gpio =
+			devm_gpiod_get_optional(&spi->dev, "power", GPIOD_OUT_LOW);
+		if (IS_ERR(ts->power_gpio))
+			return dev_err_probe(&spi->dev, PTR_ERR(ts->power_gpio),
+					     "failed to get power GPIO\n");
+		ts->reset_gpio =
+			devm_gpiod_get_optional(&spi->dev, "reset", GPIOD_OUT_LOW);
+	}
 	if (IS_ERR(ts->reset_gpio))
 		return dev_err_probe(&spi->dev, PTR_ERR(ts->reset_gpio),
 				     "failed to get reset GPIO\n");
-	if (!!ts->power_gpio != !!ts->reset_gpio)
+	if (!ts->vdd && !!ts->power_gpio != !!ts->reset_gpio)
 		return dev_err_probe(&spi->dev, -EINVAL,
 				     "power and reset GPIOs must be paired\n");
 
