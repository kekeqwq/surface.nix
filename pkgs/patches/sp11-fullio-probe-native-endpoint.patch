+		    (!cps && dai->id != WSA_CODEC_DMA_TX_0) ||
+		    of_property_read_string(node, "microsoft,denali-fullio-feedback-probe", &probe) ||
+		    strcmp(probe, cps ? "cps" : "vi"))
+			return -EINVAL;
+		rc = audioreach_fullio_probe_endpoint(dai_data->graph[dai->id], cfg, cps);
+	} else {
+		rc = q6apm_graph_media_format_pcm(dai_data->graph[dai->id], cfg);
+	}
 	if (rc) {
 		dev_err(dai->dev, "Failed to set media format %d\n", rc);
 		goto err;
