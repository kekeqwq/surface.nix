+/* PA-off readback of the bootstrap-set master gain.  Q13 unity is
+ * 0x2000.  Anything above it would amplify and is rejected; the value
+ * is logged so a lower user volume is visible in the audit trail.
+ */
+static int q6apm_fullio_verify_gain_bounds(struct q6apm_graph *graph, bool started)
+{
+	const char *phase = started ? "post-START" : "pre-START";
+	__le16 words[2];
+	int ret = q6apm_fullio_get_cfg(graph, 0x4a63, 0x08001035, words, sizeof(words));
 
+	if (ret)
+		return dev_err_probe(graph->dev, ret < 0 ? ret : -EPROTO,
+				     "FullIO %s master gain GET unverified\n", phase);
+	if (le16_to_cpu(words[0]) > 0x2000 || words[1])
+		return dev_err_probe(graph->dev, -EILSEQ,
+				     "FullIO %s master gain out of bounds: gain=%#x reserved=%#x\n",
+				     phase, le16_to_cpu(words[0]), le16_to_cpu(words[1]));
+	dev_info(graph->dev,
+		 "FullIO %s master gain verified: %#x (Q13 unity=0x2000)\n",
+		 phase, le16_to_cpu(words[0]));
+	return 0;
+}
