diff --git a/sound/soc/qcom/qdsp6/topology.c b/sound/soc/qcom/qdsp6/topology.c
index 911396e..80b5f3b 100755
--- a/sound/soc/qcom/qdsp6/topology.c
+++ b/sound/soc/qcom/qdsp6/topology.c
@@ -212,14 +212,13 @@ static struct audioreach_module *audioreach_tplg_alloc_module(struct q6apm *apm,
  * the two reserved words as zero. Preserve legacy handling of those words.
  */
 #define AR_FULLIO_CTRL_LINK_TYPE 0x08001061
-#define AR_FULLIO_FIRST_STAGE 0x53503101
-#define AR_FULLIO_LAST_STAGE 0x5350310a
 #define AR_RAW_HEADER_SIZE (2 * sizeof(__le32))
 #define AR_FULLIO_HEADER_SIZE sizeof(struct audioreach_module_priv_data)
 
 static bool audioreach_fullio_stage(u32 type)
 {
-	return type >= AR_FULLIO_FIRST_STAGE && type <= AR_FULLIO_LAST_STAGE;
+	return type >= AR_FULLIO_STAGE_BASE &&
+	       type < AR_FULLIO_STAGE_BASE + AR_FULLIO_STAGE_COUNT;
 }
 
 static bool audioreach_raw_record(u32 type)
@@ -408,6 +407,48 @@ audioreach_get_module_priv_data(const struct snd_soc_tplg_private *private, u32
 	return NULL;
 }
 
+static void audioreach_fullio_free_stages(struct audioreach_module *mod)
+{
+	for (int i = 0; i < AR_FULLIO_STAGE_COUNT; i++) {
+		kfree(mod->fullio_stages[i]);
+		mod->fullio_stages[i] = NULL;
+	}
+}
+
+static int audioreach_fullio_load_stages(struct audioreach_module *mod,
+					const struct snd_soc_tplg_private *private)
+{
+	const u8 *data = private->data;
+	size_t remaining = le32_to_cpu(private->size), size;
+	int ret;
+	u32 type;
+
+	while (remaining) {
+		ret = audioreach_private_record(data, remaining, &type, &size);
+		if (ret)
+			goto fail;
+		if (audioreach_fullio_stage(type)) {
+			u32 i = type - AR_FULLIO_STAGE_BASE;
+
+			if (mod->fullio_stages[i]) {
+				ret = -EEXIST;
+				goto fail;
+			}
+			mod->fullio_stages[i] = kmemdup(data, size, GFP_KERNEL);
+			if (!mod->fullio_stages[i]) {
+				ret = -ENOMEM;
+				goto fail;
+			}
+		}
+		data += size;
+		remaining -= size;
+	}
+	return 0;
+fail:
+	audioreach_fullio_free_stages(mod);
+	return ret;
+}
