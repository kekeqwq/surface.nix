Subject: [EXPERIMENT] ASoC: AudioReach: collect a complete FullIO calibration profile

Keep typed private blocks and validate exactly one of each pinned v19c stage
with the expected owner and size. No partial output on failure. The topology
gate remains closed; do not issue calibration or gain commands here.

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index 66bb412..2c4d72a 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -140,6 +140,59 @@ struct apm_graph_open_params {
 	struct apm_fullio_ctrl_links *fullio_links;
 } __packed;
 
+static const struct {
+	u32 instance;
+	u32 bytes;
+} fullio_stage_contract[AR_FULLIO_STAGE_COUNT] = {
+	[AR_FULLIO_BOOTSTRAP] = { 0x4660, 10464 },
+	[AR_FULLIO_RENDER_EP] = { 0x4660, 64 },
+	[AR_FULLIO_SP_TAG] = { 0x4027, 1888 },
+	[AR_FULLIO_SPVI_TAG] = { 0x4024, 1328 },
+	[AR_FULLIO_VI_EP] = { 0x4024, 64 },
+	[AR_FULLIO_DYNAMIC] = { 0x4027, 128 },
+	[AR_FULLIO_GAIN] = { 0x4a63, 120 },
+	[AR_FULLIO_FILTER] = { 0x4a63, 216 },
+	[AR_FULLIO_MUTE] = { 0x4a63, 120 },
+	[AR_FULLIO_MIXER] = { 0x4a63, 40 },
+};
+
+/* Called by the frontend while it owns the graph; no DSP commands here. */
+int audioreach_fullio_collect_stages(const struct audioreach_graph_info *info,
+				    struct audioreach_fullio_stages *stages)
+{
+	struct audioreach_fullio_stages complete = {};
+	const struct audioreach_module_priv_data *blob;
+	struct audioreach_sub_graph *sg;
+	struct audioreach_container *container;
+	struct audioreach_module *module;
+	int i;
+
+	list_for_each_entry(sg, &info->sg_list, node) {
+		list_for_each_entry(container, &sg->container_list, node) {
+			list_for_each_entry(module, &container->modules_list, node) {
+				for (i = 0; i < AR_FULLIO_STAGE_COUNT; i++) {
+					blob = module->fullio_stages[i];
+					if (!blob)
+						continue;
+					if (complete.stage[i])
+						return -EEXIST;
+					if (module->instance_id != fullio_stage_contract[i].instance ||
+					    le32_to_cpu(blob->size) != fullio_stage_contract[i].bytes)
+						return -EINVAL;
+					complete.stage[i] = blob;
+				}
+			}
+		}
+	}
+
+	for (i = 0; i < AR_FULLIO_STAGE_COUNT; i++)
+		if (!complete.stage[i])
+			return -ENOENT;
+	*stages = complete;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(audioreach_fullio_collect_stages);
+
 struct apm_pcm_module_media_fmt_cmd {
 	struct apm_module_param_data param_data;
 	struct param_id_pcm_output_format_cfg header;
