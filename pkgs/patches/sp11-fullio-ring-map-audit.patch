Add an isolated, PA-off FullIO data and position MAP/UNMAP fixture.

--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -485,7 +485,40 @@
 	atomic_set(&fullio_ring_claimed, 0);
 	return ERR_PTR(ret);
 }
+
+/* Mapping-only experiment: never hand either address to a graph. */
+int q6apm_fullio_ring_map_audit(struct q6apm_graph *graph, struct snd_soc_card *card,
+			       size_t bytes, int sid)
+{
+	static atomic_t attempted = ATOMIC_INIT(0);
+	struct device_node *node = card->dev->of_node;
+	struct q6apm_fullio_ring *ring;
+	int ret;
 
+	if (!of_machine_is_compatible("microsoft,denali") ||
+	    !of_property_read_bool(node, "microsoft,denali-fullio-ring-map-audit") ||
+	    !of_property_read_bool(node, "microsoft,denali-fullio-muted-test") ||
+	    !of_property_read_bool(node, "microsoft,denali-fullio-clock-off-audit") ||
+	    of_property_read_bool(node, "microsoft,denali-fullio-dsp-start-audit") ||
+	    of_property_read_bool(node, "microsoft,denali-fullio-post-pa-test"))
+		return -EPERM;
+	guard(mutex)(&graph->apm->graph_lock);
+	if (!graph->ar_graph || READ_ONCE(graph->ar_graph->start_count) ||
+	    !audioreach_fullio_graph(graph->info))
+		return -EPERM;
+	if (atomic_cmpxchg(&attempted, 0, 1))
+		return -EALREADY;
+
+	ring = q6apm_fullio_ring_alloc(graph->apm, graph->dev, bytes, sid);
+	if (IS_ERR(ring))
+		return dev_err_probe(graph->dev, PTR_ERR(ring), "FullIO isolated PCM ring MAP unverified\n");
+	ret = q6apm_fullio_ring_drop(graph->apm, &ring, true);
+	if (!ret)
+		dev_info(graph->dev, "FullIO isolated PCM data and position MAP/UNMAP acknowledged; never supplied to graph\n");
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_ring_map_audit);
