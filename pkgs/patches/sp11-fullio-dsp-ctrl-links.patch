Subject: [EXPERIMENT] ASoC: AudioReach: serialize FullIO GRAPH_OPEN control links

Adapt the control-link list from the pinned Golden v32 reference.
Only stage the ABI encoding; retain the parser gate against running a FullIO
graph. This does not run calibration or alter volume settings.

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index aa1f4e2..3397413 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -2,7 +2,11 @@
 // Copyright (c) 2020, Linaro Limited
 
 #include <linux/kernel.h>
+#include <linux/overflow.h>
+#include <linux/unaligned.h>
+#include <uapi/sound/snd_ar_tokens.h>
 #include <linux/slab.h>
+#include <linux/sizes.h>
 #include <linux/soc/qcom/apr.h>
 #include <sound/soc.h>
 #include <sound/soc-dai.h>
@@ -109,6 +113,15 @@ struct apm_mod_conn_list_params {
 
 #define APM_MOD_CONN_PSIZE(p, n) ALIGN(struct_size(p, conn_obj, n), 8)
 
+#define APM_PARAM_ID_MODULE_CTRL_LINK_CFG 0x08001061
+#define APM_FULLIO_CTRL_CAP SZ_64K
+
+struct apm_fullio_ctrl_links {
+	struct apm_module_param_data param_data;
+	u32 num_ctrl_links;
+	u8 payload[];
+} __packed;
+
 struct apm_graph_open_params {
 	struct apm_cmd_header *cmd_header;
 	struct apm_sub_graph_params *sg_data;
@@ -116,6 +129,7 @@ struct apm_graph_open_params {
 	struct apm_module_list_params *mod_list_data;
 	struct apm_prop_list_params *mod_prop_data;
 	struct apm_mod_conn_list_params *mod_conn_list_data;
+	struct apm_fullio_ctrl_links *fullio_links;
 } __packed;
 
 struct apm_pcm_module_media_fmt_cmd {
@@ -423,6 +437,7 @@ static void audioreach_populate_graph(struct q6apm *apm,
 	struct audioreach_sub_graph *sg;
 	struct apm_container_obj *cobj;
 	struct apm_mod_list_obj *mlobj;
+	u8 *links = open->fullio_links ? open->fullio_links->payload : NULL;
 	int i = 0;
 
 	mlobj = &ml_data->mod_list_obj[0];
@@ -454,6 +469,15 @@ static void audioreach_populate_graph(struct q6apm *apm,
 				module_prop_obj = &mp_data->mod_prop_obj[nmodule++];
 				apm_populate_module_prop_obj(module_prop_obj, module);
 
+				if (links && module->fullio_ctrl_links) {
+					const struct audioreach_module_priv_data *blob =
+						module->fullio_ctrl_links;
+					size_t bytes = le32_to_cpu(blob->size) - sizeof(u32);
+
+					memcpy(links, blob->data + 1, bytes);
+					links += bytes;
+				}
+
 				if (!module->max_op_port)
 					continue;
 
@@ -494,6 +518,8 @@ void *audioreach_alloc_graph_pkt(struct q6apm *apm,
 	struct audioreach_sub_graph *sgs;
 	struct apm_mod_list_obj *mlobj;
 	const struct list_head *sg_list;
+	u32 num_ctrl_links = 0;
+	size_t ctrl_bytes = 0, ctrl_sz = 0;
 	int num_connections = 0;
 	int num_containers = 0;
 	int num_sub_graphs = 0;
@@ -519,6 +545,21 @@ void *audioreach_alloc_graph_pkt(struct q6apm *apm,
 
 			list_for_each_entry(module, &container->modules_list, node) {
 				num_connections += module->num_connections;
+				if (module->fullio_ctrl_links) {
+					const struct audioreach_module_priv_data *blob =
+						module->fullio_ctrl_links;
+					size_t bytes = le32_to_cpu(blob->size);
+					u32 count;
+
+					if (bytes <= sizeof(u32) || bytes > APM_FULLIO_CTRL_CAP)
+						return ERR_PTR(-EINVAL);
+					count = get_unaligned_le32(blob->data);
+					if (!count || check_add_overflow(num_ctrl_links, count,
+									  &num_ctrl_links) ||
+					    check_add_overflow(ctrl_bytes, bytes - sizeof(u32),
+							       &ctrl_bytes) || ctrl_bytes > APM_FULLIO_CTRL_CAP)
+						return ERR_PTR(-EINVAL);
+				}
 			}
 		}
 	}
@@ -532,7 +573,11 @@ void *audioreach_alloc_graph_pkt(struct q6apm *apm,
 	mp_sz = APM_MOD_PROP_PSIZE(mprop, num_modules);
 	mc_sz =	APM_MOD_CONN_PSIZE(mcon, num_connections);
 
+	if (num_ctrl_links)
+		ctrl_sz = ALIGN(sizeof(struct apm_fullio_ctrl_links) + ctrl_bytes, 8);
 	payload_size = sg_sz + cont_sz + ml_sz + mp_sz + mc_sz;
+	if (check_add_overflow(payload_size, (int)ctrl_sz, &payload_size))
+		return ERR_PTR(-EOVERFLOW);
 	pkt = audioreach_alloc_apm_cmd_pkt(payload_size, APM_CMD_GRAPH_OPEN, 0);
 	if (IS_ERR(pkt))
 		return pkt;
@@ -584,6 +629,16 @@ void *audioreach_alloc_graph_pkt(struct q6apm *apm,
 	params.mod_conn_list_data->num_connections = num_connections;
 	p += mc_sz;
 
+	params.fullio_links = NULL;
+	if (num_ctrl_links) {
+		params.fullio_links = p;
+		param_data = &params.fullio_links->param_data;
+		param_data->module_instance_id = APM_MODULE_INSTANCE_ID;
+		param_data->param_id = APM_PARAM_ID_MODULE_CTRL_LINK_CFG;
+		param_data->param_size = sizeof(u32) + ctrl_bytes;
+		params.fullio_links->num_ctrl_links = num_ctrl_links;
+	}
+
 	audioreach_populate_graph(apm, info, &params, sg_list, num_sub_graphs);
 
 	return pkt;
