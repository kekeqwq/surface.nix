+static bool q6apm_fullio_no_render_backing(struct snd_soc_component *component,
+					   const struct snd_pcm *pcm, int graph_id)
+{
+	/* The capture-only DT suppresses open on the pinned playback FE. */
+	return graph_id == 0 && pcm->streams[SNDRV_PCM_STREAM_PLAYBACK].substream &&
+	       !pcm->streams[SNDRV_PCM_STREAM_CAPTURE].substream &&
+	       q6apm_fullio_capture_only(component);
 }
 
