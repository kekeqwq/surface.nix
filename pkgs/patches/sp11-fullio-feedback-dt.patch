Subject: [EXPERIMENT] arm64: dts: Denali: describe FullIO VI/CPS feedback links

Carry over the VI/CPS link contracts from the pinned SP11X1e-audio FullIO
v19c DTB while preserving the native Denali OLED hardware description.
Depends on the FullIO capture DT patch. Select only for the muted
FullIO diagnostic fixture, not for the default Denali system.

diff --git a/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi b/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi
index 3448580..aa43ecd 100755
--- a/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi
+++ b/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi
@@ -326,7 +326,8 @@
 
 	sound {
 		compatible = "qcom,x1e80100-sndcard";
-		model = "X1E80100-Microsoft-Surface-Pro-11";
+		model = "X1E80100-Microsoft-Surface-Pro-11-FullIO-v19c0";
+		microsoft,denali-fullio-muted-test;
 		audio-routing = "SpkrLeft IN", "WSA WSA_SPK1 OUT",
 				"SpkrRight IN", "WSA WSA_SPK2 OUT",
 				"VA DMIC0", "vdd-micb",
@@ -370,7 +370,7 @@
 			link-name = "WSA Playback";
 
 			codec {
-				sound-dai = <&left_spkr>, <&right_spkr>,
+				sound-dai = <&left_spkr 0>, <&right_spkr 0>,
 					    <&swr0 0>, <&lpass_wsamacro 0>;
 			};
 
@@ -383,6 +383,40 @@
 			};
 		};
 
+		wsa-vi-dai-link {
+			link-name = "WSA VI Protection";
+
+			codec {
+				sound-dai = <&left_spkr 1>, <&right_spkr 1>,
+					    <&swr0 9>, <&lpass_wsamacro 2>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai WSA_CODEC_DMA_TX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		wsa-cps-dai-link {
+			link-name = "WSA CPS Protection";
+
+			codec {
+				sound-dai = <&left_spkr 2>, <&right_spkr 2>,
+					    <&swr0 10>, <&lpass_wsamacro 4>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai WSA_CODEC_DMA_TX_1>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
 		tx-dmic-dai-link {
 			link-name = "TX DMIC Capture";
 
@@ -1169,6 +1203,7 @@
 };
 
 &swr0 {
+	qcom,denali-fullio-feedback;
 	status = "okay";
 
 	pinctrl-0 = <&wsa_swr_active>, <&spkr_01_sd_n_active>;
@@ -1179,11 +1214,13 @@
 		compatible = "sdw20217020400";
 		reg = <0 0>;
 		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
-		#sound-dai-cells = <0>;
+		#sound-dai-cells = <1>;
 		sound-name-prefix = "SpkrLeft";
 		vdd-1p8-supply = <&vreg_l15b_1p8>;
 		vdd-io-supply = <&vreg_l12b_1p2>;
 		qcom,port-mapping = <1 2 3 7 10 13>;
+		qcom,enable-cps;
+		qcom,cps-offset1 = <0>;
 	};
 
 	/* WSA8845, Right Speaker */
@@ -1191,11 +1228,13 @@
 		compatible = "sdw20217020400";
 		reg = <0 1>;
 		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
-		#sound-dai-cells = <0>;
+		#sound-dai-cells = <1>;
 		sound-name-prefix = "SpkrRight";
 		vdd-1p8-supply = <&vreg_l15b_1p8>;
 		vdd-io-supply = <&vreg_l12b_1p2>;
 		qcom,port-mapping = <4 5 6 7 11 13>;
+		qcom,enable-cps;
+		qcom,cps-offset1 = <25>;
 	};
 };
 
