Subject: [EXPERIMENT] ASoC: AudioReach: sequence FullIO calibration without render

Preflight all dynamic single frames then sequence SET_CFG and readback.
Abort at the first error or missing transport, with no bypass or higher gain.
Keep a separate mandatory graph-start gate and no live calibration call sites.

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index a9df753..b82f573 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -234,6 +234,127 @@ int audioreach_fullio_verify_tag(struct q6apm_graph *graph,
 }
 EXPORT_SYMBOL_GPL(audioreach_fullio_verify_tag);
 
+bool audioreach_fullio_graph(const struct audioreach_graph_info *info)
+{
+	struct audioreach_sub_graph *sg;
+	struct audioreach_container *container;
+	struct audioreach_module *module;
+
+	list_for_each_entry(sg, &info->sg_list, node) {
+		list_for_each_entry(container, &sg->container_list, node) {
+			list_for_each_entry(module, &container->modules_list, node) {
+				if (module->integrated_backend_id || module->fullio_ctrl_links)
+					return true;
+				for (int i = 0; i < AR_FULLIO_STAGE_COUNT; i++)
+					if (module->fullio_stages[i])
+						return true;
+			}
+		}
+	}
+	return false;
+}
+EXPORT_SYMBOL_GPL(audioreach_fullio_graph);
+
+static int audioreach_fullio_dynamic_frame(const struct audioreach_module_priv_data *blob,
+					   unsigned int wanted, const u8 **frame, size_t *bytes)
+{
+	static const struct { u32 instance, param, size; } expected[] = {
+		{ 0x4027, 0x080011e9, 8 },
+		{ 0x4024, 0x080011f5, 24 },
+		{ 0x4024, 0x080011f4, 24 },
+		{ 0x4024, 0x080011ff, 8 },
+	};
+	const u8 *cursor = (const u8 *)blob->data;
+	size_t left = le32_to_cpu(blob->size), span;
+	unsigned int i;
+
+	if (wanted >= ARRAY_SIZE(expected))
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(expected); i++) {
+		span = ALIGN(APM_MODULE_PARAM_DATA_SIZE + expected[i].size, 8);
+		if (left < span || get_unaligned_le32(cursor) != expected[i].instance ||
+		    get_unaligned_le32(cursor + 4) != expected[i].param ||
+		    get_unaligned_le32(cursor + 8) != expected[i].size ||
+		    get_unaligned_le32(cursor + 12))
+			return -EINVAL;
+		if (i == wanted) {
+			*frame = cursor;
+			*bytes = span;
+		}
+		left -= span;
+		cursor += span;
+	}
+	return left ? -EINVAL : 0;
+}
+
+/* Bootstrap includes reference VOL_CTRL defaults; no final-volume stage or
+ * GRAPH_START here. Validate hardware PA-off and conservative caps first.
+ */
+int audioreach_fullio_calibrate(struct q6apm_graph *graph,
+			       const struct audioreach_fullio_stages *stages,
+			       struct q6apm_fullio_oob_region *region, void *buffer)
+{
+	enum fullio_op { OOB, SINGLE, READBACK };
+	static const struct {
+		enum fullio_op op;
+		enum ar_fullio_stage_id stage;
+		unsigned int index;
+	} steps[] = {
+		{ OOB, AR_FULLIO_BOOTSTRAP },
+		{ SINGLE, AR_FULLIO_DYNAMIC, 0 },
+		{ OOB, AR_FULLIO_SP_TAG },
+		{ READBACK, AR_FULLIO_SP_TAG },
+		{ READBACK, AR_FULLIO_SPVI_TAG },
+		{ SINGLE, AR_FULLIO_DYNAMIC, 1 },
+		{ SINGLE, AR_FULLIO_DYNAMIC, 2 },
+		{ SINGLE, AR_FULLIO_DYNAMIC, 3 },
+		{ OOB, AR_FULLIO_SPVI_TAG },
+		{ OOB, AR_FULLIO_RENDER_EP },
+		{ OOB, AR_FULLIO_VI_EP },
+	};
+	const struct audioreach_module_priv_data *blob;
+	const u8 *dynamic[4];
+	size_t dynamic_bytes[4];
+	int i, ret;
+
+	if (!graph->ar_graph || READ_ONCE(graph->ar_graph->start_count) ||
+	    !audioreach_fullio_graph(graph->info))
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(steps); i++)
+		if (!stages->stage[steps[i].stage])
+			return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(dynamic); i++) {
+		ret = audioreach_fullio_dynamic_frame(stages->stage[AR_FULLIO_DYNAMIC],
+						      i, &dynamic[i], &dynamic_bytes[i]);
+		if (ret)
+			return ret;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(steps); i++) {
+		if (!q6apm_fullio_transport_enabled(graph->apm))
+			return -EAGAIN;
+		blob = stages->stage[steps[i].stage];
+		switch (steps[i].op) {
+		case OOB:
+			ret = q6apm_fullio_set_cfg_oob(graph, region, buffer, blob->data,
+						     le32_to_cpu(blob->size),
+						     steps[i].stage != AR_FULLIO_BOOTSTRAP);
+			break;
+		case SINGLE:
+			ret = q6apm_fullio_set_cfg_inband(graph, dynamic[steps[i].index],
+							dynamic_bytes[steps[i].index]);
+			break;
+		case READBACK:
+			ret = audioreach_fullio_verify_tag(graph, stages, steps[i].stage);
+			break;
+		}
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(audioreach_fullio_calibrate);
+
