+static int q6apm_fullio_copy_endpoint_tlv(const unsigned int __user *tlv,
+					 unsigned int size, void *payload, size_t bytes)
+{
+	u32 header[2];
+
+	if (size != sizeof(header) + bytes)
+		return -EINVAL;
+	if (copy_from_user(header, tlv, sizeof(header)))
+		return -EFAULT;
+	/* ASoC clamps size to the control maximum before reaching us. */
+	if (header[0] || header[1] != bytes)
+		return -EINVAL;
+	if (copy_from_user(payload, tlv + ARRAY_SIZE(header), bytes))
+		return -EFAULT;
+	return 0;
+}
+
+static int q6apm_fullio_volume_only_put(struct snd_kcontrol *kcontrol,
+				       const unsigned int __user *bytes, unsigned int size)
+{
+	__le32 gain[2];
+	int ret;
+
+	ret = q6apm_fullio_copy_endpoint_tlv(bytes, size, gain, sizeof(gain));
+	if (ret)
+		return ret;
+	return q6apm_fullio_endpoint_put(kcontrol,
+		audioreach_alloc_fullio_final_volume(le32_to_cpu(gain[0]), le32_to_cpu(gain[1])));
+}
+
+static int q6apm_fullio_endpoint_mute_put(struct snd_kcontrol *kcontrol,
+					 const unsigned int __user *bytes, unsigned int size)
+{
+	__le32 mute;
+	int ret;
+
+	ret = q6apm_fullio_copy_endpoint_tlv(bytes, size, &mute, sizeof(mute));
+	if (ret)
+		return ret;
+	if (le32_to_cpu(mute) > 1)
+		return -EINVAL;
+	return q6apm_fullio_endpoint_put(kcontrol, audioreach_alloc_fullio_final_mute(le32_to_cpu(mute)));
+}
