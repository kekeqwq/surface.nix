+static int q6apm_fullio_map_gainstep(struct q6apm *apm, struct q6apm_fullio_ring *ring)
+{
+	struct q6apm_fullio_oob_region *region = &ring->gainstep;
+	int ret;
+
+	lockdep_assert_held(&apm->graph_lock);
+	if (region->poisoned)
+		return -ENOTRECOVERABLE;
+	if (region->handle)
+		return 0;
+
+	ring->gainstep_cpu = dma_alloc_coherent(ring->dev, SZ_4K, &ring->gainstep_dma, GFP_KERNEL);
+	if (!ring->gainstep_cpu)
+		return -ENOMEM;
+	ret = -ERANGE;
+	if (ring->sid >= 0 && upper_32_bits(ring->gainstep_dma))
+		goto free_page;
+
+	region->dsp_addr = (u64)ring->gainstep_dma | (ring->sid < 0 ? 0 : (u64)ring->sid << 32);
+	region->size = SZ_4K;
+	ret = q6apm_fullio_oob_map(apm, region);
+	if (!ret) {
+		if (region->handle != ring->data.handle && region->handle != ring->pos.handle)
+			return 0;
+		/* An aliased handle cannot be retired on either owner's behalf. */
+		region->poisoned = true;
+		if (region->handle == ring->data.handle)
+			ring->data.poisoned = true;
+		if (region->handle == ring->pos.handle)
+			ring->pos.poisoned = true;
+		return -EPROTO;
+	}
+	if (region->poisoned)
+		return ret;
+
+free_page:
+	dma_free_coherent(ring->dev, SZ_4K, ring->gainstep_cpu, ring->gainstep_dma);
+	ring->gainstep_cpu = NULL;
+	return ret;
+}
