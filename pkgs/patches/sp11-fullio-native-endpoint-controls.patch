+/* FullIO v19c renders through the fixed graph 0. Never open a graph on
+ * behalf of a mixer transaction. graph_lock preserves owner and mapping.
+ */
+static struct audioreach_graph *q6apm_fullio_running_render(struct q6apm *apm)
+{
+	struct audioreach_graph *graph;
+
+	lockdep_assert_held(&apm->graph_lock);
+	graph = idr_find(&apm->graph_idr, 0);
+	if (!graph || !audioreach_fullio_graph(graph->info) || !graph->start_count)
+		return ERR_PTR(-EAGAIN);
+	if (apm->fullio_close_failed || !q6apm_fullio_transport_enabled(apm))
+		return ERR_PTR(-ENOTRECOVERABLE);
+	return graph;
+}
+
+static int q6apm_fullio_endpoint_put(struct snd_kcontrol *kcontrol, struct gpr_pkt *packet)
+{
+	struct gpr_pkt *pkt __free(kfree) = packet;
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct q6apm *apm = dev_get_drvdata(component->dev);
+	struct audioreach_graph *graph;
+
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	guard(mutex)(&apm->graph_lock);
+	graph = q6apm_fullio_running_render(apm);
+	if (IS_ERR(graph))
+		return PTR_ERR(graph);
+	return q6apm_fullio_oob_rpc(apm, NULL, pkt, NULL, NULL);
+}
