 static int q6apm_audio_probe(struct snd_soc_component *component)
 {
-	return audioreach_tplg_init(component);
+	struct q6apm *apm = dev_get_drvdata(component->dev);
+	struct audioreach_graph_info *info;
+	int ret = audioreach_tplg_init(component);
+
+	if (ret || !of_machine_is_compatible("microsoft,denali") ||
+	    of_property_read_bool(component->card->dev->of_node, "microsoft,denali-fullio-muted-test"))
+		return ret;
+
+	info = idr_find(&apm->graph_info_idr, 0);
+	if (!info || !audioreach_fullio_graph(info))
+		return 0;
+
+	ret = snd_soc_add_component_controls(component, q6apm_fullio_endpoint_controls,
+					     ARRAY_SIZE(q6apm_fullio_endpoint_controls));
+	if (ret)
+		snd_soc_tplg_component_remove(component);
+	return ret;
 }
 
