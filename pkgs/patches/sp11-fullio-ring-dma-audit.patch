+int q6apm_fullio_ring_position_audit(struct q6apm_graph *graph, bool started)
+{
+	struct q6apm_fullio_ring *ring = graph->ar_graph->fullio_ring;
+	const __le32 *pos;
+	u32 previous = 0, index, seq;
+
+	lockdep_assert_held(&graph->apm->graph_lock);
+	if (!ring || !ring->config_bytes || ring->start_attempted != started)
+		return -EPERM;
+	pos = ring->cpu + ring->data.size;
+	if (!started) {
+		if (memchr_inv(pos, 0, ring->pos.size) || memchr_inv(ring->cpu, 0, ring->data.size))
+			return -EILSEQ;
+		dma_wmb();
+		return 0;
+	}
+	/* Require two distinct, coherent DSP publications, not a START ACK
+	 * or a single initial position. A zero counter is not a publication.
+	 */
+	for (int i = 0; i < 8; i++) {
+		seq = le32_to_cpu(READ_ONCE(pos[0]));
+		dma_rmb();
+		index = le32_to_cpu(READ_ONCE(pos[1]));
+		dma_rmb();
+		if (seq && seq == le32_to_cpu(READ_ONCE(pos[0]))) {
+			if (index >= ring->config_bytes)
+				return -ERANGE;
+			if (previous && seq > previous) {
+				dev_info(graph->dev, "FullIO independent ring: DSP position counter progressed\n");
+				return 0;
+			}
+			previous = seq;
+		}
+		if (i < 7)
+			usleep_range(3000, 4000);
+	}
+	return -ENODATA;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_ring_position_audit);
 
