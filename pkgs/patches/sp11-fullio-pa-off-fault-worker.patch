+/* SoundWire delivers status under bus locks. Publish work only; never
+ * run a regmap, clock or PCM transaction from this notification.
+ */
+static bool wsa884x_fullio_queue_fault(struct wsa884x_priv *amp)
+{
+	unsigned long flags;
+	bool armed;
+
+	spin_lock_irqsave(&amp->fullio_fault_lock, flags);
+	armed = amp->fullio_fault_work != NULL;
+	if (armed)
+		schedule_work(amp->fullio_fault_work);
+	spin_unlock_irqrestore(&amp->fullio_fault_lock, flags);
+	return armed;
+}
+
