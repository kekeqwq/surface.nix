+static struct wsa884x_priv *wsa884x_fullio_fault_audit_amp(struct snd_soc_component *component)
+{
+	struct wsa884x_priv *amp;
+
+	if (!component || component->driver != &wsa884x_component_drv ||
+	    !wsa884x_fullio_pa_stop_audit(component) ||
+	    !of_property_read_bool(component->card->dev->of_node,
+				   "microsoft,denali-fullio-pa-off-fault-worker"))
+		return NULL;
+	amp = dev_get_drvdata(component->dev);
+	return amp && amp->feedback_enabled ? amp : NULL;
+}
+
+/* The caller owns the playback-link lifetime and must disarm both codecs
+ * before flushing/freeing its work. No code in the callback owns the work.
+ */
+int wsa884x_fullio_fault_watch(struct snd_soc_component *component,
+			      struct work_struct *work, bool arm);
+int wsa884x_fullio_fault_watch(struct snd_soc_component *component,
+			      struct work_struct *work, bool arm)
+{
+	struct wsa884x_priv *amp = wsa884x_fullio_fault_audit_amp(component);
+	unsigned long flags;
+	int ret = 0;
+
+	if (!amp || !work)
+		return -EOPNOTSUPP;
+	spin_lock_irqsave(&amp->fullio_fault_lock, flags);
+	if (arm) {
+		if (amp->fullio_fault_work)
+			ret = -EBUSY;
+		else if (READ_ONCE(amp->slave->status) != SDW_SLAVE_ATTACHED)
+			ret = -ENODEV;
+		else
+			amp->fullio_fault_work = work;
+	} else if (amp->fullio_fault_work == work) {
+		amp->fullio_fault_work = NULL;
+	} else {
+		ret = -ESTALE;
+	}
+	spin_unlock_irqrestore(&amp->fullio_fault_lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(wsa884x_fullio_fault_watch);
+
+int wsa884x_fullio_fault_inject(struct snd_soc_component *component);
+int wsa884x_fullio_fault_inject(struct snd_soc_component *component)
+{
+	struct wsa884x_priv *amp = wsa884x_fullio_fault_audit_amp(component);
+
+	/* Exercise notification only. Never manufacture a SoundWire state. */
+	return amp && wsa884x_fullio_queue_fault(amp) ? 0 : -EOPNOTSUPP;
+}
+EXPORT_SYMBOL_GPL(wsa884x_fullio_fault_inject);
