+struct q6apm_fullio_fault_work {
+	struct work_struct work;
+	struct snd_soc_card *card;
+	atomic_t fired;
+	int result;
+};
+
+static void q6apm_fullio_fault_worker(struct work_struct *work)
+{
+	struct q6apm_fullio_fault_work *audit = container_of(work, typeof(*audit), work);
+
+	/* A pair of status notices can requeue one work item across execution. */
+	if (atomic_cmpxchg(&audit->fired, 0, 1))
+		return;
+	/* No PCM, graph or DSP lock/transaction in the worker. */
+	audit->result = q6apm_fullio_stop_pair_audit(audit->card);
+}
+
+static int q6apm_fullio_fault_worker_audit(struct snd_soc_card *card, bool *verified)
+{
+	struct q6apm_fullio_fault_work audit = { .card = card, .fired = ATOMIC_INIT(0) };
+	struct q6apm_fullio_amp_pair pair = {};
+	int ret, cleanup;
+
+	ret = q6apm_fullio_amp_pair(card, "WSA Playback", &pair);
+	if (ret)
+		return ret;
+	INIT_WORK_ONSTACK(&audit.work, q6apm_fullio_fault_worker);
+	ret = wsa884x_fullio_fault_watch(pair.left, &audit.work, true);
+	if (ret)
+		goto join;
+	ret = wsa884x_fullio_fault_watch(pair.right, &audit.work, true);
+	if (!ret) {
+		ret = wsa884x_fullio_fault_inject(pair.left);
+		cleanup = wsa884x_fullio_fault_watch(pair.right, &audit.work, false);
+		ret = ret ?: cleanup;
+	}
+	cleanup = wsa884x_fullio_fault_watch(pair.left, &audit.work, false);
+	ret = ret ?: cleanup;
+join:
+	/* All device slots are revoked under their notifier locks before join. */
+	flush_work(&audit.work);
+	destroy_work_on_stack(&audit.work);
+	if (ret || audit.result || !atomic_read(&audit.fired))
+		return ret ?: audit.result ?: -ENODATA;
+	*verified = true;
+	dev_info(card->dev, "FullIO synthetic fault notice: paired PA-off worker verified before DSP STOP\n");
+	return -ECANCELED;
+}
