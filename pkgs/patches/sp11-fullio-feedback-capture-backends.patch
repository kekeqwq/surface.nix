Subject: [EXPERIMENT] ASoC: add a separate Denali feedback capture backend

Advertise capture transport without changing the existing companion playback
path. Require a separate controller flag and an exact muted card probe match
before using the feedback allocator from a capture stream.

diff --git a/drivers/soundwire/qcom.c b/drivers/soundwire/qcom.c
index ef45b97..7d1f6b8 100755
--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -1448,6 +1448,12 @@ static int qcom_swrm_denali_alloc_feedback(struct qcom_swrm_ctrl *ctrl,
 	return ret;
 }
 
+static bool qcom_swrm_fullio_capture_probe(struct qcom_swrm_ctrl *ctrl)
+{
+	return of_property_read_bool(ctrl->dev->of_node,
+				     "qcom,denali-fullio-feedback-capture-test");
+}
+
 static int qcom_swrm_hw_params(struct snd_pcm_substream *substream,
 			       struct snd_pcm_hw_params *params,
 			      struct snd_soc_dai *dai)
@@ -1456,10 +1462,24 @@ static int qcom_swrm_hw_params(struct snd_pcm_substream *substream,
 	struct sdw_stream_runtime *sruntime = ctrl->sruntime[dai->id];
 	int ret;
 
-	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK &&
-	    qcom_swrm_denali_feedback(ctrl, dai->id))
-		return qcom_swrm_denali_alloc_feedback(ctrl, sruntime, dai->id,
-						      params_rate(params));
+	if (qcom_swrm_denali_feedback(ctrl, dai->id)) {
+		if (qcom_swrm_fullio_capture_probe(ctrl)) {
+			struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+			struct device_node *node = rtd->card->dev->of_node;
+			const char *probe;
+
+			if (substream->stream != SNDRV_PCM_STREAM_CAPTURE ||
+			    !of_property_read_bool(node, "microsoft,denali-fullio-muted-test") ||
+			    of_property_read_string(node, "microsoft,denali-fullio-feedback-probe", &probe) ||
+			    strcmp(probe, dai->id == 9 ? "vi" : "cps"))
+				return -EOPNOTSUPP;
+			return qcom_swrm_denali_alloc_feedback(ctrl, sruntime, dai->id,
+							      params_rate(params));
+		}
+		if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK)
+			return qcom_swrm_denali_alloc_feedback(ctrl, sruntime, dai->id,
+							      params_rate(params));
+	}
 
 	ret = qcom_swrm_stream_alloc_ports(ctrl, sruntime, params,
 					   substream->stream);
@@ -1582,6 +1602,11 @@ static int qcom_swrm_register_dais(struct qcom_swrm_ctrl *ctrl)
 				.rates = cps ? SNDRV_PCM_RATE_24000 : SNDRV_PCM_RATE_8000,
 				.formats = SNDRV_PCM_FMTBIT_S32_LE,
 			};
+			if (qcom_swrm_fullio_capture_probe(ctrl)) {
+				dais[i].capture = dais[i].playback;
+				dais[i].capture.stream_name = cps ? "SoundWire CPS Capture" :
+								   "SoundWire VI Capture";
+			}
 		}
 
 		dais[i].ops = &qcom_swrm_pdm_dai_ops;
diff --git a/sound/soc/codecs/lpass-wsa-macro.c b/sound/soc/codecs/lpass-wsa-macro.c
index 52d0d02..0f223df 100755
--- a/sound/soc/codecs/lpass-wsa-macro.c
