@@ -1500,6 +1500,15 @@ static struct snd_soc_dai_driver wsa_macro_dai[] = {
 			.channels_min = 2,
 			.channels_max = 2,
 		},
+		.capture = {
+			.stream_name = "WSA_AIF_CPS Capture",
+			.rates = SNDRV_PCM_RATE_24000,
+			.formats = SNDRV_PCM_FMTBIT_S32_LE,
+			.rate_max = 24000,
+			.rate_min = 24000,
+			.channels_min = 2,
+			.channels_max = 2,
+		},
 		.ops = &wsa_macro_dai_ops,
 	},
 };
@@ -2417,6 +2426,8 @@ static const struct snd_soc_dapm_widget wsa_macro_dapm_widgets[] = {
 			      SND_SOC_DAPM_POST_PMU | SND_SOC_DAPM_POST_PMD),
 	SND_SOC_DAPM_AIF_OUT("WSA AIF_ECHO", "WSA_AIF_ECHO Capture", 0,
 			     SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_AIF_OUT("WSA AIF_CPS Capture", "WSA_AIF_CPS Capture", 0,
+			     SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_IN("WSA AIF_CPS Protection",
 			    "WSA_AIF_CPS Protection", 0,
 			    SND_SOC_NOPM, 0, 0),
@@ -2527,6 +2538,8 @@ static const struct snd_soc_dapm_route wsa_audio_map[] = {
 	/* CPS feedback is a distinct transport from VI; only the shared macro
 	 * clock is required here.  DP6 framing is programmed by SoundWire.
 	 */
+	{"WSA AIF_CPS Capture", NULL, "CPSINPUT_WSA"},
+	{"WSA AIF_CPS Capture", NULL, "WSA_MCLK"},
 	{"WSA AIF_CPS Protection", NULL, "CPSINPUT_WSA"},
 	{"WSA AIF_CPS Protection", NULL, "WSA_MCLK"},
 
