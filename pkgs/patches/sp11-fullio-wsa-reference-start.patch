+static int wsa884x_fullio_reference_start(struct wsa884x_priv *amp)
+{
+	static const struct reg_sequence sequence[] = {
+		{ WSA884X_ISENSE2, 0x07 },
+		{ WSA884X_VSENSE1, 0x67 },
+		{ WSA884X_INTR_MASK0, 0x90 },
+		{ WSA884X_INTR_MASK1, 0x00 },
+		{ WSA884X_CLSH_CTL_0, 0x67 },
+		{ WSA884X_PWRSTG_DBG, 0x08 },
+		{ WSA884X_PDRV_HS_CTL, 0x52 },
+		{ WSA884X_PA_FSM_EN, 0x01 },
+		{ WSA884X_PWRSTG_DBG, 0x0c },
+		{ WSA884X_PDRV_HS_CTL, 0x5a },
+	};
+	int ret;
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(sequence); ++i) {
+		ret = regmap_write(amp->regmap, sequence[i].reg, sequence[i].def);
+		if (ret)
+			return ret;
+	}
+	usleep_range(1000, 1100);
+	return 0;
+}
+
+struct wsa884x_fullio_start_pair {
+	struct snd_soc_component *codec[2];
+	struct wsa884x_priv *amp[2];
+	s64 epoch[2];
+	int (*verify_graph)(void *);
+	void *context;
+};
+
+static int wsa884x_fullio_verify_transport(struct wsa884x_priv *amp)
+{
+	if (!READ_ONCE(amp->hw_init) || READ_ONCE(amp->slave->status) != SDW_SLAVE_ATTACHED)
+		return -ENODEV;
+	for (unsigned int i = WSA884X_DAI_PLAYBACK; i <= WSA884X_DAI_CPS; ++i) {
+		struct sdw_stream_runtime *transport = READ_ONCE(amp->attached[i]);
+
+		if (!transport || READ_ONCE(transport->state) != SDW_STREAM_ENABLED)
+			return -EPIPE;
+	}
+	return 0;
+}
+
+static int wsa884x_fullio_check_pair(struct wsa884x_fullio_start_pair *pair)
+{
+	int ret = pair->verify_graph(pair->context);
+
+	if (ret)
+		return ret < 0 ? ret : -EPROTO;
+	for (unsigned int i = 0; i < ARRAY_SIZE(pair->amp); ++i) {
+		ret = wsa884x_fullio_verify_transport(pair->amp[i]);
+		if (ret)
+			return ret;
+		if (atomic64_read_acquire(&pair->amp[i]->fullio_pa_epoch) != pair->epoch[i])
+			return -ESTALE;
+	}
+	return 0;
+}
+
+static int wsa884x_fullio_verify_pair_ready(void *arg)
+{
+	struct wsa884x_fullio_start_pair *pair = arg;
+	s64 epoch;
+	int ret;
+
+	ret = wsa884x_fullio_check_pair(pair);
+	if (ret)
+		return ret;
+	for (unsigned int i = 0; i < 4; ++i) {
+		unsigned int side = i % 2;
+
+		ret = wsa884x_fullio_pa_ready(pair->codec[side], &epoch);
+		if (ret || epoch != pair->epoch[side])
+			return ret ?: -ESTALE;
+	}
+	return wsa884x_fullio_check_pair(pair);
+}
+
+static int wsa884x_fullio_wait_pair_ready(struct wsa884x_fullio_start_pair *pair)
+{
+	int ret = -EAGAIN;
+
+	/* Bounded read-only settling poll; no command is re-sent. */
+	for (unsigned int attempt = 0; attempt < 5 && ret == -EAGAIN; ++attempt) {
+		if (attempt)
+			usleep_range(2000, 3000);
+		ret = wsa884x_fullio_verify_pair_ready(pair);
+	}
+	return ret;
 }
 
+/* Caller owns the PCM lifetime and supplies the current muted DSP graph
+ * and feedback epoch proof. This is not an ALSA digital-unmute fallback.
+ */
+int wsa884x_fullio_start_pair(struct snd_soc_component *left,
+			     struct snd_soc_component *right,
+			     int (*verify_graph)(void *), void *context, int *stop_error);
+int wsa884x_fullio_start_pair(struct snd_soc_component *left,
+			     struct snd_soc_component *right,
+			     int (*verify_graph)(void *), void *context, int *stop_error)
+{
+	struct wsa884x_fullio_start_pair pair = {
+		.codec = { left, right }, .verify_graph = verify_graph, .context = context,
+	};
+	struct device_node *node;
+	struct wsa884x_fullio_pa_snapshot snapshot;
+	unsigned int refs = 0;
+	int ret;
+
+	if (!stop_error)
+		return -EINVAL;
+	*stop_error = 0;
+	if (!IS_REACHABLE(CONFIG_SND_SOC_LPASS_WSA_MACRO) || !verify_graph || !left || !right ||
+	    !left->card || right->card != left->card || left->dev == right->dev ||
+	    left->driver != &wsa884x_component_drv || right->driver != &wsa884x_component_drv ||
+	    !left->name_prefix || strcmp(left->name_prefix, "SpkrLeft") ||
+	    !right->name_prefix || strcmp(right->name_prefix, "SpkrRight") ||
+	    !of_machine_is_compatible("microsoft,denali"))
+		return -EPERM;
+	node = left->card->dev->of_node;
+	if (!of_property_read_bool(node, "microsoft,denali-fullio-reference-render") ||
+	    of_property_read_bool(node, "microsoft,denali-fullio-muted-test"))
+		return -EPERM;
+	for (unsigned int i = 0; i < ARRAY_SIZE(pair.amp); ++i) {
+		pair.amp[i] = dev_get_drvdata(pair.codec[i]->dev);
+		if (!pair.amp[i] || !pair.amp[i]->fullio_reference_codec)
+			return -EPERM;
+	}
+
+	guard(mutex)(&pair.amp[0]->sp_lock);
+	mutex_lock_nested(&pair.amp[1]->sp_lock, SINGLE_DEPTH_NESTING);
+	for (unsigned int i = 0; i < ARRAY_SIZE(pair.amp); ++i) {
+		ret = pm_runtime_resume_and_get(pair.amp[i]->dev);
+		if (ret < 0)
+			goto out;
+		refs++;
+		ret = wsa884x_fullio_read_pa(pair.codec[i], true, &snapshot);
+		if (ret)
+			goto out;
+		if ((snapshot.enable & WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK) || snapshot.sta1 ||
+		    snapshot.err0 || snapshot.err1 || snapshot.vphx != 0x02) {
+			ret = -EIO;
+			goto out;
+		}
+		pair.epoch[i] = snapshot.epoch;
+	}
+	ret = wsa_macro_fullio_verify_pair_clocks_off(left, right);
+	if (!ret)
+		ret = wsa884x_fullio_check_pair(&pair);
+	if (ret)
+		goto out;
+	ret = wsa884x_fullio_reference_start(pair.amp[0]);
+	if (!ret)
+		ret = wsa884x_fullio_check_pair(&pair);
+	if (!ret)
+		ret = wsa884x_fullio_reference_start(pair.amp[1]);
+	if (!ret)
+		ret = wsa884x_fullio_wait_pair_ready(&pair);
+	if (!ret)
+		ret = wsa_macro_fullio_clock_on_for_pair(left, right,
+						       wsa884x_fullio_verify_pair_ready, &pair);
+	if (ret) {
+		int stop_left, stop_right;
+
+		/* Either amp may have reached PA-on even on a bus error. */
+		stop_left = wsa884x_fullio_verified_stop(left, pair.amp[0]);
+		stop_right = wsa884x_fullio_verified_stop(right, pair.amp[1]);
+		*stop_error = stop_left ?: stop_right;
+	}
+out:
+	while (refs) {
+		struct device *dev = pair.amp[--refs]->dev;
+
+		pm_runtime_mark_last_busy(dev);
+		pm_runtime_put_autosuspend(dev);
+	}
+	mutex_unlock(&pair.amp[1]->sp_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(wsa884x_fullio_start_pair);
