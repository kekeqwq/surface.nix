+static int x1e80100_fullio_mix_cap(struct snd_soc_card *card)
+{
+	static const char * const controls[] = {
+		"WSA WSA_RX0_MIX Digital Volume",
+		"WSA WSA_RX1_MIX Digital Volume",
+	};
+	size_t i;
+	int ret;
+
+	if (!of_machine_is_compatible("microsoft,denali") ||
+	    !of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-muted-test"))
+		return 0;
+
+	/* S8 mixer values are offset by 84; unity is 84, not signed zero. */
+	for (i = 0; i < ARRAY_SIZE(controls); i++) {
+		ret = snd_soc_limit_volume(card, controls[i], 84);
+		if (ret)
+			return dev_err_probe(card->dev, ret, "cannot cap %s\n", controls[i]);
+	}
+
+	return 0;
+}
