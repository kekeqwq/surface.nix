+int audioreach_fullio_verify_tag(struct q6apm_graph *graph,
+				const struct audioreach_fullio_stages *stages,
+				enum ar_fullio_stage_id stage)
+{
+	const struct audioreach_module_priv_data *tag;
+	const u8 *expected;
+	u32 instance, param, bytes;
+	u8 actual[68];
+	int ret;
+
+	switch (stage) {
+	case AR_FULLIO_SP_TAG:
+		instance = 0x4027;
+		param = 0x080011e8;
+		bytes = 68;
+		break;
+	case AR_FULLIO_SPVI_TAG:
+		instance = 0x4024;
+		param = 0x080011f6;
+		bytes = 44;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	tag = stages->stage[stage];
+	if (!tag || le32_to_cpu(tag->size) < APM_MODULE_PARAM_DATA_SIZE + bytes ||
+	    get_unaligned_le32(tag->data) != instance ||
+	    get_unaligned_le32(tag->data + 1) != param ||
+	    get_unaligned_le32(tag->data + 2) != bytes ||
+	    get_unaligned_le32(tag->data + 3))
+		return -EINVAL;
+
+	expected = (const u8 *)tag->data + APM_MODULE_PARAM_DATA_SIZE;
+	ret = q6apm_fullio_get_cfg(graph, instance, param, actual, bytes);
+	if (ret)
+		return ret;
+	return memcmp(expected, actual, bytes) ? -EILSEQ : 0;
+}
+EXPORT_SYMBOL_GPL(audioreach_fullio_verify_tag);
+
+bool audioreach_fullio_graph(const struct audioreach_graph_info *info)
+{
+	struct audioreach_sub_graph *sg;
+	struct audioreach_container *container;
+	struct audioreach_module *module;
+
+	list_for_each_entry(sg, &info->sg_list, node) {
+		list_for_each_entry(container, &sg->container_list, node) {
+			list_for_each_entry(module, &container->modules_list, node) {
+				if (module->integrated_backend_id || module->fullio_ctrl_links)
+					return true;
+				for (int i = 0; i < AR_FULLIO_STAGE_COUNT; i++)
+					if (module->fullio_stages[i])
+						return true;
+			}
+		}
+	}
+	return false;
+}
+EXPORT_SYMBOL_GPL(audioreach_fullio_graph);
