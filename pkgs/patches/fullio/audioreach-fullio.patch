+/* The ordinary APM map tokens use the graph ID and a position-buffer flag.
+ * Use a separate token namespace; late replies must never satisfy another map.
+ */
+#define Q6APM_FULLIO_OOB_TOKEN BIT(31)
+/* Keep the namespace across APM reprobe, but not across module reload. */
+static atomic_t fullio_oob_sequence = ATOMIC_INIT(0);
+
+static int q6apm_fullio_next_token(u32 *token)
+{
+	int sequence = atomic_read(&fullio_oob_sequence);
+
+	do {
+		if (sequence == INT_MAX)
+			return -EOVERFLOW;
+	} while (!atomic_try_cmpxchg(&fullio_oob_sequence, &sequence, sequence + 1));
+	*token = Q6APM_FULLIO_OOB_TOKEN | (u32)(sequence + 1);
+	return 0;
+}
+
+struct q6apm_fullio_get {
+	u32 instance;
+	u32 param;
+	size_t bytes;
+	void *data;
+};
+
+static int q6apm_fullio_readback(const struct gpr_resp_pkt *rsp,
+				const struct q6apm_fullio_get *get)
+{
+	const u8 *payload = rsp->payload;
+	size_t header = sizeof(u32) + APM_MODULE_PARAM_DATA_SIZE;
+
+	if (!get || !payload || rsp->payload_size < (int)sizeof(u32))
+		return -EPROTO;
+	if (get_unaligned_le32(payload))
+		return -EIO;
+	if (rsp->payload_size != sizeof(u32) + ALIGN(APM_MODULE_PARAM_DATA_SIZE + get->bytes, 8))
+		return -EPROTO;
+	if (get_unaligned_le32(payload + 4) != get->instance ||
+	    get_unaligned_le32(payload + 8) != get->param ||
+	    get_unaligned_le32(payload + 16))
+		return -EPROTO;
+	/* This VOL_CTRL reply retains the requested outer buffer size but
+	 * declares a compact 16-byte body. Do not parse its unused tail or
+	 * apply variable-size handling to the SP/SPVI readbacks.
+	 */
+	if (get->instance == 0x4a63 && get->param == 0x08001039 && get->bytes == 104 &&
+	    get_unaligned_le32(payload + 12) == 16) {
+		memcpy(get->data, payload + header, 16);
+		return 16;
+	}
+	if (get_unaligned_le32(payload + 12) != get->bytes)
+		return -EPROTO;
+	memcpy(get->data, payload + header, get->bytes);
+	return 0;
+}
+
+static bool q6apm_fullio_oob_reply(struct q6apm *apm, const struct gpr_resp_pkt *data)
+{
+	const struct gpr_ibasic_rsp_result_t *basic;
+	const struct apm_cmd_rsp_shared_mem_map_regions *map;
+	const struct gpr_hdr *hdr = &data->hdr;
+	unsigned long flags;
+	int status = -EPROTO;
+	u32 handle = 0;
+
+	if (!(hdr->token & Q6APM_FULLIO_OOB_TOKEN))
+		return false;
+
+	spin_lock_irqsave(&apm->fullio_oob_lock, flags);
+	if (hdr->token != apm->fullio_oob_token)
+		goto out;
+
+	if (hdr->opcode == APM_CMD_RSP_GET_CFG && apm->fullio_oob_op == APM_CMD_GET_CFG) {
+		status = q6apm_fullio_readback(data, apm->fullio_get);
+		/* Diagnose only the pinned mute query. Do not log parameter data
+		 * or change the protocol validation for any readback.
+		 */
+		if (status == -EPROTO && apm->fullio_get &&
+		    apm->fullio_get->instance == 0x4a63 &&
+		    apm->fullio_get->param == 0x08001039 && data->payload &&
+		    data->payload_size >= (int)(sizeof(u32) + APM_MODULE_PARAM_DATA_SIZE)) {
+			const u8 *p = data->payload;
+
+			dev_warn_ratelimited(&apm->gdev->dev,
+				"FullIO mute reply header: token=%#x bytes=%d status=%#x iid=%#x param=%#x size=%u param_status=%#x\n",
+				hdr->token, data->payload_size, get_unaligned_le32(p),
+				get_unaligned_le32(p + 4), get_unaligned_le32(p + 8),
+				get_unaligned_le32(p + 12), get_unaligned_le32(p + 16));
+		}
+	} else if (hdr->opcode == APM_CMD_RSP_SHARED_MEM_MAP_REGIONS &&
+	    apm->fullio_oob_op == APM_CMD_SHARED_MEM_MAP_REGIONS &&
+	    data->payload && data->payload_size >= (int)sizeof(*map)) {
+		map = data->payload;
+		handle = map->mem_map_handle;
+		if (handle)
+			status = 0;
+	} else if (hdr->opcode == GPR_BASIC_RSP_RESULT && data->payload &&
+		   data->payload_size >= (int)sizeof(*basic)) {
+		basic = data->payload;
+		if (basic->opcode != apm->fullio_oob_op)
+			goto out;
+		if (!basic->status && (apm->fullio_oob_op == APM_CMD_SHARED_MEM_MAP_REGIONS ||
+				       apm->fullio_oob_op == APM_CMD_GET_CFG))
+			goto out; /* Wait for the handle or readback, not just BASIC success. */
+		if (basic->status)
+			dev_err_ratelimited(&apm->gdev->dev,
+					    "FullIO command %#x rejected, DSP status %#x\n",
+					    basic->opcode, basic->status);
+		status = basic->status ? -EIO : 0;
+	}
+
+	apm->fullio_oob_status = status;
+	apm->fullio_oob_handle = handle;
+	apm->fullio_oob_token = 0;
+	complete(&apm->fullio_oob_done);
+out:
+	spin_unlock_irqrestore(&apm->fullio_oob_lock, flags);
+	return true;
+}
+
+static int q6apm_fullio_oob_rpc(struct q6apm *apm, gpr_port_t *port,
+			       struct gpr_pkt *pkt, u32 *handle, struct q6apm_fullio_get *get)
+{
+	gpr_device_t *gdev = apm->gdev;
+	unsigned long flags;
+	u32 token;
+	int ret;
+
+	/* Serialize against legacy APM commands, without using their reply slot. */
+	guard(mutex)(&apm->lock);
+	ret = q6apm_fullio_next_token(&token);
+	if (ret)
+		return ret;
+	pkt->hdr.token = token;
+	pkt->hdr.dest_domain = audioreach_gpr_dest_domain(gdev);
+	reinit_completion(&apm->fullio_oob_done);
+	spin_lock_irqsave(&apm->fullio_oob_lock, flags);
+	apm->fullio_oob_status = -ETIMEDOUT;
+	apm->fullio_oob_op = pkt->hdr.opcode;
+	apm->fullio_oob_token = pkt->hdr.token;
+	apm->fullio_get = get;
+	spin_unlock_irqrestore(&apm->fullio_oob_lock, flags);
+
+	ret = port ? gpr_send_port_pkt(port, pkt) : gpr_send_pkt(gdev, pkt);
+	if (ret >= 0 && !wait_for_completion_timeout(&apm->fullio_oob_done, 5 * HZ))
+		ret = -ETIMEDOUT;
+
+	spin_lock_irqsave(&apm->fullio_oob_lock, flags);
+	apm->fullio_oob_token = 0;
+	apm->fullio_get = NULL;
+	if (ret >= 0) {
+		ret = apm->fullio_oob_status;
+		if (!ret && handle)
+			*handle = apm->fullio_oob_handle;
+	}
+	spin_unlock_irqrestore(&apm->fullio_oob_lock, flags);
+	return ret;
+}
+
+static int q6apm_fullio_oob_map_region(struct q6apm *apm,
+				      struct q6apm_fullio_oob_region *region,
+				      unsigned int max_size, u32 property_flag)
+{
+	struct apm_cmd_shared_mem_map_regions *cmd;
+	struct apm_shared_map_region_payload *map;
+	int ret;
+
+	if (region->handle || region->poisoned || !region->size ||
+	    region->size > max_size || !IS_ALIGNED(region->size, SZ_4K) ||
+	    !IS_ALIGNED(region->dsp_addr, SZ_4K))
+		return -EINVAL;
+
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_apm_cmd_pkt(sizeof(*cmd) + sizeof(*map),
+					    APM_CMD_SHARED_MEM_MAP_REGIONS, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	cmd = (void *)pkt + GPR_HDR_SIZE;
+	cmd->mem_pool_id = APM_MEMORY_MAP_SHMEM8_4K_POOL;
+	cmd->num_regions = 1;
+	cmd->property_flag = property_flag;
+	map = (void *)cmd + sizeof(*cmd);
+	map->shm_addr_lsw = lower_32_bits(region->dsp_addr);
+	map->shm_addr_msw = upper_32_bits(region->dsp_addr);
+	map->mem_size_bytes = region->size;
+
+	ret = q6apm_fullio_oob_rpc(apm, NULL, pkt, &region->handle, NULL);
+	if (ret)
+		region->poisoned = true;
+	return ret;
+}
+
+int q6apm_fullio_oob_map(struct q6apm *apm, struct q6apm_fullio_oob_region *region)
+{
+	return q6apm_fullio_oob_map_region(apm, region, SZ_64K, 0);
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_oob_map);
+
+int q6apm_fullio_oob_unmap(struct q6apm *apm, struct q6apm_fullio_oob_region *region)
+{
+	struct apm_cmd_shared_mem_unmap_regions *cmd;
+	int ret;
+
+	if (region->poisoned || !region->handle)
+		return -EINVAL;
+
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_apm_cmd_pkt(sizeof(*cmd), APM_CMD_SHARED_MEM_UNMAP_REGIONS, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	cmd = (void *)pkt + GPR_HDR_SIZE;
+	cmd->mem_map_handle = region->handle;
+	ret = q6apm_fullio_oob_rpc(apm, NULL, pkt, NULL, NULL);
+	if (ret)
+		region->poisoned = true;
+	else
+		region->handle = 0;
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_oob_unmap);
