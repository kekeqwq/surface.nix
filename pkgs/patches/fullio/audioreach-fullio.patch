+static int q6apm_feedback_probe_rate(struct snd_soc_card *card)
+{
+	struct device_node *node = card->dev->of_node;
+	const char *probe;
+	const char *property = "microsoft,denali-fullio-feedback-probe";
+
+	if (!of_property_present(node, property))
+		return 0;
+	if (!of_machine_is_compatible("microsoft,denali") ||
+	    !of_property_read_bool(node, "microsoft,denali-fullio-muted-test") ||
+	    of_property_read_string(node, property, &probe))
+		return -EINVAL;
+	if (!strcmp(probe, "vi"))
+		return 8000;
+	if (!strcmp(probe, "cps"))
+		return 24000;
+	return -EINVAL;
+}
+
+struct q6apm_fullio_amp_pair {
+	struct snd_soc_component *left;
+	struct snd_soc_component *right;
+};
+
+/* Resolve both roles on the same runtime before reading either amplifier.
+ * The caller owns the card's PCM/runtime lifetime; do not cache these pointers.
+ */
+static int q6apm_fullio_amp_pair(struct snd_soc_card *card, const char *link,
+				struct q6apm_fullio_amp_pair *pair)
+{
+	struct snd_soc_pcm_runtime *rtd, *target = NULL;
+	struct snd_soc_dai *codec;
+	int i;
+
+	for_each_card_rtds(card, rtd) {
+		if (strcmp(rtd->dai_link->name, link))
+			continue;
+		if (target)
+			return -EEXIST;
+		target = rtd;
+	}
+	if (!target)
+		return -ENODEV;
+
+	for_each_rtd_codec_dais(target, i, codec) {
+		struct snd_soc_component *component = codec->component;
+		const char *prefix = component->name_prefix;
+		struct snd_soc_component **slot;
+
+		if (prefix && !strcmp(prefix, "SpkrLeft"))
+			slot = &pair->left;
+		else if (prefix && !strcmp(prefix, "SpkrRight"))
+			slot = &pair->right;
+		else
+			continue;
+		if (component->card != card || !component->dev)
+			return -ENODEV;
+		if (*slot)
+			return -EEXIST;
+		*slot = component;
+	}
+
+	if (!pair->left || !pair->right)
+		return -ENODEV;
+	if (pair->left->dev == pair->right->dev)
+		return -EEXIST;
+	return 0;
+}
+
+/* One synchronous clock transaction, under the caller's PCM lifetime lock.
+ * This predicate does not enable clocks, change a PA or retain device refs.
+ */
+struct q6apm_fullio_pa_check {
+	struct snd_pcm_substream *substream;
+	s64 left_epoch, right_epoch;
+	bool sampled;
+};
+
+static int __maybe_unused q6apm_fullio_verify_post_pa(void *arg)
+{
+	struct q6apm_fullio_pa_check *check = arg;
+	struct snd_pcm_substream *substream = check->substream;
+	struct snd_soc_card *card = snd_soc_substream_to_rtd(substream)->card;
+	struct q6apm_dai_rtd *prtd = substream->runtime->private_data;
+	struct q6apm_fullio_amp_pair pair = {};
+	s64 left, right, again;
+	int ret;
+
+	if (substream->stream != SNDRV_PCM_STREAM_PLAYBACK || !prtd || !prtd->graph ||
+	    !of_machine_is_compatible("microsoft,denali") ||
+	    !of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-post-pa-test") ||
+	    !q6apm_fullio_mute_is_verified(prtd->graph))
+		return -EPERM;
+
+	ret = q6apm_fullio_amp_pair(card, "WSA Playback", &pair);
+	if (ret)
+		return ret;
+	/* Overlap the two PA observation intervals (L, R, L, R). */
+	ret = wsa884x_fullio_pa_ready(pair.left, &left);
+	if (ret)
+		return ret;
+	ret = wsa884x_fullio_pa_ready(pair.right, &right);
+	if (ret)
+		return ret;
+	ret = wsa884x_fullio_pa_ready(pair.left, &again);
+	if (ret)
+		return ret;
+	if (again != left)
+		return -ESTALE;
+	ret = wsa884x_fullio_pa_ready(pair.right, &again);
+	if (ret)
+		return ret;
+	if (again != right || !q6apm_fullio_mute_is_verified(prtd->graph))
+		return -ESTALE;
+	/* The post-write callback must see the same codec epochs as pre-write. */
+	if (check->sampled && (check->left_epoch != left || check->right_epoch != right))
+		return -ESTALE;
+	check->left_epoch = left;
+	check->right_epoch = right;
+	check->sampled = true;
+	return 0;
+}
+
+static int q6apm_fullio_both_pa_off(void *ctx)
+{
+	struct snd_soc_card *card = ctx;
+	struct q6apm_fullio_amp_pair pair = {};
+	const char *link = "WSA Playback";
+	int ret, probe_rate = q6apm_feedback_probe_rate(card);
+
+	if (probe_rate < 0)
+		return probe_rate;
+	if (probe_rate)
+		link = probe_rate == 8000 ? "WSA VI Protection" : "WSA CPS Protection";
+
+	ret = q6apm_fullio_amp_pair(card, link, &pair);
+	if (ret)
+		return ret;
+	ret = wsa884x_fullio_pa_off(pair.left);
+	if (ret)
+		return ret;
+	return wsa884x_fullio_pa_off(pair.right);
+}
+
+static int q6apm_fullio_stop_pair_audit(struct snd_soc_card *card)
+{
+	struct q6apm_fullio_amp_pair pair = {};
+	int left, right;
+
+	left = q6apm_fullio_amp_pair(card, "WSA Playback", &pair);
+	if (left)
+		return left;
+	left = wsa884x_fullio_stop_audit(pair.left);
+	right = wsa884x_fullio_stop_audit(pair.right);
+	if (left || right) {
+		dev_err(card->dev, "FullIO PA-off teardown failed: left=%d right=%d\n", left, right);
+		return left ?: right;
+	}
+	/* Exercise rejection of missing proof, never fake the PA/clock state. */
+	if (of_property_read_bool(card->dev->of_node,
+				  "microsoft,denali-fullio-pa-off-missing-stop-proof")) {
+		dev_info(card->dev, "FullIO injected missing PA-off proof after both hardware checks\n");
+		return -ENODATA;
+	}
+	return 0;
+}
+
+static int q6apm_fullio_check_render(struct q6apm_dai_data *pdata, int stream)
+{
+	if (stream == SNDRV_PCM_STREAM_PLAYBACK && READ_ONCE(pdata->fullio_render_locked))
+		return -ENOTRECOVERABLE;
+	return 0;
+}
+
+/* A DSP STOP acknowledgement is not evidence about the physical PAs. */
+static int q6apm_fullio_finish_audit(struct q6apm_dai_data *pdata, struct snd_soc_card *card,
+				    int dsp_result, int dsp_stop_error, bool worker_verified)
+{
+	int pa_error = 0;
+
+	if (!worker_verified &&
+	    of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-pa-stop-audit"))
+		pa_error = q6apm_fullio_stop_pair_audit(card);
+	if (!pa_error && !dsp_stop_error && dsp_result <= 0)
+		return dsp_result;
+
+	WRITE_ONCE(pdata->fullio_render_locked, true);
+	if (pa_error)
+		dev_err(card->dev, "FullIO paired PA shutdown unverified: PA=%d, graph audit=%d; render locked\n",
+			pa_error, dsp_result);
+	if (dsp_stop_error)
+		dev_err(card->dev, "FullIO DSP shutdown unverified: GRAPH_STOP=%d; render locked\n",
+			dsp_stop_error);
+	if (dsp_result > 0)
+		dev_err(card->dev, "FullIO invalid audit result %d; render locked\n",
+			dsp_result);
+	return -ENOTRECOVERABLE;
+}
+
+struct q6apm_fullio_fault_work {
+	struct work_struct work;
+	struct snd_soc_card *card;
+	atomic_t fired;
+	int result;
+};
+
+static void q6apm_fullio_fault_worker(struct work_struct *work)
+{
+	struct q6apm_fullio_fault_work *audit = container_of(work, typeof(*audit), work);
+
+	/* A pair of status notices can requeue one work item across execution. */
+	if (atomic_cmpxchg(&audit->fired, 0, 1))
+		return;
+	/* No PCM, graph or DSP lock/transaction in the worker. */
+	audit->result = q6apm_fullio_stop_pair_audit(audit->card);
+}
+
+static int q6apm_fullio_fault_worker_audit(struct snd_soc_card *card, bool *verified)
+{
+	struct q6apm_fullio_fault_work audit = { .card = card, .fired = ATOMIC_INIT(0) };
+	struct q6apm_fullio_amp_pair pair = {};
+	int ret, cleanup;
+
+	ret = q6apm_fullio_amp_pair(card, "WSA Playback", &pair);
+	if (ret)
+		return ret;
+	INIT_WORK_ONSTACK(&audit.work, q6apm_fullio_fault_worker);
+	ret = wsa884x_fullio_fault_watch(pair.left, &audit.work, true);
+	if (ret)
+		goto join;
+	ret = wsa884x_fullio_fault_watch(pair.right, &audit.work, true);
+	if (!ret) {
+		ret = wsa884x_fullio_fault_inject(pair.left);
+		cleanup = wsa884x_fullio_fault_watch(pair.right, &audit.work, false);
+		ret = ret ?: cleanup;
+	}
+	cleanup = wsa884x_fullio_fault_watch(pair.left, &audit.work, false);
+	ret = ret ?: cleanup;
+join:
+	/* All device slots are revoked under their notifier locks before join. */
+	flush_work(&audit.work);
+	destroy_work_on_stack(&audit.work);
+	if (ret || audit.result || !atomic_read(&audit.fired))
+		return ret ?: audit.result ?: -ENODATA;
+	*verified = true;
+	dev_info(card->dev, "FullIO synthetic fault notice: paired PA-off worker verified before DSP STOP\n");
+	return -ECANCELED;
+}
+
+static int q6apm_fullio_verify_sink(struct q6apm_graph *graph)
+{
+	static const struct {
+		u32 param;
+		__le32 expected[3];
+	} rows[] = {
+		/* rate, packed bits/channels, fixed-point PCM */
+		{ PARAM_ID_HW_EP_MF_CFG,
+		  { cpu_to_le32(48000), cpu_to_le32((2 << 16) | 16), cpu_to_le32(1) } },
+		/* WSA type, interface 1, both DMA slots */
+		{ PARAM_ID_CODEC_DMA_INTF_CFG, { cpu_to_le32(2), cpu_to_le32(1), cpu_to_le32(3) } },
+	};
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(rows); i++) {
+		__le32 actual[3];
+
+		ret = q6apm_fullio_get_cfg(graph, 0x4157, rows[i].param, actual, sizeof(actual));
+		if (ret)
+			return dev_err_probe(graph->dev, ret < 0 ? ret : -EPROTO,
+					     "FullIO sink GET_CFG %#x unverified\n", rows[i].param);
+		if (memcmp(actual, rows[i].expected, sizeof(actual)))
+			return dev_err_probe(graph->dev, -EILSEQ,
+					     "FullIO sink %#x differs from Golden\n", rows[i].param);
+	}
+	return 0;
+}
+
+static int q6apm_fullio_dsp_prepare(struct q6apm_graph *graph, struct snd_soc_card *card,
+				       const struct audioreach_fullio_stages *stages)
+{
+	struct device_node *node = card->dev->of_node;
+	bool sink_readback = of_property_read_bool(node, "microsoft,denali-fullio-sink-readback-audit");
+	bool reference = q6apm_fullio_reference_render(card);
+	bool prepare = reference || of_property_read_bool(node, "microsoft,denali-fullio-dsp-prepare-audit");
+	int ret;
+
+	if (sink_readback && (!prepare ||
+			      of_property_read_bool(node, "microsoft,denali-fullio-dsp-start-audit")))
+		return -EPERM;
+	if (!prepare)
+		return 0;
+	if ((!reference && !of_property_read_bool(node, "microsoft,denali-fullio-clock-off-audit")) ||
+	    of_property_read_bool(node, "microsoft,denali-fullio-post-pa-test") ||
+	    !graph->ar_graph || READ_ONCE(graph->ar_graph->start_count) ||
+	    !q6apm_fullio_transport_enabled(graph->apm))
+		return -EPERM;
+	ret = q6apm_fullio_both_pa_off(card);
+	if (ret)
+		return ret;
+	/* This step only prepares; it does not start or queue data. */
+	ret = q6apm_graph_prepare(graph);
+	if (ret)
+		return dev_err_probe(graph->dev, ret, "FullIO muted GRAPH_PREPARE rejected\n");
+	ret = audioreach_fullio_verify_tag(graph, stages, AR_FULLIO_SP_TAG);
+	if (!ret)
+		ret = audioreach_fullio_verify_tag(graph, stages, AR_FULLIO_SPVI_TAG);
+	if (ret)
+		return dev_err_probe(graph->dev, ret, "FullIO protection tag mismatch after GRAPH_PREPARE\n");
+	if (sink_readback) {
+		ret = q6apm_fullio_verify_sink(graph);
+		if (ret)
+			return ret;
+	}
+	ret = audioreach_fullio_verify_mute(graph);
+	if (ret)
+		return ret;
+	ret = q6apm_fullio_both_pa_off(card);
+	if (!ret) {
+		dev_info(graph->dev, "FullIO mute survived GRAPH_PREPARE\n");
+		dev_info(graph->dev, "FullIO SP/SPVI tags survived GRAPH_PREPARE byte-for-byte\n");
+		if (sink_readback)
+			dev_info(graph->dev, "FullIO Golden RX0 endpoint read back after GRAPH_PREPARE\n");
+	}
+	return ret;
+}
