+	int ret;
+
+	ret = q6apm_fullio_copy_endpoint_tlv(bytes, size, gain, sizeof(gain));
+	if (ret)
+		return ret;
+	return q6apm_fullio_endpoint_put(kcontrol,
+		audioreach_alloc_fullio_final_volume(le32_to_cpu(gain[0]), le32_to_cpu(gain[1])));
+}
