+/* Attach only to the never-started audit graph under graph_lock. */
+static int q6apm_fullio_ring_attach(struct q6apm_graph *graph,
+				     struct q6apm_fullio_ring *ring, u32 config_bytes, bool direct)
+{
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_push_pull_pkt(graph, ring->data.dsp_addr, ring->pos.dsp_addr,
+					      ring->data.handle, ring->pos.handle, config_bytes, direct);
+	int ret;
+
+	/* Any failed SET_CFG may still have reached the DSP. Bind the lifetime
+	 * to the last graph reference before sending and even on failure.
+	 */
+	ring->config_bytes = config_bytes;
+	smp_store_release(&graph->ar_graph->fullio_ring, ring);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+	ret = q6apm_fullio_oob_rpc(graph->apm, direct ? graph->port : NULL, pkt, NULL, NULL);
+	if (ret)
+		return ret;
+
+	ring->pcm_buffer.dev.type = SNDRV_DMA_TYPE_DEV;
+	ring->pcm_buffer.dev.dev = ring->dev;
+	ring->pcm_buffer.area = ring->cpu;
+	ring->pcm_buffer.addr = ring->dma;
+	smp_store_release(&ring->pcm_buffer.bytes, config_bytes);
+	return 0;
+}
