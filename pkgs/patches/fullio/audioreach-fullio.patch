+	FULLIO_PULL_NEW,
+	FULLIO_PULL_RUNNING,
+	FULLIO_PULL_PAUSED,
+	FULLIO_PULL_UNCERTAIN,
+	FULLIO_PULL_STOPPED,
+	FULLIO_PULL_STOP_UNVERIFIED,
+};
