+struct q6apm_fullio_start_audit {
+	struct snd_soc_card *card;
+	struct snd_pcm_substream *substream;
+	struct q6apm_graph *graph;
+	size_t ring_bytes;
+	bool stop_worker_done;
+};
+
+static bool q6apm_fullio_silent_ring_valid(struct q6apm_fullio_start_audit *audit)
+{
+	struct snd_pcm_substream *s = audit->substream;
+	struct snd_pcm_runtime *runtime = s->runtime;
+
+	return s->stream == SNDRV_PCM_STREAM_PLAYBACK &&
+	       runtime->access == SNDRV_PCM_ACCESS_RW_INTERLEAVED &&
+	       !(runtime->info & SNDRV_PCM_INFO_MMAP) && !atomic_read(&s->mmap_count) &&
+	       s->dma_buffer.area && audit->ring_bytes && audit->ring_bytes <= s->dma_buffer.bytes;
+}
+
+#define Q6APM_FULLIO_DIAG_LOG_CODE 0x1586
+
+static int q6apm_fullio_audit_configure_taps(struct q6apm_graph *graph, u32 feedback_log_off)
+{
+	/* AudioReach data_logging_api.h: mode 1 is immediate logging;
+	 * 0x08001313 with value 1 allows the logger to exit island.
+	 * Never retarget the render or microphone loggers.
+	 */
+	static const u32 iid[] = {0x4025, 0x402a};
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(iid); i++) {
+		__le32 config[8] = {
+			cpu_to_le32(iid[i]), cpu_to_le32(Q6APM_FULLIO_LOG_CFG), cpu_to_le32(12), 0,
+			cpu_to_le32(feedback_log_off & BIT(i) ? 0 : Q6APM_FULLIO_DIAG_LOG_CODE),
+			cpu_to_le32(i + 2), cpu_to_le32(1), 0,
+		};
+		__le32 island[6] = {
+			cpu_to_le32(iid[i]), cpu_to_le32(0x08001313), cpu_to_le32(4), 0,
+			cpu_to_le32(1), 0,
+		};
+		int ret = q6apm_fullio_set_cfg_inband(graph, config, sizeof(config));
+
+		if (!ret)
+			ret = q6apm_fullio_set_cfg_inband(graph, island, sizeof(island));
+		if (ret)
+			return dev_err_probe(graph->dev, ret, "FullIO immediate tap %u rejected\n", i + 2);
+	}
+	dev_info(graph->dev, "FullIO immediate VI/CPS taps configured\n");
+	return 0;
+}
+
+static int q6apm_fullio_verify_logger_tags(struct q6apm_graph *graph, bool started,
+					   bool rx0_log_off, u32 feedback_log_off)
+{
+	static const struct { u32 iid, tag; } rows[] = {
+		{ 0x4003, 4 }, { 0x4025, 2 }, { 0x402a, 3 },
+	};
+	const char *phase = started ? "post-START" : "pre-START";
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(rows); i++) {
+		bool off = i ? feedback_log_off & BIT(i - 1) : rx0_log_off;
+		u32 code = off ? 0 : Q6APM_FULLIO_DIAG_LOG_CODE;
+		__le32 cfg[3];
+		int ret = q6apm_fullio_get_cfg(graph, rows[i].iid, Q6APM_FULLIO_LOG_CFG,
+					      cfg, sizeof(cfg));
+
+		if (ret)
+			return dev_err_probe(graph->dev, ret < 0 ? ret : -EPROTO,
+					     "FullIO %s logger %#x GET_CFG unverified\n", phase, rows[i].iid);
+		if (le32_to_cpu(cfg[0]) != code || le32_to_cpu(cfg[1]) != rows[i].tag ||
+		    le32_to_cpu(cfg[2]) != 1)
+			return dev_err_probe(graph->dev, -EILSEQ,
+					     "FullIO %s logger %#x config mismatch: code=%#x tap=%u mode=%u\n",
+					     phase, rows[i].iid, le32_to_cpu(cfg[0]), le32_to_cpu(cfg[1]),
+					     le32_to_cpu(cfg[2]));
+		dev_info(graph->dev, "FullIO %s logger %#x GET_CFG verified: code=0x%x tap=%u mode=1\n",
+			 phase, rows[i].iid, code, rows[i].tag);
+	}
+	return 0;
+}
+
+/* PA-off readback of the bootstrap-set master gain.  Q13 unity is
+ * 0x2000.  Anything above it would amplify and is rejected; the value
+ * is logged so a lower user volume is visible in the audit trail.
+ */
+static int q6apm_fullio_verify_gain_bounds(struct q6apm_graph *graph, bool started)
+{
+	const char *phase = started ? "post-START" : "pre-START";
+	__le16 words[2];
+	int ret = q6apm_fullio_get_cfg(graph, 0x4a63, 0x08001035, words, sizeof(words));
+
+	if (ret)
+		return dev_err_probe(graph->dev, ret < 0 ? ret : -EPROTO,
+				     "FullIO %s master gain GET unverified\n", phase);
+	if (le16_to_cpu(words[0]) > 0x2000 || words[1])
+		return dev_err_probe(graph->dev, -EILSEQ,
+				     "FullIO %s master gain out of bounds: gain=%#x reserved=%#x\n",
+				     phase, le16_to_cpu(words[0]), le16_to_cpu(words[1]));
+	dev_info(graph->dev,
+		 "FullIO %s master gain verified: %#x (Q13 unity=0x2000)\n",
+		 phase, le16_to_cpu(words[0]));
+	return 0;
+}
+
+static int q6apm_fullio_verify_silent_audit(void *arg, bool started)
+{
+	struct q6apm_fullio_start_audit *audit = arg;
+	struct device_node *node = audit->card->dev->of_node;
+	bool taps = of_property_read_bool(node, "microsoft,denali-fullio-immediate-taps-audit");
+	bool ring = of_property_read_bool(node, "microsoft,denali-fullio-ring-dma-audit");
+	bool logger_tags = of_property_read_bool(node, "microsoft,denali-fullio-rx0-tag-audit");
+	bool rx0_log_off = of_property_read_bool(node, "microsoft,denali-fullio-rx0-log-off-audit");
+	bool feedback_off = of_property_read_bool(node, "microsoft,denali-fullio-feedback-log-off-audit");
+	bool keep_cps_log = of_property_read_bool(node, "microsoft,denali-fullio-keep-cps-log-audit");
+	bool gain_audit = of_property_read_bool(node, "microsoft,denali-fullio-pa-off-gain-audit");
+	u32 feedback_log_off = 0;
+	int ret;
+
+	if ((logger_tags && (!ring || !taps)) || (rx0_log_off && !logger_tags) ||
+	    (feedback_off && !rx0_log_off) || (keep_cps_log && !feedback_off))
+		return -EPERM;
+	if (feedback_off)
+		feedback_log_off = keep_cps_log ? BIT(0) : BIT(0) | BIT(1);
+	ret = q6apm_fullio_both_pa_off(audit->card);
+	if (ret)
+		return ret;
+	if (started) {
+		if (taps)
+			msleep(150); /* PA-off, clocks-off observation only. */
+		ret = audioreach_fullio_verify_mute(audit->graph);
+		if (ret)
+			return ret;
+		ret = q6apm_fullio_both_pa_off(audit->card);
+		if (ret)
+			return ret;
+	}
+	/* The required clock-off audit marker makes this a read-only query. */
+	ret = wsa_macro_fullio_clock_off_for_feedback(audit->card);
+	if (ret)
+		return ret;
+	if (gain_audit) {
+		ret = q6apm_fullio_verify_gain_bounds(audit->graph, started);
+		if (ret)
+			return ret;
+	}
+	if (ring) {
+		ret = q6apm_fullio_ring_position_audit(audit->graph, started);
+		if (ret || (!started && !taps))
+			return ret;
+		if (!started) {
+			ret = q6apm_fullio_audit_configure_taps(audit->graph, feedback_log_off);
+			if (!ret && logger_tags)
+				ret = q6apm_fullio_verify_logger_tags(audit->graph, false,
+							     rx0_log_off, feedback_log_off);
+			if (ret)
+				return ret;
+		}
+		ret = q6apm_fullio_both_pa_off(audit->card);
+		if (!ret)
+			ret = wsa_macro_fullio_clock_off_for_feedback(audit->card);
+		if (!ret && started && logger_tags)
+			ret = q6apm_fullio_verify_logger_tags(audit->graph, true,
+						     rx0_log_off, feedback_log_off);
+		if (ret || !started || !of_property_read_bool(node, "microsoft,denali-fullio-soft-cycle-audit"))
+			return ret;
+		ret = q6apm_fullio_soft_cycle_audit(audit->graph);
+		if (!ret)
+			ret = audioreach_fullio_verify_mute(audit->graph);
+		if (!ret)
+			ret = q6apm_fullio_both_pa_off(audit->card);
+		if (!ret)
+			ret = wsa_macro_fullio_clock_off_for_feedback(audit->card);
+		return ret ?: q6apm_fullio_ring_position_audit(audit->graph, true);
+	}
+	if (!q6apm_fullio_silent_ring_valid(audit))
+		return -EPERM;
+	if (!started) {
+		/* ALSA is still in prepare; no trigger or data mmap is allowed.
+		 * Clear the actual DSP ring, without touching the position buffer.
+		 */
+		memset(audit->substream->dma_buffer.area, 0, audit->ring_bytes);
+		dma_wmb();
+		if (taps) {
+			ret = q6apm_fullio_audit_configure_taps(audit->graph, 0);
+			if (!ret)
+				ret = q6apm_fullio_both_pa_off(audit->card);
+			return ret ?: wsa_macro_fullio_clock_off_for_feedback(audit->card);
+		}
+	} else if (memchr_inv(audit->substream->dma_buffer.area, 0, audit->ring_bytes)) {
+		return -EILSEQ;
+	} else if (of_property_read_bool(audit->card->dev->of_node,
+					 "microsoft,denali-fullio-pa-off-fault-worker")) {
+		return q6apm_fullio_fault_worker_audit(audit->card, &audit->stop_worker_done);
+	}
+	return 0;
+}
