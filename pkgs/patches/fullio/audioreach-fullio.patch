+static int audioreach_fullio_dynamic_frame(const struct audioreach_module_priv_data *blob,
+					   unsigned int wanted, const u8 **frame, size_t *bytes)
+{
+	static const struct { u32 instance, param, size; } expected[] = {
+		{ 0x4027, 0x080011e9, 8 },
+		{ 0x4024, 0x080011f5, 24 },
+		{ 0x4024, 0x080011f4, 24 },
+		{ 0x4024, 0x080011ff, 8 },
+	};
+	const u8 *cursor = (const u8 *)blob->data;
+	size_t left = le32_to_cpu(blob->size), span;
+	unsigned int i;
+
+	if (wanted >= ARRAY_SIZE(expected))
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(expected); i++) {
+		span = ALIGN(APM_MODULE_PARAM_DATA_SIZE + expected[i].size, 8);
+		if (left < span || get_unaligned_le32(cursor) != expected[i].instance ||
+		    get_unaligned_le32(cursor + 4) != expected[i].param ||
+		    get_unaligned_le32(cursor + 8) != expected[i].size ||
+		    get_unaligned_le32(cursor + 12))
+			return -EINVAL;
+		if (i == wanted) {
+			*frame = cursor;
+			*bytes = span;
+		}
+		left -= span;
+		cursor += span;
+	}
+	return left ? -EINVAL : 0;
+}
+
+static int audioreach_fullio_bootstrap(struct q6apm_graph *graph,
+				      struct q6apm_fullio_oob_region *region,
+				      void *buffer,
+				      const struct audioreach_module_priv_data *blob)
+{
+	enum { input_bytes = 10464, query_offset = 8352, query_span = 48 };
+	const u8 *raw = (const u8 *)blob->data;
+	const u8 *query;
+	u8 *writes __free(kfree) = NULL;
+	if (le32_to_cpu(blob->size) != input_bytes)
+		return -EINVAL;
+	query = raw + query_offset;
+
+	/* SPR_SESSION_TIME is GET-only, not a calibration write. */
+	if (get_unaligned_le32(query) != 0x412b ||
+	    get_unaligned_le32(query + 4) != 0x0800113d ||
+	    get_unaligned_le32(query + 8) != 28 ||
+	    memchr_inv(query + 12, 0, query_span - 12))
+		return -EINVAL;
+
+	writes = kmalloc(input_bytes - query_span, GFP_KERNEL);
+	if (!writes)
+		return -ENOMEM;
+	memcpy(writes, raw, query_offset);
+	memcpy(writes + query_offset, query + query_span,
+	       input_bytes - query_offset - query_span);
+
+	return q6apm_fullio_set_cfg_oob(graph, region, buffer, writes,
+				      input_bytes - query_span, false);
+}
+
+static bool audioreach_fullio_compact_stereo_mute(const u8 *data)
+{
+	return get_unaligned_le32(data) == 1 && /* one entry */
+	       get_unaligned_le32(data + 4) == (BIT(1) | BIT(2)) && /* FL + FR */
+	       get_unaligned_le32(data + 8) == 0 && /* no high mask bits */
+	       get_unaligned_le32(data + 12) == 1; /* muted */
+}
+
+/* The pinned endpoint ABI has eight slots, but only FL and FR are
+ * selected. Unlike the reference stage, this packet has no unmute
+ * variant, and it never writes a gain parameter.
+ */
+static const __le32 fullio_stereo_mute[30] = {
+	[0] = cpu_to_le32(0x4a63),
+	[1] = cpu_to_le32(0x08001039),
+	[2] = cpu_to_le32(104),
+	[4] = cpu_to_le32(8),
+	[5] = cpu_to_le32(0x2),
+	[7] = cpu_to_le32(1),
+	[8] = cpu_to_le32(0x4),
+	[10] = cpu_to_le32(1),
+};
+
+int audioreach_fullio_verify_mute(struct q6apm_graph *graph)
+{
+	u8 actual[sizeof(fullio_stereo_mute) - APM_MODULE_PARAM_DATA_SIZE];
+	int ret;
+
+	ret = q6apm_fullio_get_cfg(graph, 0x4a63, 0x08001039, actual, sizeof(actual));
+	if (ret < 0)
+		return dev_err_probe(graph->dev, ret, "FullIO endpoint stereo mute not readable\n");
+	if (ret == 16) {
+		if (!audioreach_fullio_compact_stereo_mute(actual)) {
+			dev_warn_ratelimited(graph->dev,
+				"FullIO compact mute mismatch: count=%u mask=%#x/%#x value=%u\n",
+				get_unaligned_le32(actual), get_unaligned_le32(actual + 4),
+				get_unaligned_le32(actual + 8), get_unaligned_le32(actual + 12));
+			return -EILSEQ;
+		}
+	} else if (ret || memcmp((const u8 *)fullio_stereo_mute + APM_MODULE_PARAM_DATA_SIZE,
+				 actual, sizeof(actual))) {
+		return dev_err_probe(graph->dev, -EILSEQ, "FullIO endpoint stereo mute mismatch\n");
+	}
+	dev_info(graph->dev, "FullIO endpoint stereo mute readback verified\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(audioreach_fullio_verify_mute);
+
+/* Format only: callers must acquire and validate the protected graph. */
+static int audioreach_fullio_final_gain_frame(__le32 frame[30],
+							    u32 left, u32 right, u32 cap)
+{
+	if (cap > 0x10000000 || left > cap || right > cap)
+		return -ERANGE;
+
+	memset(frame, 0, sizeof(__le32) * 30);
+	frame[0] = cpu_to_le32(0x4a63);
+	frame[1] = cpu_to_le32(0x08001038);
+	frame[2] = cpu_to_le32(104);
+	frame[4] = cpu_to_le32(8);
+	frame[5] = cpu_to_le32(0x2);
+	frame[7] = cpu_to_le32(left);
+	frame[8] = cpu_to_le32(0x4);
+	frame[10] = cpu_to_le32(right);
+	return 0;
+}
+
+static struct gpr_pkt *audioreach_alloc_fullio_endpoint_pkt(const __le32 frame[30])
+{
+	const size_t bytes = sizeof(fullio_stereo_mute);
+	struct gpr_pkt *pkt = audioreach_alloc_apm_cmd_pkt(bytes, APM_CMD_SET_CFG, 0);
+
+	if (!IS_ERR(pkt))
+		memcpy((void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE, frame, bytes);
+	return pkt;
+}
+
+struct gpr_pkt *audioreach_alloc_fullio_final_volume(u32 left, u32 right)
+{
+	__le32 frame[ARRAY_SIZE(fullio_stereo_mute)];
+	int ret;
+
+	ret = audioreach_fullio_final_gain_frame(frame, left, right, 0x10000000);
+	if (ret)
+		return ERR_PTR(ret);
+	return audioreach_alloc_fullio_endpoint_pkt(frame);
+}
+
+struct gpr_pkt *audioreach_alloc_fullio_final_mute(bool mute)
+{
+	__le32 frame[ARRAY_SIZE(fullio_stereo_mute)];
+
+	memcpy(frame, fullio_stereo_mute, sizeof(frame));
+	frame[7] = frame[10] = cpu_to_le32(mute);
+	return audioreach_alloc_fullio_endpoint_pkt(frame);
+}
+
+static int audioreach_fullio_acknowledge_mute(struct q6apm_graph *graph,
+					     const struct audioreach_fullio_stages *stages)
+{
+	const struct audioreach_module_priv_data *stage = stages->stage[AR_FULLIO_MUTE];
+	int ret;
+
+	if (!stage || le32_to_cpu(stage->size) != sizeof(fullio_stereo_mute) ||
+	    get_unaligned_le32(stage->data) != 0x4a63 ||
+	    get_unaligned_le32(stage->data + 1) != 0x08001039)
+		return -EINVAL;
+	ret = q6apm_fullio_set_cfg_inband(graph, fullio_stereo_mute, sizeof(fullio_stereo_mute));
+	if (ret)
+		return dev_err_probe(graph->dev, ret, "FullIO endpoint stereo mute rejected\n");
+	dev_info(graph->dev, "FullIO endpoint stereo mute acknowledged\n");
+
+	return audioreach_fullio_verify_mute(graph);
+}
+
+/* Bootstrap includes reference VOL_CTRL defaults; no final-volume stage or
+ * GRAPH_START here. Validate hardware PA-off and conservative caps first.
+ */
+int audioreach_fullio_calibrate(struct q6apm_graph *graph,
+			       const struct audioreach_fullio_stages *stages,
+			       struct q6apm_fullio_oob_region *region, void *buffer,
+			       int (*assert_pa_off)(void *ctx), void *ctx)
+{
+	enum fullio_op { OOB, SINGLE, READBACK };
+	static const struct {
+		enum fullio_op op;
+		enum ar_fullio_stage_id stage;
+		unsigned int index;
+	} steps[] = {
+		{ OOB, AR_FULLIO_BOOTSTRAP },
+		{ SINGLE, AR_FULLIO_DYNAMIC, 0 },
+		{ OOB, AR_FULLIO_SP_TAG },
+		{ READBACK, AR_FULLIO_SP_TAG },
+		{ READBACK, AR_FULLIO_SPVI_TAG },
+		{ SINGLE, AR_FULLIO_DYNAMIC, 1 },
+		{ SINGLE, AR_FULLIO_DYNAMIC, 2 },
+		{ SINGLE, AR_FULLIO_DYNAMIC, 3 },
+		{ OOB, AR_FULLIO_SPVI_TAG },
+		{ OOB, AR_FULLIO_RENDER_EP },
+		{ OOB, AR_FULLIO_VI_EP },
+	};
+	const struct audioreach_module_priv_data *blob;
+	const u8 *dynamic[4];
+	size_t dynamic_bytes[4];
+	int i, ret;
+
+	if (!assert_pa_off || !graph->ar_graph || READ_ONCE(graph->ar_graph->start_count) ||
+	    !audioreach_fullio_graph(graph->info))
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(steps); i++)
+		if (!stages->stage[steps[i].stage])
+			return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(dynamic); i++) {
+		ret = audioreach_fullio_dynamic_frame(stages->stage[AR_FULLIO_DYNAMIC],
+						      i, &dynamic[i], &dynamic_bytes[i]);
+		if (ret)
+			return ret;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(steps); i++) {
+		if (!q6apm_fullio_transport_enabled(graph->apm))
+			return -EAGAIN;
+		ret = assert_pa_off(ctx);
+		if (ret)
+			return ret;
+		blob = stages->stage[steps[i].stage];
+		switch (steps[i].op) {
+		case OOB:
+			if (steps[i].stage == AR_FULLIO_BOOTSTRAP)
+				ret = audioreach_fullio_bootstrap(graph, region, buffer, blob);
+			else
+				ret = q6apm_fullio_set_cfg_oob(graph, region, buffer, blob->data,
+							     le32_to_cpu(blob->size), true);
+			break;
+		case SINGLE:
+			ret = q6apm_fullio_set_cfg_inband(graph, dynamic[steps[i].index],
+							dynamic_bytes[steps[i].index]);
+			break;
+		case READBACK:
+			ret = audioreach_fullio_verify_tag(graph, stages, steps[i].stage);
+			break;
+		}
+		if (ret)
+			return dev_err_probe(graph->dev, ret,
+					     "FullIO calibration step %d (stage %d, op %d) failed\n",
+					     i + 1, steps[i].stage, steps[i].op);
+	}
+	ret = assert_pa_off(ctx);
+	if (!ret)
+		ret = audioreach_fullio_acknowledge_mute(graph, stages);
+	if (ret)
+		return ret;
+	return assert_pa_off(ctx);
+}
+EXPORT_SYMBOL_GPL(audioreach_fullio_calibrate);
