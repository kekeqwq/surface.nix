+	ret = snd_soc_add_component_controls(component, q6apm_fullio_endpoint_controls,
+					     ARRAY_SIZE(q6apm_fullio_endpoint_controls));
+	if (ret)
+		snd_soc_tplg_component_remove(component);
+	return ret;
