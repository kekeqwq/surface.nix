+	dma_free_coherent(buf->dma_dev, FULLIO_CAL_DMA_SIZE, buf->cpu, buf->dma);
+	put_device(buf->dma_dev);
+	kfree(buf);
+	atomic_set(&apm->fullio_oob_claimed, 0);
+	return 0;
+}
