+/* A topology edge and its DPCM mixer route can describe the same DSP edge. */
+static bool audioreach_needs_mixer_edge(const struct audioreach_graph_info *info)
+{
+	struct audioreach_sub_graph *sg;
+	struct audioreach_container *container;
+	struct audioreach_module *module;
+	int port;
+
+	if (!info->src_mod_inst_id || !info->dst_mod_inst_id)
+		return false;
+	if (!audioreach_fullio_graph(info))
+		return true;
+
+	list_for_each_entry(sg, &info->sg_list, node) {
+		list_for_each_entry(container, &sg->container_list, node) {
+			list_for_each_entry(module, &container->modules_list, node) {
+				if (module->instance_id != info->src_mod_inst_id)
+					continue;
+				for (port = 0; port < module->max_op_port; port++) {
+					if (module->src_mod_op_port_id[port] == info->src_mod_op_port_id &&
+					    module->dst_mod_inst_id[port] == info->dst_mod_inst_id &&
+					    module->dst_mod_ip_port_id[port] == info->dst_mod_ip_port_id)
+						return false;
+				}
+			}
+		}
+	}
+	return true;
+}
