+static bool q6apm_fullio_independent_pcm(struct snd_soc_component *component,
+					 unsigned int graph_id, int stream)
+{
+	/* MultiMedia1 is graph 0 in the pinned Denali FullIO topology. */
+	return stream == SNDRV_PCM_STREAM_PLAYBACK && graph_id == 0 && component->card &&
+	       of_machine_is_compatible("microsoft,denali") &&
+	       (q6apm_fullio_reference_render(component->card) ||
+		of_property_read_bool(component->card->dev->of_node,
+				      "microsoft,denali-fullio-ring-map-audit"));
+}
+
+/* Keep the pull producer's registration and media order together. It is
+ * valid only on a fresh attached ring; a failed write leaves the owner
+ * attached for CLOSE, never reissues configuration on this graph.
+ */
+static int q6apm_fullio_prepare_pull_media(struct q6apm_graph *graph,
+					   struct audioreach_module_config *cfg,
+					   unsigned int period_bytes)
+{
+	int ret;
+
+	ret = q6apm_fullio_register_pull_events(graph, period_bytes);
+	if (ret)
+		return dev_err_probe(graph->dev, ret, "FullIO independent ring event registration rejected\n");
+	dev_info(graph->dev, "FullIO independent ring pull watermarks and SOFT_PAUSE events acknowledged\n");
+	ret = q6apm_graph_media_format_shmem(graph, cfg);
+	if (ret)
+		return dev_err_probe(graph->dev, ret, "FullIO independent ring SHMEM media rejected\n");
+	dev_info(graph->dev, "FullIO independent ring SHMEM media accepted\n");
+	return 0;
+}
+
+/* A producer that has rendered cannot be prepared again in place: the
+ * endpoint may be unmuted and the DSP cursor cannot be rewound by ALSA.
+ * After the ASoC STOP, retire that epoch with the normal ownership proofs
+ * before opening a fresh, muted graph on this PCM file.
+ */
+static int q6apm_fullio_reference_recycle(struct q6apm_dai_data *pdata,
+					struct q6apm_dai_rtd *prtd,
+					struct snd_soc_card *card)
+{
+	struct q6apm_graph *graph = prtd->graph;
+	int id = graph->id;
+	int ret;
+
+	ret = q6apm_fullio_both_pa_off(card);
+	if (!ret)
+		ret = wsa_macro_fullio_clock_off_for_feedback(card);
+	if (ret)
+		return ret;
+
+	q6apm_pcm_watermark_enable(prtd, false);
+	cancel_work_sync(&prtd->watermark_work);
+	ret = q6apm_fullio_pcm_stop(graph);
+	if (ret) {
+		WRITE_ONCE(pdata->fullio_render_locked, true);
+		return ret;
+	}
+
+	snd_pcm_set_runtime_buffer(prtd->substream, NULL);
+	prtd->graph = NULL;
+	ret = q6apm_graph_close(graph);
+	if (ret)
+		return ret;
+
+	graph = q6apm_graph_open(pdata->dev, event_handler, prtd, id,
+				prtd->substream->stream);
+	if (IS_ERR(graph))
+		return PTR_ERR(graph);
+	prtd->graph = graph;
+	prtd->last_pos_index = 0;
+	prtd->fullio_reference_prepared = false;
+	prtd->fullio_reference_reopen = false;
+	prtd->fullio_reference_started = false;
+	return 0;
+}
+
+static int q6apm_fullio_reference_prepare(struct q6apm_dai_data *pdata,
+					 struct q6apm_dai_rtd *prtd, struct snd_soc_card *card,
+					 struct audioreach_module_config *cfg)
+{
+	struct snd_pcm_substream *substream = prtd->substream;
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct snd_dma_buffer *buffer;
+	int ret;
+
+	if (pdata->has_reserved_mem || pdata->use_scm_assign ||
+	    runtime->format != SNDRV_PCM_FORMAT_S16_LE || runtime->rate != 48000 ||
+	    runtime->channels != 2 || prtd->pcm_size != 3840 ||
+	    snd_pcm_lib_period_bytes(substream) != 1920 || prtd->periods != 2)
+		return -EINVAL;
+
+	if (prtd->fullio_reference_reopen) {
+		ret = q6apm_fullio_reference_recycle(pdata, prtd, card);
+		if (ret)
+			goto failed;
+	}
+	/* Repeated PREPARE before any PCM START has no new producer to open. */
+	if (prtd->fullio_reference_prepared)
+		return 0;
+
+	ret = q6apm_fullio_both_pa_off(card);
+	if (!ret)
+		ret = wsa_macro_fullio_clock_off_for_feedback(card);
+	if (!ret)
+		ret = q6apm_fullio_pcm_configure(prtd->graph, card, pdata->sid);
+	if (!ret)
+		ret = q6apm_fullio_prepare_pull_media(prtd->graph, cfg, 1920);
+	if (!ret)
+		ret = q6apm_fullio_prepare_cal(pdata, prtd, card, cfg);
+	if (ret)
+		goto failed;
+
+	buffer = q6apm_fullio_pcm_buffer(prtd->graph, prtd->pcm_size);
+	if (!buffer) {
+		ret = -ENODATA;
+		goto failed;
+	}
+	ret = q6apm_fullio_pcm_start(prtd->graph);
+	if (!ret)
+		ret = audioreach_fullio_verify_mute(prtd->graph);
+	if (!ret && !q6apm_fullio_mute_is_verified(prtd->graph))
+		ret = -ESTALE;
+	if (ret) {
+		int stop;
+
+		stop = q6apm_fullio_pcm_stop(prtd->graph);
+		if (stop)
+			WRITE_ONCE(pdata->fullio_render_locked, true);
+		goto failed;
+	}
+	snd_pcm_set_runtime_buffer(substream, buffer);
+	prtd->fullio_reference_prepared = true;
+	return 0;
+
+failed:
+	prtd->fullio_reference_error = ret;
+	return ret;
+}
