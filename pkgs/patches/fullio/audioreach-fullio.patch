+static int q6apm_fullio_validate_frames(const void *data, size_t bytes, bool single)
+{
+	const u8 *frame = data;
+	unsigned int count = 0;
+
+	if (!data || !bytes || bytes > SZ_16K)
+		return -EINVAL;
+	/* The v19c MFC command is a single 28-byte, unpadded payload.
+	 * Do not relax the alignment rule for other frames or OOB records.
+	 */
+	if (!IS_ALIGNED(bytes, 8)) {
+		if (!single || bytes != 28 || get_unaligned_le32(frame) != 0x466a ||
+		    get_unaligned_le32(frame + 4) != PARAM_ID_MFC_OUTPUT_MEDIA_FORMAT ||
+		    get_unaligned_le32(frame + 8) != 12 || get_unaligned_le32(frame + 12) ||
+		    get_unaligned_le32(frame + 16) != 48000 ||
+		    get_unaligned_le16(frame + 20) != 16 || get_unaligned_le16(frame + 22) != 2)
+			return -EINVAL;
+		return 0;
+	}
+	while (bytes) {
+		u32 size;
+		size_t step;
+
+		if (bytes < APM_MODULE_PARAM_DATA_SIZE ||
+		    !get_unaligned_le32(frame) || !get_unaligned_le32(frame + 4) ||
+		    get_unaligned_le32(frame + 12))
+			return -EINVAL;
+		size = get_unaligned_le32(frame + 8);
+		if (!size || size > bytes - APM_MODULE_PARAM_DATA_SIZE)
+			return -EINVAL;
+		step = ALIGN(APM_MODULE_PARAM_DATA_SIZE + (size_t)size, 8);
+		if (step > bytes)
+			return -EINVAL;
+		frame += step;
+		bytes -= step;
+		count++;
+	}
+	return single && count != 1 ? -EINVAL : 0;
+}
