+/* Only these two modules receive the playback-format prelude on FullIO. */
+int audioreach_fullio_media_prelude(struct q6apm_graph *graph,
+				  const struct audioreach_module_config *cfg)
+{
+	const struct audioreach_module *pcm = NULL, *mfc = NULL;
+	struct audioreach_sub_graph *sg;
+	struct audioreach_container *container;
+	struct audioreach_module *module;
+	int ret;
+
+	if (!audioreach_fullio_graph(graph->info) ||
+	    cfg->direction != SNDRV_PCM_STREAM_PLAYBACK || cfg->sample_rate != 48000 ||
+	    cfg->bit_width != 16 || cfg->num_channels != 2)
+		return -EINVAL;
+
+	list_for_each_entry(sg, &graph->info->sg_list, node) {
+		list_for_each_entry(container, &sg->container_list, node) {
+			list_for_each_entry(module, &container->modules_list, node) {
+				if (module->instance_id == 0x465f)
+					pcm = module;
+				else if (module->instance_id == 0x466a)
+					mfc = module;
+			}
+		}
+	}
+	if (!pcm || pcm->module_id != MODULE_ID_PCM_CNV ||
+	    !mfc || mfc->module_id != MODULE_ID_MFC)
+		return -ENODEV;
+
+	ret = audioreach_pcm_set_media_format(graph, pcm, cfg);
+	if (ret)
+		return dev_err_probe(graph->dev, ret, "FullIO PCM_CNV media format rejected\n");
+	ret = audioreach_mfc_set_media_format(graph, mfc, cfg);
+	if (ret)
+		return dev_err_probe(graph->dev, ret, "FullIO MFC media format rejected\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(audioreach_fullio_media_prelude);
