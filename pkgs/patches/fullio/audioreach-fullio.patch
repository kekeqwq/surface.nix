+int q6apm_fullio_ring_position_audit(struct q6apm_graph *graph, bool started)
+{
+	struct q6apm_fullio_ring *ring = graph->ar_graph->fullio_ring;
+	const u32 frame_bytes = 2 * sizeof(__le16); /* Fixed stereo S16_LE audit. */
+	u32 previous = 0, previous_index = 0, index, seq;
+	int ret;
+
+	lockdep_assert_held(&graph->apm->graph_lock);
+	if (!ring || !ring->config_bytes ||
+	    ring->state != (started ? FULLIO_PULL_RUNNING : FULLIO_PULL_NEW))
+		return -EPERM;
+	if (!started) {
+		if (memchr_inv(ring->cpu + ring->data.size, 0, ring->pos.size) ||
+		    memchr_inv(ring->cpu, 0, ring->data.size))
+			return -EILSEQ;
+		dma_wmb();
+		return 0;
+	}
+	/* The publication sequence can advance with a stationary byte cursor.
+	 * Require movement within this bounded window as well. Zero sequence
+	 * marks an in-progress publication; an index of zero is valid.
+	 */
+	for (int i = 0; i < 8; i++) {
+		ret = q6apm_fullio_ring_cursor(ring, frame_bytes, &seq, &index);
+		if (ret && ret != -EAGAIN)
+			return ret;
+		if (!ret) {
+			/* Modular serial arithmetic distinguishes wrap from a reset.
+			 * A half-range jump cannot be produced in the audit window.
+			 */
+			if (previous && (seq - previous >= BIT(31) ||
+					 (seq == previous && index != previous_index)))
+				return -EILSEQ;
+			if (previous && seq != previous && index != previous_index) {
+				dev_info(graph->dev,
+					 "FullIO independent ring: DSP byte cursor advanced: seq=%u->%u bytes=%u->%u\n",
+					 previous, seq, previous_index, index);
+				return 0;
+			}
+			previous = seq;
+			previous_index = index;
+		}
+		if (i < 7)
+			usleep_range(3000, 4000);
+	}
+	return -ENODATA;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_ring_position_audit);
