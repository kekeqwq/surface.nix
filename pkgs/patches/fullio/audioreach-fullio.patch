+static int q6apm_fullio_volume_transaction_put(struct snd_kcontrol *kcontrol,
+						const unsigned int __user *bytes, unsigned int size)
+{
+	u8 payload[FULLIO_ENDPOINT_GAIN_BYTES + FULLIO_GAINSTEP_LARGE_BYTES];
+	const size_t overhead = FULLIO_ENDPOINT_TLV_HEADER_BYTES + FULLIO_ENDPOINT_GAIN_BYTES;
+	const u8 *delta = payload + FULLIO_ENDPOINT_GAIN_BYTES;
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct q6apm *apm = dev_get_drvdata(component->dev);
+	struct audioreach_graph *graph;
+	struct q6apm_fullio_ring *ring;
+	size_t delta_bytes;
+	unsigned long flags;
+	u64 epoch;
+	int ret;
+
+	if (size != overhead + FULLIO_GAINSTEP_SMALL_BYTES &&
+	    size != overhead + FULLIO_GAINSTEP_LARGE_BYTES)
+		return -EINVAL;
+	delta_bytes = size - overhead;
+	ret = q6apm_fullio_copy_endpoint_tlv(bytes, size, payload, size - FULLIO_ENDPOINT_TLV_HEADER_BYTES);
+	if (ret)
+		return ret;
+	ret = q6apm_fullio_validate_gainstep(delta, delta_bytes);
+	if (ret)
+		return ret;
+
+	struct gpr_pkt *gain __free(kfree) =
+		audioreach_alloc_fullio_final_volume(get_unaligned_le32(payload),
+						   get_unaligned_le32(payload + sizeof(__le32)));
+	if (IS_ERR(gain))
+		return PTR_ERR(gain);
+
+	guard(mutex)(&apm->graph_lock);
+	graph = q6apm_fullio_running_render(apm);
+	if (IS_ERR(graph))
+		return PTR_ERR(graph);
+	ring = graph->fullio_ring;
+	if (!ring)
+		return -EAGAIN;
+
+	ret = q6apm_fullio_map_gainstep(apm, ring);
+	if (ret)
+		return ret;
+
+	spin_lock_irqsave(&apm->fullio_oob_lock, flags);
+	epoch = apm->fullio_transport_epoch;
+	ret = q6apm_fullio_transport_enabled(apm) ? 0 : -ESTALE;
+	spin_unlock_irqrestore(&apm->fullio_oob_lock, flags);
+	if (ret)
+		return ret;
+
+	/* Windows sends final VOL_CTRL first, then the four-frame OOB delta. */
+	ret = q6apm_fullio_oob_rpc(apm, NULL, gain, NULL, NULL);
+	if (ret)
+		return ret;
+	spin_lock_irqsave(&apm->fullio_oob_lock, flags);
+	if (apm->fullio_transport_epoch != epoch || !q6apm_fullio_transport_enabled(apm))
+		ret = -ESTALE;
+	spin_unlock_irqrestore(&apm->fullio_oob_lock, flags);
+	if (ret)
+		return ret;
+
+	ret = q6apm_fullio_send_cfg_oob(apm, NULL, &ring->gainstep, ring->gainstep_cpu,
+					delta, delta_bytes);
+	spin_lock_irqsave(&apm->fullio_oob_lock, flags);
+	if (!ret && (apm->fullio_transport_epoch != epoch || !q6apm_fullio_transport_enabled(apm)))
+		ret = -ESTALE;
+	spin_unlock_irqrestore(&apm->fullio_oob_lock, flags);
+	return ret;
+}
