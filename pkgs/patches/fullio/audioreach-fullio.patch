+int q6apm_fullio_audit_start_stop(struct q6apm_graph *graph, struct snd_soc_card *card,
+				 int (*verify)(void *ctx, bool started), void *ctx,
+				 int *stop_error)
+{
+	struct device_node *node = card->dev->of_node;
+	struct audioreach_graph *ar = graph->ar_graph;
+	struct q6apm *apm = graph->apm;
+	u64 start_ack_ns = 0, stop_begin_ns;
+	int ret, stop;
+
+	*stop_error = 0;
+	if (!verify || !of_machine_is_compatible("microsoft,denali") ||
+	    !of_property_read_bool(node, "microsoft,denali-fullio-muted-test") ||
+	    !of_property_read_bool(node, "microsoft,denali-fullio-clock-off-audit") ||
+	    !of_property_read_bool(node, "microsoft,denali-fullio-dsp-prepare-audit") ||
+	    !of_property_read_bool(node, "microsoft,denali-fullio-dsp-start-audit") ||
+	    of_property_read_bool(node, "microsoft,denali-fullio-post-pa-test"))
+		return -EPERM;
+	guard(mutex)(&apm->graph_lock);
+	if (!ar || READ_ONCE(ar->start_count) || !audioreach_fullio_graph(ar->info) ||
+	    !q6apm_fullio_mute_is_verified(graph))
+		return -EPERM;
+	if (apm->fullio_start_audit_attempted)
+		return -EALREADY;
+	if (!!ar->fullio_ring != of_property_read_bool(node, "microsoft,denali-fullio-ring-dma-audit") ||
+	    (ar->fullio_ring && ar->fullio_ring->state != FULLIO_PULL_NEW))
+		return -EPERM;
+	ret = verify(ctx, false);
+	if (ret || !q6apm_fullio_mute_is_verified(graph))
+		return ret ?: -ESTALE;
+
+	apm->fullio_start_audit_attempted = true;
+	if (ar->fullio_ring)
+		ar->fullio_ring->state = FULLIO_PULL_UNCERTAIN;
+	ret = audioreach_graph_mgmt_transaction(ar, APM_CMD_GRAPH_START, true);
+	if (!ret) {
+		if (ar->fullio_ring)
+			ar->fullio_ring->state = FULLIO_PULL_RUNNING;
+		start_ack_ns = ktime_get_ns();
+		ret = verify(ctx, true);
+		if (!ret && !q6apm_fullio_mute_is_verified(graph))
+			ret = -ESTALE;
+		if (!ret && of_property_read_bool(node,
+						  "microsoft,denali-fullio-dsp-stop-fault-audit")) {
+			dev_info(graph->dev,
+				 "FullIO injected post-START verification failure; PAs and clocks off\n");
+			ret = -ECANCELED;
+		}
+	}
+	q6apm_fullio_mute_invalidate(graph);
+	/* A START timeout can leave DSP execution uncertain. Attempt STOP
+	 * whenever START was attempted, even if verification or START failed.
+	 */
+	stop_begin_ns = ktime_get_ns();
+	if (ar->fullio_ring)
+		ar->fullio_ring->state = FULLIO_PULL_UNCERTAIN;
+	stop = audioreach_graph_mgmt_transaction(ar, APM_CMD_GRAPH_STOP, true);
+	*stop_error = stop;
+	if (!stop && ar->fullio_ring) {
+		ar->fullio_ring->state = FULLIO_PULL_STOPPED;
+		dev_info(graph->dev, "FullIO independent ring GRAPH_STOP acknowledged\n");
+	}
+	if (of_property_read_bool(node, "microsoft,denali-fullio-immediate-taps-audit"))
+		dev_info(graph->dev,
+			 "FullIO tap host window: start_ack_ns=%llu stop_begin_ns=%llu verify=%d stop=%d\n",
+			 start_ack_ns, stop_begin_ns, ret, stop);
+	if (stop)
+		return dev_err_probe(graph->dev, stop, "FullIO audit GRAPH_STOP unverified; no retry\n");
+	if (ret)
+		return dev_err_probe(graph->dev, ret, "FullIO start audit failed; GRAPH_STOP acknowledged\n");
+	dev_info(graph->dev, "FullIO silent START/STOP audit passed; no PA enable or PCM writes\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_audit_start_stop);
