+static int q6apm_fullio_send_cfg_oob(struct q6apm *apm, gpr_port_t *port,
+				    struct q6apm_fullio_oob_region *region, void *buffer,
+				    const void *data, size_t bytes)
+{
+	struct apm_cmd_header *cmd;
+	int ret;
+
+	if (!buffer || !region->handle || region->poisoned || bytes > region->size)
+		return -EINVAL;
+	if (!q6apm_fullio_transport_enabled(apm))
+		return -EAGAIN;
+
+	struct gpr_pkt *pkt __free(kfree) = port ?
+		audioreach_alloc_cmd_pkt(0, APM_CMD_SET_CFG, 0, port->id,
+					APM_MODULE_INSTANCE_ID) :
+		audioreach_alloc_apm_cmd_pkt(0, APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	cmd = (void *)pkt + GPR_HDR_SIZE;
+	cmd->payload_address_lsw = lower_32_bits(region->dsp_addr);
+	cmd->payload_address_msw = upper_32_bits(region->dsp_addr);
+	cmd->mem_map_handle = region->handle;
+	cmd->payload_size = bytes;
+
+	memset(buffer, 0, region->size);
+	memcpy(buffer, data, bytes);
+	dma_wmb();
+	ret = q6apm_fullio_oob_rpc(apm, port, pkt, NULL, NULL);
+	if (ret)
+		region->poisoned = true;
+	return ret;
+}
