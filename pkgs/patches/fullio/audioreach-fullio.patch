+static int q6apm_fullio_prepare_cal(struct q6apm_dai_data *pdata,
+				   struct q6apm_dai_rtd *prtd, struct snd_soc_card *card,
+				   const struct audioreach_module_config *cfg)
+{
+	struct q6apm_fullio_cal_buffer *buf;
+	struct audioreach_fullio_stages stages;
+	struct q6apm_fullio_mute_ticket ticket;
+	struct q6apm *apm = prtd->graph->apm;
+	struct device *dev = pdata->dev;
+	int owner, ret, unmap_ret;
+
+	if (!of_machine_is_compatible("microsoft,denali"))
+		return 0;
+	ret = q6apm_find_integrated_backend(dev, WSA_CODEC_DMA_RX_0, &owner);
+	if (ret == -ENOENT || (!ret && prtd->graph->id != owner))
+		return 0;
+	if (ret)
+		return ret;
+	if (!q6apm_is_graph_in_push_pull_mode(prtd->graph) || pdata->use_scm_assign)
+		return -EOPNOTSUPP;
+	ret = q6apm_find_integrated_backend(dev, WSA_CODEC_DMA_TX_0, &owner);
+	if (ret || owner != prtd->graph->id)
+		return ret ?: -EINVAL;
+	ret = q6apm_find_integrated_backend(dev, WSA_CODEC_DMA_TX_1, &owner);
+	if (ret || owner != prtd->graph->id)
+		return ret ?: -EINVAL;
+
+	/* Never claim or map a buffer for an incomplete or inconsistent graph. */
+	ret = audioreach_fullio_collect_stages(prtd->graph->info, &stages);
+	if (ret)
+		return ret;
+	ret = q6apm_fullio_mute_begin(prtd->graph, &ticket);
+	if (ret)
+		return ret;
+	ret = q6apm_fullio_both_pa_off(card);
+	if (ret)
+		return ret;
+	if (atomic_cmpxchg(&apm->fullio_oob_claimed, 0, 1))
+		return -EBUSY;
+
+	buf = kzalloc_obj(*buf);
+	if (!buf) {
+		ret = -ENOMEM;
+		goto release_claim;
+	}
+	buf->cpu = dma_alloc_coherent(dev, FULLIO_CAL_DMA_SIZE, &buf->dma, GFP_KERNEL);
+	if (!buf->cpu) {
+		kfree(buf);
+		ret = -ENOMEM;
+		goto release_claim;
+	}
+	buf->dma_dev = get_device(dev);
+	buf->region.size = FULLIO_CAL_DMA_SIZE;
+	buf->region.dsp_addr = buf->dma;
+	if (pdata->sid >= 0)
+		buf->region.dsp_addr |= (u64)pdata->sid << 32;
+	prtd->fullio_cal = buf;
+	ret = audioreach_fullio_media_prelude(prtd->graph, cfg);
+	if (!ret) {
+		dev_info(dev, "FullIO PCM_CNV and MFC media accepted\n");
+		ret = q6apm_fullio_oob_map(apm, &buf->region);
+		if (ret)
+			dev_err(dev, "FullIO calibration DMA map failed: %d\n", ret);
+	}
+	if (!ret)
+		ret = audioreach_fullio_calibrate(prtd->graph, &stages, &buf->region,
+						 buf->cpu, q6apm_fullio_both_pa_off, card);
+	unmap_ret = q6apm_fullio_release_cal(prtd);
+	if (ret || unmap_ret)
+		return ret ?: unmap_ret;
+	ret = q6apm_fullio_dsp_prepare(prtd->graph, card, &stages);
+	if (ret)
+		return ret;
+	if (prtd->fullio_reference_pcm)
+		return q6apm_fullio_mute_commit(prtd->graph, &ticket);
+	if (of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-dsp-start-audit")) {
+		struct q6apm_fullio_start_audit audit = {
+			.card = card,
+			.substream = prtd->substream,
+			.graph = prtd->graph,
+			.ring_bytes = pdata->has_reserved_mem ? pdata->reserved_buf_size :
+							       BUFFER_BYTES_MAX,
+		};
+		int dsp_stop_error;
+
+		ret = q6apm_fullio_mute_commit(prtd->graph, &ticket);
+		if (ret)
+			return ret;
+		ret = q6apm_fullio_audit_start_stop(prtd->graph, card, q6apm_fullio_verify_silent_audit,
+						   &audit, &dsp_stop_error);
+		/* Clear any ticket left by a rejection before START. A real
+		 * attempt already revokes it before sending STOP.
+		 */
+		if (q6apm_fullio_mute_is_verified(prtd->graph))
+			q6apm_fullio_mute_invalidate(prtd->graph);
+		ret = q6apm_fullio_finish_audit(pdata, card, ret, dsp_stop_error, audit.stop_worker_done);
+		if (ret)
+			return ret;
+	} else {
+		dev_info(prtd->graph->dev, "FullIO prepare-only audit: no mute ticket published; render stays disabled\n");
+	}
+	return -EOPNOTSUPP;
+
+release_claim:
+	atomic_set(&apm->fullio_oob_claimed, 0);
+	return ret;
+}
