+/* One non-sleeping sample. The firmware writes zero, then index and time,
+ * then the next sequence. Do not use a transient index to report PCM progress.
+ * The caller holds the backing alive; no pointer escapes this function.
+ */
+static int q6apm_fullio_ring_cursor(const struct q6apm_fullio_ring *ring,
+				    u32 frame_bytes, u32 *sequence, u32 *offset)
+{
+	const __le32 *pos = ring->cpu + ring->data.size;
+	u32 seq, bytes;
+
+	seq = le32_to_cpu(READ_ONCE(pos[0]));
+	if (!seq)
+		return -EAGAIN;
+	dma_rmb();
+	bytes = le32_to_cpu(READ_ONCE(pos[1]));
+	dma_rmb();
+	if (seq != le32_to_cpu(READ_ONCE(pos[0])))
+		return -EAGAIN;
+	if (!frame_bytes || bytes >= ring->config_bytes || bytes % frame_bytes)
+		return -ERANGE;
+	*sequence = seq;
+	*offset = bytes;
+	return 0;
+}
+
+/* A borrowed sample-only view. ALSA never owns or frees the allocation;
+ * the FE must detach the view before dropping its graph reference.
+ */
+struct snd_dma_buffer *q6apm_fullio_pcm_buffer(struct q6apm_graph *graph, size_t bytes)
+{
+	struct q6apm_fullio_ring *ring = smp_load_acquire(&graph->ar_graph->fullio_ring);
+
+	if (!ring || !bytes || bytes != smp_load_acquire(&ring->pcm_buffer.bytes))
+		return NULL;
+	return &ring->pcm_buffer;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_pcm_buffer);
+
+/* Nonblocking PCM accessor. The open PCM retains a graph reference, so
+ * the attached coherent allocation cannot be released during a sample.
+ */
+int q6apm_fullio_pcm_cursor(struct q6apm_graph *graph, u32 frame_bytes, u32 *offset)
+{
+	const struct q6apm_fullio_ring *ring;
+	u32 sequence;
+
+	ring = smp_load_acquire(&graph->ar_graph->fullio_ring);
+	if (!ring)
+		return -EAGAIN;
+	return q6apm_fullio_ring_cursor(ring, frame_bytes, &sequence, offset);
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_pcm_cursor);
