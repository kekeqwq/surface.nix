+/* Start the producer once, with the graph muted and no endpoint owner
+ * published. PCM START does not repeat the DSP transaction.
+ */
+int q6apm_fullio_pcm_start(struct q6apm_graph *graph)
+{
+	struct audioreach_graph *ar = graph->ar_graph;
+	struct q6apm_fullio_ring *ring;
+	int ret;
+
+	guard(mutex)(&graph->apm->graph_lock);
+	ring = ar->fullio_ring;
+	if (!ring || !ring->pcm_native || graph->id || !audioreach_fullio_graph(graph->info) ||
+	    !q6apm_fullio_mute_is_verified(graph))
+		return -EPERM;
+	if (ring->state == FULLIO_PULL_RUNNING)
+		return READ_ONCE(ar->start_count) ? 0 : -ENOTRECOVERABLE;
+	if (ring->state != FULLIO_PULL_NEW || !ring->pcm_buffer.bytes || ar->start_count)
+		return -ENOTRECOVERABLE;
+	ring->state = FULLIO_PULL_UNCERTAIN;
+	ret = audioreach_graph_mgmt_transaction(ar, APM_CMD_GRAPH_START, true);
+	if (ret)
+		return ret;
+	/* The endpoint controls and CLOSE proof track this owner count. */
+	WRITE_ONCE(ar->start_count, 1);
+	ring->state = FULLIO_PULL_RUNNING;
+	return q6apm_fullio_mute_is_verified(graph) ? 0 : -ESTALE;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_pcm_start);
+
+int q6apm_fullio_pcm_stop(struct q6apm_graph *graph)
+{
+	struct audioreach_graph *ar = graph->ar_graph;
+	struct q6apm_fullio_ring *ring;
+	int ret;
+
+	guard(mutex)(&graph->apm->graph_lock);
+	q6apm_fullio_mute_invalidate(graph);
+	ring = ar->fullio_ring;
+	if (!ring || ring->state == FULLIO_PULL_NEW || ring->state == FULLIO_PULL_STOPPED)
+		return 0;
+	if (!ring->pcm_native || ring->state == FULLIO_PULL_STOP_UNVERIFIED)
+		return -ENOTRECOVERABLE;
+	ring->state = FULLIO_PULL_STOP_UNVERIFIED;
+	ret = audioreach_graph_mgmt_transaction(ar, APM_CMD_GRAPH_STOP, true);
+	if (!ret) {
+		ring->state = FULLIO_PULL_STOPPED;
+		WRITE_ONCE(ar->start_count, 0);
+	}
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_pcm_stop);
