+/* Neither ALSA nor devres owns this coherent allocation. Keep one slot
+ * across device reprobes, including an unresolved quarantine.
+ */
+struct q6apm_fullio_ring {
+	struct device *dev;
+	void *cpu;
+	dma_addr_t dma;
+	size_t bytes;
+	u32 config_bytes;
+	struct snd_dma_buffer pcm_buffer;
+	bool pcm_native;
+	int sid;
+	enum q6apm_fullio_pull_state state;
+	struct q6apm_fullio_oob_region data, pos;
+	void *gainstep_cpu;
+	dma_addr_t gainstep_dma;
+	struct q6apm_fullio_oob_region gainstep;
+};
+static atomic_t fullio_ring_claimed = ATOMIC_INIT(0);
+static struct q6apm_fullio_ring *fullio_ring_quarantine;
+
+static int __maybe_unused q6apm_fullio_ring_drop(struct q6apm *apm,
+						struct q6apm_fullio_ring **owner,
+						bool dsp_quiescent)
+{
+	struct q6apm_fullio_ring *ring = *owner;
+	int gainstep = 0, pos = 0, data = 0;
+
+	if (!ring)
+		return 0;
+	*owner = NULL;
+	if (dsp_quiescent) {
+		/* Independently clean up known mappings, in reverse order. */
+		if (ring->gainstep.handle && !ring->gainstep.poisoned)
+			gainstep = q6apm_fullio_oob_unmap(apm, &ring->gainstep);
+		if (ring->pos.handle && !ring->pos.poisoned)
+			pos = q6apm_fullio_oob_unmap(apm, &ring->pos);
+		if (ring->data.handle && !ring->data.poisoned)
+			data = q6apm_fullio_oob_unmap(apm, &ring->data);
+	}
+	if (!dsp_quiescent || gainstep || pos || data || ring->gainstep.poisoned ||
+	    ring->pos.poisoned || ring->data.poisoned || ring->gainstep.handle ||
+	    ring->pos.handle || ring->data.handle) {
+		WRITE_ONCE(fullio_ring_quarantine, ring);
+		dev_err(ring->dev, "FullIO PCM ring quarantined; no reuse or retry\n");
+		return -ENOTRECOVERABLE;
+	}
+
+	if (ring->gainstep_cpu)
+		dma_free_coherent(ring->dev, SZ_4K, ring->gainstep_cpu, ring->gainstep_dma);
+	dma_free_coherent(ring->dev, ring->bytes, ring->cpu, ring->dma);
+	put_device(ring->dev);
+	kfree(ring);
+	atomic_set(&fullio_ring_claimed, 0);
+	module_put(THIS_MODULE);
+	return 0;
+}
+
+static struct q6apm_fullio_ring *__maybe_unused
+q6apm_fullio_ring_alloc(struct q6apm *apm, struct device *dev, size_t bytes, int sid)
+{
+	struct q6apm_fullio_ring *ring;
+	u64 pos_addr, tag;
+	int ret, cleanup;
+
+	if (!of_machine_is_compatible("microsoft,denali") || !bytes || bytes > SZ_512K ||
+	    !IS_ALIGNED(bytes, SZ_4K) || sid < -1 || sid > 0xf)
+		return ERR_PTR(-EINVAL);
+	if (atomic_cmpxchg(&fullio_ring_claimed, 0, 1))
+		return ERR_PTR(-EBUSY);
+	if (!try_module_get(THIS_MODULE)) {
+		ret = -ENODEV;
+		goto release_claim;
+	}
+	ring = kzalloc_obj(*ring);
+	if (!ring) {
+		ret = -ENOMEM;
+		goto release_module;
+	}
+	ring->bytes = bytes + SZ_4K;
+	ring->sid = sid;
+	ring->dev = get_device(dev);
+	ring->cpu = dma_alloc_coherent(dev, ring->bytes, &ring->dma, GFP_KERNEL);
+	if (!ring->cpu) {
+		put_device(ring->dev);
+		kfree(ring);
+		ret = -ENOMEM;
+		goto release_module;
+	}
+	/* Preserve the fixed push/pull layout and the position mapping flag.
+	 * Reject a SID-tagged address that overlaps the address bits.
+	 */
+	ret = -ERANGE;
+	pos_addr = (u64)ring->dma + bytes;
+	if (pos_addr < (u64)ring->dma || (sid >= 0 && upper_32_bits(pos_addr)))
+		goto rollback;
+	tag = sid < 0 ? 0 : (u64)sid << 32;
+	ring->data.dsp_addr = (u64)ring->dma | tag;
+	ring->data.size = bytes;
+	ring->pos.dsp_addr = pos_addr | tag;
+	ring->pos.size = SZ_4K;
+	memset(ring->cpu, 0, ring->bytes);
+	dma_wmb();
+	ret = q6apm_fullio_oob_map_region(apm, &ring->data, SZ_512K, 0);
+	if (ret)
+		goto rollback;
+	ret = q6apm_fullio_oob_map_region(apm, &ring->pos, SZ_4K, 2);
+	if (!ret) {
+		if (ring->data.handle != ring->pos.handle)
+			return ring;
+		/* Two distinct regions cannot safely share an ambiguous handle. */
+		ring->data.poisoned = true;
+		ring->pos.poisoned = true;
+		ret = -EPROTO;
+	}
+rollback:
+	/* No graph has been given the backing yet. */
+	cleanup = q6apm_fullio_ring_drop(apm, &ring, true);
+	return ERR_PTR(cleanup ?: ret);
+release_module:
+	module_put(THIS_MODULE);
+release_claim:
+	atomic_set(&fullio_ring_claimed, 0);
+	return ERR_PTR(ret);
+}
