+/* FullIO exposes the feedback as ALSA companion playback, while the
+ * physical SoundWire data flows from the codecs into the controller.
+ */
+static bool qcom_swrm_denali_feedback(struct qcom_swrm_ctrl *ctrl, int id)
+{
+	return of_machine_is_compatible("microsoft,denali") &&
+	       of_property_read_bool(ctrl->dev->of_node, "qcom,denali-fullio-feedback") &&
+	       ctrl->bus.controller_id == MASTER_ID_WSA &&
+	       ctrl->num_dout_ports == 9 && ctrl->nports >= 13 &&
+	       (id == 9 || id == 10);
+}
+
+/* A CPS master port is shared, but it must never count the same
+ * physical slave twice. This validates admission, not feedback samples.
+ */
+static int qcom_swrm_denali_feedback_source(struct sdw_bus *bus,
+					    struct sdw_slave *slave,
+					    unsigned long *seen)
+{
+	unsigned int num;
+
+	if (!slave || slave->bus != bus || slave->id.part_id != 0x0204)
+		return -EINVAL;
+	num = READ_ONCE(slave->dev_num);
+	if (!num || num > SDW_MAX_DEVICES ||
+	    READ_ONCE(slave->status) != SDW_SLAVE_ATTACHED)
+		return -ENODEV;
+	if (*seen & BIT(num))
+		return -EINVAL;
+	*seen |= BIT(num);
+	return 0;
+}
+
+static int qcom_swrm_denali_alloc_feedback(struct qcom_swrm_ctrl *ctrl,
+					  struct sdw_stream_runtime *stream,
+					  int dai_id, unsigned int rate)
+{
+	bool cps = dai_id == 10;
+	struct sdw_stream_config config = {
+		.direction = SDW_DATA_DIR_TX,
+		.ch_count = 1,
+		.frame_rate = rate,
+		.type = SDW_STREAM_PDM,
+		.bps = 1,
+	};
+	struct sdw_port_config ports[2] = {};
+	struct sdw_master_runtime *m_rt;
+	struct sdw_slave_runtime *s_rt;
+	struct sdw_port_runtime *p_rt;
+	unsigned long requested = 0, seen = 0;
+	unsigned int nports = 0, sources = 0, port, i;
+	int ret;
+
+	if (!stream || rate != (cps ? 24000 : 8000))
+		return -EINVAL;
+
+	guard(mutex)(&ctrl->port_lock);
+	list_for_each_entry(m_rt, &stream->master_list, stream_node) {
+		if (&ctrl->bus != m_rt->bus)
+			continue;
+
+		list_for_each_entry(s_rt, &m_rt->slave_rt_list, m_rt_node) {
+			if (s_rt->direction != SDW_DATA_DIR_TX ||
+			    !list_is_singular(&s_rt->port_list))
+				return -EINVAL;
+			ret = qcom_swrm_denali_feedback_source(&ctrl->bus, s_rt->slave, &seen);
+			if (ret)
+				return ret;
+			p_rt = list_first_entry(&s_rt->port_list, struct sdw_port_runtime, port_node);
+			if (p_rt->num != (cps ? 6 : 5) || p_rt->ch_mask != 3)
+				return -EINVAL;
+			port = s_rt->slave->m_port_map[p_rt->num];
+			if (cps ? port != 13 : port != 10 && port != 11)
+				return -EINVAL;
+			if (test_bit(port, &ctrl->port_mask))
+				return -EBUSY;
+			if (++sources > 2)
+				return -EINVAL;
+
+			/* CPS DP6 on both codecs shares exactly one physical master port. */
