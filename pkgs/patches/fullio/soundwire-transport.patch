+/* The core's exit helper can return zero after skipping every slave.
+ * Keep resume/cleanup semantics, but do not admit a new FullIO stream
+ * on a controller that no longer sees its previously attached slots.
+ */
+static void qcom_swrm_fullio_check_resumed_slots(struct qcom_swrm_ctrl *ctrl)
+{
+	u32 slots;
+
+	if (!ctrl->fullio_link_gate)
+		return;
+	if (ctrl->reg_read(ctrl, SWRM_MCP_SLV_STATUS, &slots) != SDW_CMD_OK) {
+		qcom_swrm_fullio_latch_link_error(ctrl, -EIO);
+		return;
+	}
+	qcom_swrm_fullio_observe_slots(ctrl, slots);
+}
