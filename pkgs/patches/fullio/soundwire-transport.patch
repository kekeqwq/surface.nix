+static int swrm_fullio_wait_for_frame_stop(struct qcom_swrm_ctrl *ctrl)
+{
+	const int max_reads = 30;
+	u32 status;
+	int i, ret;
+
+	/* ClockStopNow's command ACK does not describe controller frame state.
+	 * Keep iface enabled until the frame generator is observed stopped.
+	 */
+	for (i = 0; i < max_reads; i++) {
+		ret = ctrl->reg_read(ctrl, SWRM_COMP_STATUS, &status);
+		if (ret != SDW_CMD_OK)
+			return ret < 0 ? ret : -EIO;
+		if (!(status & SWRM_FRM_GEN_ENABLED)) {
+			dev_info_ratelimited(ctrl->dev,
+					     "FullIO frame generator stopped before iface gate: reads=%d status=%#x\n",
+					     i + 1, status);
+			return 0;
+		}
+		if (i + 1 < max_reads)
+			usleep_range(1000, 1100);
+	}
+	return -ETIMEDOUT;
+}
