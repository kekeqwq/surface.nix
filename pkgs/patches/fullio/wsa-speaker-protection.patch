+/* No clock-control writes in the PA-off audit. Read all four lanes so
+ * an unexpected enabling path is visible even when the DSP stays silent.
+ */
+static int wsa_macro_fullio_verify_clocks_off_locked(struct wsa_macro *wsa)
+{
+	unsigned int i, value, on = 0;
+	int ret;
+
+	lockdep_assert_held(&wsa->fullio_clock_lock);
+	if (wsa->fullio_clock_pm || wsa->fullio_clock_fault)
+		return -EBUSY;
+	ret = pm_runtime_resume_and_get(wsa->dev);
+	if (ret < 0)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(fullio_tx_regs); i++) {
+		ret = regmap_read_bypassed(wsa->regmap, fullio_tx_regs[i], &value);
+		if (ret)
+			break;
+		if (value & CDC_WSA_TX_SPKR_PROT_CLK_EN_MASK)
+			on |= BIT(i);
+	}
+	pm_runtime_mark_last_busy(wsa->dev);
+	pm_runtime_put_autosuspend(wsa->dev);
+	if (ret)
+		return ret;
+	if (on) {
+		dev_err_ratelimited(wsa->dev, "FullIO clock-off audit found enabled TX lanes: %#x\n", on);
+		return -EBUSY;
+	}
+	dev_info_ratelimited(wsa->dev, "FullIO clock-off audit: TX0-TX3 hardware readback off\n");
+	return 0;
+}
+
+static int wsa_macro_fullio_verify_clocks_off(struct snd_soc_component *owner)
+{
+	struct wsa_macro *wsa = snd_soc_component_get_drvdata(owner);
+
+	guard(mutex)(&wsa->fullio_clock_lock);
+	return wsa_macro_fullio_verify_clocks_off_locked(wsa);
+}
+
+/* Resolve clock ownership from the card's playback link, not global state. */
+static struct snd_soc_component *
+wsa_macro_fullio_clock_owner(struct snd_soc_card *card,
+			     struct snd_soc_component *left, struct snd_soc_component *right)
+{
+	struct snd_soc_pcm_runtime *rtd, *target = NULL;
+	struct snd_soc_component *owner = NULL;
+	struct snd_soc_dai *codec;
+	unsigned int left_count = 0, right_count = 0;
+	int i;
+
+	for_each_card_rtds(card, rtd) {
+		if (strcmp(rtd->dai_link->name, "WSA Playback"))
+			continue;
+		if (target)
+			return ERR_PTR(-EEXIST);
+		target = rtd;
+	}
+	if (!target)
+		return ERR_PTR(-ENODEV);
+	for_each_rtd_codec_dais(target, i, codec) {
+		if (codec->component == left)
+			left_count++;
+		if (codec->component == right)
+			right_count++;
+		if (codec->component->driver != &wsa_macro_component_drv)
+			continue;
+		if (owner)
+			return ERR_PTR(-EEXIST);
+		owner = codec->component;
+	}
+	if ((left && left_count != 1) || (right && right_count != 1) ||
+	    !owner || owner->card != card)
+		return ERR_PTR(-ENODEV);
+	return owner;
+}
+
+static struct snd_soc_component *
+wsa_macro_fullio_reference_owner(struct snd_soc_component *left,
+				 struct snd_soc_component *right)
+{
+	struct snd_soc_card *card = left ? left->card : NULL;
+
+	if (!wsa_macro_fullio_reference_route(card) || !right || right == left || right->card != card)
+		return ERR_PTR(-EOPNOTSUPP);
+	return wsa_macro_fullio_clock_owner(card, left, right);
+}
+
+int wsa_macro_fullio_verify_pair_clocks_off(struct snd_soc_component *left,
+					    struct snd_soc_component *right);
+int wsa_macro_fullio_verify_pair_clocks_off(struct snd_soc_component *left,
+					    struct snd_soc_component *right)
+{
+	struct snd_soc_component *owner = wsa_macro_fullio_reference_owner(left, right);
+
+	return IS_ERR(owner) ? PTR_ERR(owner) : wsa_macro_fullio_verify_clocks_off(owner);
+}
+EXPORT_SYMBOL_GPL(wsa_macro_fullio_verify_pair_clocks_off);
+
+int wsa_macro_fullio_clock_on_for_pair(struct snd_soc_component *left,
+				      struct snd_soc_component *right,
+				      int (*verify)(void *), void *context);
+int wsa_macro_fullio_clock_on_for_pair(struct snd_soc_component *left,
+				      struct snd_soc_component *right,
+				      int (*verify)(void *), void *context)
+{
+	struct snd_soc_component *owner = wsa_macro_fullio_reference_owner(left, right);
+
+	if (IS_ERR(owner))
+		return PTR_ERR(owner);
+	if (!verify)
+		return -EPERM;
+	return wsa_macro_fullio_tx_clocks(owner, true, verify, context);
+}
+EXPORT_SYMBOL_GPL(wsa_macro_fullio_clock_on_for_pair);
+
+static int wsa_macro_fullio_clock_off_on_card(struct snd_soc_card *card,
+					     struct snd_soc_component *amp)
+{
+	struct snd_soc_component *owner = wsa_macro_fullio_clock_owner(card, amp, NULL);
+
+	if (IS_ERR(owner))
+		return PTR_ERR(owner);
+	if (wsa_macro_fullio_clock_audit(card))
+		return wsa_macro_fullio_verify_clocks_off(owner);
+	return wsa_macro_fullio_tx_clocks(owner, false, NULL, NULL);
+}
+
+/* Call from the PCM lifetime, never inside SoundWire status notification. */
+int wsa_macro_fullio_clock_off_for_pa(struct snd_soc_component *amp);
+int wsa_macro_fullio_clock_off_for_pa(struct snd_soc_component *amp)
+{
+	struct snd_soc_card *card = amp->card;
+	bool audit = wsa_macro_fullio_clock_audit(card) &&
+		of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-muted-test") &&
+		of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-pa-stop-audit");
+
+	if (!wsa_macro_fullio_post_pa_probe(amp) && !audit &&
+	    !wsa_macro_fullio_reference_route(card))
+		return -EOPNOTSUPP;
+	/* The clock-off marker makes the audit a read-only operation. */
+	return wsa_macro_fullio_clock_off_on_card(card, amp);
+}
+EXPORT_SYMBOL_GPL(wsa_macro_fullio_clock_off_for_pa);
+
+int wsa_macro_fullio_clock_off_for_feedback(struct snd_soc_card *card);
+int wsa_macro_fullio_clock_off_for_feedback(struct snd_soc_card *card)
+{
+	if (!card || !of_machine_is_compatible("microsoft,denali") ||
