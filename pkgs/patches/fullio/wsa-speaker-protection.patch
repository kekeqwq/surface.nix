+/* The reference STOP is ordered, beginning with PA off. Continue the
+ * remaining containment writes on error and report the first failure.
+ */
+static int wsa884x_fullio_reference_stop(struct wsa884x_priv *amp)
+{
+	static const struct reg_sequence sequence[] = {
+		{ WSA884X_PA_FSM_EN, 0x00 },
+		{ WSA884X_INTR_MASK0, 0xff },
+		{ WSA884X_INTR_MASK1, 0x03 },
+		{ WSA884X_INTR_CLEAR0, 0xff },
+		{ WSA884X_INTR_CLEAR1, 0x03 },
+		{ WSA884X_CLSH_CTL_0, 0x00 },
+	};
+	int first = 0;
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(sequence); ++i) {
+		int ret = regmap_write(amp->regmap, sequence[i].reg, sequence[i].def);
+
+		if (!first && ret)
+			first = ret;
+	}
+	return first;
+}
+
+/* Never invoked from an IRQ or a SoundWire status notifier. Check
+ * readback even if the PA write failed; failure is not proof of PA off.
+ */
+static int wsa884x_fullio_verified_stop(struct snd_soc_component *component,
+					struct wsa884x_priv *amp)
+{
+	unsigned int value;
+	int pa, verify, clock;
+	s64 epoch;
+
+	atomic_inc_return(&amp->fullio_pa_teardowns);
+	epoch = atomic64_inc_return(&amp->fullio_pa_epoch);
+	clock = wsa_macro_fullio_clock_off_for_pa(component);
+
+	/* Keep the gain cap in force even if the PA-off write fails. */
+	if (amp->fullio_reference_codec)
+		pa = wsa884x_fullio_reference_stop(amp);
+	else
+		pa = regmap_write_bits(amp->regmap, WSA884X_PA_FSM_EN,
+				       WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK, 0);
+	verify = regmap_read_bypassed(amp->regmap, WSA884X_PA_FSM_EN, &value);
+	if (!verify && (value & WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK))
+		verify = -EBUSY;
+	if (!verify && READ_ONCE(amp->slave->status) != SDW_SLAVE_ATTACHED)
+		verify = -ENODEV;
+	if (!verify && epoch != atomic64_read_acquire(&amp->fullio_pa_epoch))
+		verify = -ESTALE;
+	atomic_dec_return(&amp->fullio_pa_teardowns);
+	if (clock || pa < 0 || verify)
+		dev_err_ratelimited(component->dev,
+			"FullIO PA shutdown not fully verified: clock=%d PA=%d readback=%d\n",
+			clock, pa, verify);
+	if (amp->fullio_reference_codec) {
+		if (clock || pa || verify)
+			WRITE_ONCE(amp->hw_init, false);
+		return clock ?: pa ?: verify;
+	}
+	return verify ?: (pa < 0 ? pa : clock);
