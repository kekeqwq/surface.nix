+	guard(mutex)(&pair.amp[0]->sp_lock);
+	mutex_lock_nested(&pair.amp[1]->sp_lock, SINGLE_DEPTH_NESTING);
+	for (unsigned int i = 0; i < ARRAY_SIZE(pair.amp); ++i) {
+		ret = pm_runtime_resume_and_get(pair.amp[i]->dev);
+		if (ret < 0)
+			goto out;
+		refs++;
+		ret = wsa884x_fullio_read_pa(pair.codec[i], true, &snapshot);
+		if (ret)
+			goto out;
+		if ((snapshot.enable & WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK) || snapshot.sta1 ||
+		    snapshot.err0 || snapshot.err1 || snapshot.vphx != 0x02) {
+			ret = -EIO;
+			goto out;
+		}
