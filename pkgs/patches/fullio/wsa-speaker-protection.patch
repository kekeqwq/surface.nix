+static int wsa884x_fullio_cold_start(struct wsa884x_priv *amp)
+{
+	unsigned int value;
+	int ret;
+
+	/* The reference lifecycle re-runs the cold table after every SoundWire
+	 * attach (idle clock collapse is routine). Only a failed table — which
+	 * leaves partially written analog state — is never retried.
+	 */
+	if (amp->fullio_cold_failed)
+		return -ENOTRECOVERABLE;
+
+	/* VPHX is diagnostic on this fixed 2S Denali hardware: the reference
+	 * logs a mismatch and applies the table anyway. Never dead-end the
+	 * codec on a status-read race at SoundWire re-attach.
+	 */
+	ret = regmap_read_bypassed(amp->regmap, WSA884X_VPHX_SYS_EN_STATUS, &value);
+	if (ret || value != 0x02)
+		dev_warn(amp->dev, "FullIO cold setup: VPHX status %#x (read %d), applying the 2S reference table\n",
+			 value, ret);
+	ret = regmap_read_bypassed(amp->regmap, WSA884X_PA_FSM_EN, &value);
+	if (ret || (value & WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK))
+		return ret ?: -EBUSY;
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(wsa884x_fullio_cold_init); ++i) {
+		const struct reg_sequence *entry = &wsa884x_fullio_cold_init[i];
+
+		ret = regmap_write(amp->regmap, entry->reg, entry->def);
+		if (ret) {
+			amp->fullio_cold_failed = true;
+			return ret;
+		}
+	}
+	ret = regmap_read_bypassed(amp->regmap, WSA884X_PA_FSM_EN, &value);
+	if (ret || (value & WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK)) {
+		amp->fullio_cold_failed = true;
+		return ret ?: -EIO;
+	}
+	WRITE_ONCE(amp->hw_init, true);
+	return 0;
+}
