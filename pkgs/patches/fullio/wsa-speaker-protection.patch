+	struct wsa884x_fullio_start_pair pair = {
+		.codec = { left, right }, .verify_graph = verify_graph, .context = context,
+	};
+	struct device_node *node;
+	struct wsa884x_fullio_pa_snapshot snapshot;
+	unsigned int refs = 0;
