+static const struct snd_soc_component_driver wsa_macro_component_drv;
+static const unsigned int fullio_tx_regs[] = {
+	CDC_WSA_TX0_SPKR_PROT_PATH_CTL, CDC_WSA_TX1_SPKR_PROT_PATH_CTL,
+	CDC_WSA_TX2_SPKR_PROT_PATH_CTL, CDC_WSA_TX3_SPKR_PROT_PATH_CTL,
+};
+
+static int wsa_macro_fullio_tx_update(struct wsa_macro *wsa, unsigned int first,
+				     unsigned int end, unsigned int mask,
+				     unsigned int value, bool exhaustive)
+{
+	int first_error = 0, ret;
+	unsigned int i, actual;
+
+	for (i = first; i < end; i++) {
+		ret = regmap_update_bits(wsa->regmap, fullio_tx_regs[i], mask, value);
+		if (!ret)
+			ret = regmap_read_bypassed(wsa->regmap, fullio_tx_regs[i], &actual);
+		if (!ret && (actual & mask) != value)
+			ret = -EIO;
+		if (ret && !first_error)
+			first_error = ret;
+		if (ret && !exhaustive)
+			break;
+	}
+	return first_error;
+}
+
+static bool wsa_macro_fullio_post_pa_probe(struct snd_soc_component *component)
+{
+	return component->card && of_machine_is_compatible("microsoft,denali") &&
+	       of_property_read_bool(component->card->dev->of_node,
+				     "microsoft,denali-fullio-post-pa-test");
+}
+
+static bool wsa_macro_fullio_reference_route(struct snd_soc_card *card)
+{
+	return card && of_machine_is_compatible("microsoft,denali") &&
+	       of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-reference-render") &&
+	       !of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-muted-test");
+}
+
+static bool wsa_macro_fullio_clock_audit(struct snd_soc_card *card)
+{
+	return card && of_machine_is_compatible("microsoft,denali") &&
+	       of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-clock-off-audit");
+}
+
+/* Golden v33 applies this at the producer after enabling the VI paths.
+ * Do not substitute a downstream channel swap: that would double-correct.
+ */
+static int wsa_macro_fullio_v33_vi_order(struct wsa_macro *wsa)
+{
+	unsigned int actual;
+	int ret;
+
+	/* Force a write even if the cached value already equals 0x03. */
+	ret = regmap_write(wsa->regmap, CDC_WSA_TOP_TOP_CFG1, 0x03);
+	if (ret)
+		return ret;
+	ret = regmap_read_bypassed(wsa->regmap, CDC_WSA_TOP_TOP_CFG1, &actual);
+	if (ret)
+		return ret;
+	return actual == 0x03 ? 0 : -EIO;
+}
+
+static int wsa_macro_fullio_start_pair(struct wsa_macro *wsa, unsigned int first)
+{
+	unsigned int end = first + 2;
+	int ret;
+
+	ret = wsa_macro_fullio_tx_update(wsa, first, end, CDC_WSA_TX_SPKR_PROT_RESET_MASK,
+					 CDC_WSA_TX_SPKR_PROT_RESET, false);
+	if (!ret)
+		ret = wsa_macro_fullio_tx_update(wsa, first, end, CDC_WSA_TX_SPKR_PROT_PCM_RATE_MASK,
+						 CDC_WSA_TX_SPKR_PROT_PCM_RATE_8K, false);
+	if (!ret)
+		ret = wsa_macro_fullio_tx_update(wsa, first, end, CDC_WSA_TX_SPKR_PROT_CLK_EN_MASK,
+						 CDC_WSA_TX_SPKR_PROT_CLK_ENABLE, false);
+	if (!ret)
+		ret = wsa_macro_fullio_tx_update(wsa, first, end, CDC_WSA_TX_SPKR_PROT_RESET_MASK,
+						 CDC_WSA_TX_SPKR_PROT_NO_RESET, false);
+	return ret ?: wsa_macro_fullio_v33_vi_order(wsa);
+}
+
+/* Only a future card-local coordinator can supply hardware/mute verification.
+ * There is deliberately no caller and no board opt-in in this patch.
+ */
+static int wsa_macro_fullio_verify_clocks_off_locked(struct wsa_macro *wsa);
+
+static int wsa_macro_fullio_tx_clocks(struct snd_soc_component *component, bool enable,
+				     int (*verify_ready)(void *ctx), void *ctx)
+{
+	struct wsa_macro *wsa = snd_soc_component_get_drvdata(component);
+	int ret, cleanup;
+	guard(mutex)(&wsa->fullio_clock_lock);
+	if (!enable && !wsa->fullio_clock_pm)
+		return wsa_macro_fullio_verify_clocks_off_locked(wsa);
+	if (enable) {
+		if (wsa_macro_fullio_clock_audit(component->card) || !verify_ready || wsa->fullio_clock_fault)
+			return -EPERM;
+		ret = verify_ready(ctx);
+		if (ret)
+			return ret;
+		if (wsa->fullio_clock_pm)
+			return -EBUSY;
+		ret = pm_runtime_resume_and_get(wsa->dev);
+		if (ret < 0)
+			return ret;
+		ret = verify_ready(ctx);
+		if (ret) {
+			/* No TX lane was touched; drop only this transient vote. */
+			pm_runtime_put_autosuspend(wsa->dev);
+			return ret;
+		}
+		wsa->fullio_clock_pm = true;
+		ret = wsa_macro_fullio_start_pair(wsa, 0);
+		if (!ret)
+			ret = verify_ready(ctx);
+		if (!ret)
+			ret = wsa_macro_fullio_start_pair(wsa, 2);
+		if (!ret)
+			ret = verify_ready(ctx);
+		if (!ret)
+			return 0;
+	} else {
+		ret = 0;
+	}
+
+	cleanup = wsa_macro_fullio_tx_update(wsa, 0, ARRAY_SIZE(fullio_tx_regs),
+					     CDC_WSA_TX_SPKR_PROT_RESET_MASK |
+					     CDC_WSA_TX_SPKR_PROT_CLK_EN_MASK,
+					     CDC_WSA_TX_SPKR_PROT_RESET, true);
+	if (cleanup) {
+		wsa->fullio_clock_fault = true;
+		dev_err(wsa->dev, "FullIO protection clock shutdown unverified: %d\n", cleanup);
+		return ret ?: cleanup;
+	}
+	wsa->fullio_clock_pm = false;
+	pm_runtime_put_autosuspend(wsa->dev);
+	return ret;
+}
+int wsa_macro_fullio_protclk(struct snd_soc_component *component, bool enable,
+			    int (*verify_ready)(void *ctx), void *ctx);
+int wsa_macro_fullio_protclk(struct snd_soc_component *component, bool enable,
+			    int (*verify_ready)(void *ctx), void *ctx)
+{
+	if (!component || component->driver != &wsa_macro_component_drv ||
+	    !wsa_macro_fullio_post_pa_probe(component))
+		return -EOPNOTSUPP;
+	return wsa_macro_fullio_tx_clocks(component, enable, verify_ready, ctx);
+}
+EXPORT_SYMBOL_GPL(wsa_macro_fullio_protclk);
