+	if (ret)
+		return ret < 0 ? ret : -EPROTO;
+	for (unsigned int i = 0; i < ARRAY_SIZE(pair->amp); ++i) {
+		ret = wsa884x_fullio_verify_transport(pair->amp[i]);
+		if (ret)
