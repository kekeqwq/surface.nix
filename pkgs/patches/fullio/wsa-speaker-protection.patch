+			     int (*verify_graph)(void *), void *context, int *stop_error);
+int wsa884x_fullio_start_pair(struct snd_soc_component *left,
+			     struct snd_soc_component *right,
+			     int (*verify_graph)(void *), void *context, int *stop_error)
