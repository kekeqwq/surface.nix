+	    left->driver != &wsa884x_component_drv || right->driver != &wsa884x_component_drv ||
+	    !left->name_prefix || strcmp(left->name_prefix, "SpkrLeft") ||
+	    !right->name_prefix || strcmp(right->name_prefix, "SpkrRight") ||
+	    !of_machine_is_compatible("microsoft,denali"))
+		return -EPERM;
