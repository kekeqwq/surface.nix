+static int wsa884x_fullio_verify_transport(struct wsa884x_priv *amp)
+{
+	if (!READ_ONCE(amp->hw_init) || READ_ONCE(amp->slave->status) != SDW_SLAVE_ATTACHED)
+		return -ENODEV;
+	for (unsigned int i = WSA884X_DAI_PLAYBACK; i <= WSA884X_DAI_CPS; ++i) {
+		struct sdw_stream_runtime *transport = READ_ONCE(amp->attached[i]);
