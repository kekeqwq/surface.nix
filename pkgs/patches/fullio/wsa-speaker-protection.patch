+	for (unsigned int i = 0; i < ARRAY_SIZE(sequence); ++i) {
+		/* Dwell at the reference half-drive setting before PA enable.
+		 * Keep this separate from the PA-ready checks; waiting here
+		 * is not proof that the PA or protection feedback is ready.
+		 */
+		if (sequence[i].reg == WSA884X_PA_FSM_EN) {
+			unsigned int settle = min(wsa884x_pa_settle_us, 1000000U);
