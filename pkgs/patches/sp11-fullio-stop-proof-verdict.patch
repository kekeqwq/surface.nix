Subject: [EXPERIMENT] ASoC: do not mask an unverified FullIO PA shutdown

Keep the paired hardware shutdown verdict distinct from the DSP audit
error. A failed fallback cannot be hidden by an earlier graph error.
The opt-in proof-loss fixture discards the positive proof only after
both real PA and clock readbacks, without modifying hardware state.

--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -553,11 +553,38 @@
 		return left;
 	left = wsa884x_fullio_stop_audit(pair.left);
 	right = wsa884x_fullio_stop_audit(pair.right);
-	if (left || right)
+	if (left || right) {
 		dev_err(card->dev, "FullIO PA-off teardown failed: left=%d right=%d\n", left, right);
-	return left ?: right;
+		return left ?: right;
+	}
+	/* Exercise rejection of missing proof, never fake the PA/clock state. */
+	if (of_property_read_bool(card->dev->of_node,
+				  "microsoft,denali-fullio-pa-off-missing-stop-proof")) {
+		dev_info(card->dev, "FullIO injected missing PA-off proof after both hardware checks\n");
+		return -ENODATA;
+	}
+	return 0;
 }
 
+/* A DSP STOP acknowledgement is not evidence about the physical PAs. */
+static int q6apm_fullio_finish_audit(struct snd_soc_card *card, int dsp_result,
+				    bool worker_verified)
+{
+	int stop;
+
+	if (worker_verified ||
+	    !of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-pa-stop-audit"))
+		return dsp_result;
+
+	stop = q6apm_fullio_stop_pair_audit(card);
+	if (!stop)
+		return dsp_result;
+
+	dev_err(card->dev, "FullIO paired PA shutdown unverified: PA=%d, graph audit=%d; render locked\n",
+		stop, dsp_result);
+	return -ENOTRECOVERABLE;
+}
+
 struct q6apm_fullio_fault_work {
 	struct work_struct work;
 	struct snd_soc_card *card;
@@ -825,13 +852,7 @@
 
 		ret = q6apm_fullio_audit_start_stop(prtd->graph, card, q6apm_fullio_verify_silent_audit,
 						   &audit);
-		if (!audit.stop_worker_done &&
-		    of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-pa-stop-audit")) {
-			int stop = q6apm_fullio_stop_pair_audit(card);
-
-			if (stop && !ret)
-				ret = stop;
-		}
+		ret = q6apm_fullio_finish_audit(card, ret, audit.stop_worker_done);
 		if (ret)
 			return ret;
 	} else {
