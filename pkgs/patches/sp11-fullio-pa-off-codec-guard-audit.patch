Subject: [EXPERIMENT] ASoC: observe stock WSA codec guards on the PA-off route

Sample watchdog and current-limit configuration around speaker widget
events, with uncached PA-off and transport checks and no register writes
in the observer. The watchdog enable bit is not evidence of its trip
behavior, and the limit code is not a calibrated current measurement.

--- a/sound/soc/codecs/wsa884x.c
+++ b/sound/soc/codecs/wsa884x.c
@@ -1756,7 +1756,62 @@
 				      WSA884X_CURRENT_LIMIT_CURRENT_LIMIT_MASK,
 				      curr_limit);
 }
+
+/*
+ * Sample the stock codec guard configuration with the physical PA off.
+ * Do not wake the bus, change any register, or infer watchdog trip time.
+ */
+static void wsa884x_fullio_audit_guard(struct snd_soc_component *component,
+				      struct wsa884x_priv *amp, bool powered)
+{
+	struct device_node *sound = component->card ? component->card->dev->of_node : NULL;
+	unsigned int before, after, wd, limit;
+	s64 epoch;
+	int ret;
+
+	if (!amp->feedback_enabled || !of_machine_is_compatible("microsoft,denali") ||
+	    !of_property_read_bool(sound, "microsoft,denali-fullio-muted-test") ||
+	    !of_property_read_bool(sound, "microsoft,denali-fullio-clock-off-audit") ||
+	    !of_property_read_bool(sound, "microsoft,denali-fullio-pa-off-guard-audit") ||
+	    of_property_read_bool(sound, "microsoft,denali-fullio-post-pa-test"))
+		return;
 
+	ret = pm_runtime_get_if_active(amp->dev);
+	if (ret <= 0)
+		goto failed;
+	epoch = atomic64_read_acquire(&amp->fullio_pa_epoch);
+	if (READ_ONCE(amp->slave->status) != SDW_SLAVE_ATTACHED ||
+	    atomic_read_acquire(&amp->fullio_pa_teardowns)) {
+		ret = -EAGAIN;
+		goto put;
+	}
+	ret = regmap_read_bypassed(amp->regmap, WSA884X_PA_FSM_EN, &before);
+	if (!ret && (before & WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK))
+		ret = -EBUSY;
+	if (!ret)
+		ret = regmap_read_bypassed(amp->regmap, WSA884X_PDM_WD_CTL, &wd);
+	if (!ret)
+		ret = regmap_read_bypassed(amp->regmap, WSA884X_CURRENT_LIMIT, &limit);
+	if (!ret)
+		ret = regmap_read_bypassed(amp->regmap, WSA884X_PA_FSM_EN, &after);
+	if (!ret && (after != before || READ_ONCE(amp->slave->status) != SDW_SLAVE_ATTACHED ||
+		     atomic_read_acquire(&amp->fullio_pa_teardowns) ||
+		     atomic64_read_acquire(&amp->fullio_pa_epoch) != epoch))
+		ret = -EAGAIN;
+	if (!ret && !!(wd & WSA884X_PDM_WD_CTL_PDM_WD_EN_MASK) != powered)
+		ret = -EIO;
+	if (!ret)
+		dev_info(amp->dev, "FullIO PA-off codec guard: route=%s PDM_WD_CTL=0x%02x CURRENT_LIMIT=0x%02x\n",
+			 powered ? "on" : "off", wd, limit);
+put:
+	pm_runtime_put_autosuspend(amp->dev);
+	if (!ret)
+		return;
+failed:
+	dev_warn(amp->dev, "FullIO PA-off codec guard unverified: route=%s ret=%d\n",
+		 powered ? "on" : "off", ret ?: -EAGAIN);
+}
+
 static int wsa884x_spkr_event(struct snd_soc_dapm_widget *w,
 			      struct snd_kcontrol *kcontrol, int event)
 {
@@ -1773,6 +1828,7 @@
 		snd_soc_component_write_field(component, WSA884X_PDM_WD_CTL,
 					      WSA884X_PDM_WD_CTL_PDM_WD_EN_MASK,
 					      0x1);
+		wsa884x_fullio_audit_guard(component, wsa884x, true);
 
 		break;
 	case SND_SOC_DAPM_PRE_PMD:
@@ -1782,6 +1838,7 @@
 
 		scoped_guard(mutex, &wsa884x->sp_lock)
 			wsa884x->pa_on = false;
+		wsa884x_fullio_audit_guard(component, wsa884x, false);
 		break;
 	}
 
