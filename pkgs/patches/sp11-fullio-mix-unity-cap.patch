Prevent positive WSA MIX gain on marked Denali FullIO configurations.

--- a/sound/soc/qcom/x1e80100.c
+++ b/sound/soc/qcom/x1e80100.c
@@ -23,6 +23,29 @@
 	bool jack_setup;
 };
 
+static int x1e80100_fullio_mix_cap(struct snd_soc_card *card)
+{
+	static const char * const controls[] = {
+		"WSA WSA_RX0_MIX Digital Volume",
+		"WSA WSA_RX1_MIX Digital Volume",
+	};
+	size_t i;
+	int ret;
+
+	if (!of_machine_is_compatible("microsoft,denali") ||
+	    !of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-muted-test"))
+		return 0;
+
+	/* S8 mixer values are offset by 84; unity is 84, not signed zero. */
+	for (i = 0; i < ARRAY_SIZE(controls); i++) {
+		ret = snd_soc_limit_volume(card, controls[i], 84);
+		if (ret)
+			return dev_err_probe(card->dev, ret, "cannot cap %s\n", controls[i]);
+	}
+
+	return 0;
+}
+
 static int x1e80100_snd_init(struct snd_soc_pcm_runtime *rtd)
 {
 	struct x1e80100_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
@@ -30,6 +53,7 @@
 	struct snd_soc_card *card = rtd->card;
 	struct snd_soc_jack *dp_jack = NULL;
 	int dp_pcm_id = 0;
+	int ret;
 
 	switch (cpu_dai->id) {
 	case WSA_CODEC_DMA_RX_0:
@@ -49,6 +73,9 @@
 		snd_soc_limit_volume(card, "TweeterLeft PA Volume", 6);
 		snd_soc_limit_volume(card, "WooferRight PA Volume", 6);
 		snd_soc_limit_volume(card, "TweeterRight PA Volume", 6);
+		ret = x1e80100_fullio_mix_cap(card);
+		if (ret)
+			return ret;
 		break;
 	case DISPLAY_PORT_RX_0:
 		dp_pcm_id = 0;
