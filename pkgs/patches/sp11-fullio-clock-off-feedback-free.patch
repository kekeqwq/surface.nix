Subject: [EXPERIMENT] ASoC: stop FullIO clocks on feedback teardown

Revoke VI/CPS evidence before shutting down the card-local clock owner.
Still release the underlying SoundWire stream even if shutdown fails.
Only a future post-PA fixture can use the clock hook.

diff --git a/sound/soc/codecs/lpass-wsa-macro.c b/sound/soc/codecs/lpass-wsa-macro.c
index 8d15008..633ebb7 100755
--- a/sound/soc/codecs/lpass-wsa-macro.c
+++ b/sound/soc/codecs/lpass-wsa-macro.c
@@ -1697,21 +1697,16 @@ int wsa_macro_fullio_protclk(struct snd_soc_component *component, bool enable,
 }
 EXPORT_SYMBOL_GPL(wsa_macro_fullio_protclk);
 
-/* Called synchronously from playback mute, never from a SoundWire status
- * notification. Resolve the clock owner from the emitter's own playback link.
- */
-int wsa_macro_fullio_clock_off_for_pa(struct snd_soc_component *amp);
-int wsa_macro_fullio_clock_off_for_pa(struct snd_soc_component *amp)
+/* Resolve clock ownership from the card's playback link, not global state. */
+static int wsa_macro_fullio_clock_off_on_card(struct snd_soc_card *card,
+					     struct snd_soc_component *amp)
 {
-	struct snd_soc_card *card = amp->card;
 	struct snd_soc_pcm_runtime *rtd, *target = NULL;
 	struct snd_soc_component *owner = NULL;
 	struct snd_soc_dai *codec;
 	unsigned int emitters = 0;
 	int i;
 
-	if (!wsa_macro_fullio_post_pa_probe(amp))
-		return -EOPNOTSUPP;
 	for_each_card_rtds(card, rtd) {
 		if (strcmp(rtd->dai_link->name, "WSA Playback"))
 			continue;
@@ -1730,12 +1725,31 @@ int wsa_macro_fullio_clock_off_for_pa(struct snd_soc_component *amp)
 			return -EEXIST;
 		owner = codec->component;
 	}
-	if (emitters != 1 || !owner || owner->card != card)
+	if ((amp && emitters != 1) || !owner || owner->card != card)
 		return -ENODEV;
 	return wsa_macro_fullio_protclk(owner, false, NULL, NULL);
 }
+
+/* Call from the PCM lifetime, never inside SoundWire status notification. */
+int wsa_macro_fullio_clock_off_for_pa(struct snd_soc_component *amp);
+int wsa_macro_fullio_clock_off_for_pa(struct snd_soc_component *amp)
+{
+	if (!wsa_macro_fullio_post_pa_probe(amp))
+		return -EOPNOTSUPP;
+	return wsa_macro_fullio_clock_off_on_card(amp->card, amp);
+}
 EXPORT_SYMBOL_GPL(wsa_macro_fullio_clock_off_for_pa);
 
+int wsa_macro_fullio_clock_off_for_feedback(struct snd_soc_card *card);
+int wsa_macro_fullio_clock_off_for_feedback(struct snd_soc_card *card)
+{
+	if (!card || !of_machine_is_compatible("microsoft,denali") ||
+	    !of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-post-pa-test"))
+		return -EOPNOTSUPP;
+	return wsa_macro_fullio_clock_off_on_card(card, NULL);
+}
+EXPORT_SYMBOL_GPL(wsa_macro_fullio_clock_off_for_feedback);
+
 static void wsa_macro_enable_disable_vi_feedback(struct snd_soc_component *component,
 						 bool enable, u32 rate)
 {
diff --git a/sound/soc/qcom/x1e80100.c b/sound/soc/qcom/x1e80100.c
index decb8f2..30b57e3 100644
--- a/sound/soc/qcom/x1e80100.c
+++ b/sound/soc/qcom/x1e80100.c
@@ -153,11 +153,21 @@ static int x1e80100_snd_hw_map_channels(unsigned int *ch_map, int num)
 	return 0;
 }
 
+#if IS_REACHABLE(CONFIG_SND_SOC_LPASS_WSA_MACRO)
+int wsa_macro_fullio_clock_off_for_feedback(struct snd_soc_card *card);
+#else
+static int wsa_macro_fullio_clock_off_for_feedback(struct snd_soc_card *card)
+{
+	return -EOPNOTSUPP;
+}
+#endif
+
 static void x1e80100_fullio_feedback(struct snd_pcm_substream *substream, bool enabled)
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	const char *model = NULL;
+	int ret;
 
 	if (!of_machine_is_compatible("microsoft,denali") ||
 	    of_property_read_string(rtd->card->dev->of_node, "model", &model) ||
@@ -171,6 +181,19 @@ static void x1e80100_fullio_feedback(struct snd_pcm_substream *substream, bool e
 	case WSA_CODEC_DMA_TX_1:
 		q6apm_fullio_set_transport(cpu_dai->dev, Q6APM_FULLIO_CPS, enabled);
 		break;
+	default:
+		return;
+	}
+
+	/* Revoke the graph's transport epoch before touching clocks. The
+	 * machine caller still performs hw_free/shutdown on an error here.
+	 */
+	if (!enabled && of_property_read_bool(rtd->card->dev->of_node,
+					      "microsoft,denali-fullio-post-pa-test")) {
+		ret = wsa_macro_fullio_clock_off_for_feedback(rtd->card);
+		if (ret)
+			dev_err_ratelimited(rtd->card->dev,
+					    "FullIO clock shutdown failed at feedback teardown: %d\n", ret);
 	}
 }
 
