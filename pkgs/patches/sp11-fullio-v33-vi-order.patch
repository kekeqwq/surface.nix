Subject: [EXPERIMENT] ASoC: WSA: materialize Golden-v33 VI producer order

After enabling the VI protection paths in the dormant FullIO helper,
write TOP_CFG1=0x03 and require uncached readback. Mismatch takes the
existing checked rollback path. No caller, DT opt-in or unmute is added.
Reference: geocausa/SP11X1e-audio Golden-v33 producer patch 0072.

--- a/sound/soc/codecs/lpass-wsa-macro.c
+++ b/sound/soc/codecs/lpass-wsa-macro.c
@@ -1638,6 +1638,24 @@
 {
 	return card && of_machine_is_compatible("microsoft,denali") &&
 	       of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-clock-off-audit");
+}
+
+/* Golden v33 applies this at the producer after enabling the VI paths.
+ * Do not substitute a downstream channel swap: that would double-correct.
+ */
+static int wsa_macro_fullio_v33_vi_order(struct wsa_macro *wsa)
+{
+	unsigned int actual;
+	int ret;
+
+	/* Force a write even if the cached value already equals 0x03. */
+	ret = regmap_write(wsa->regmap, CDC_WSA_TOP_TOP_CFG1, 0x03);
+	if (ret)
+		return ret;
+	ret = regmap_read_bypassed(wsa->regmap, CDC_WSA_TOP_TOP_CFG1, &actual);
+	if (ret)
+		return ret;
+	return actual == 0x03 ? 0 : -EIO;
 }
 
 /* Only a future card-local coordinator can supply hardware/mute verification.
@@ -1681,6 +1699,8 @@
 		if (!ret)
 			ret = wsa_macro_fullio_tx_update(wsa, CDC_WSA_TX_SPKR_PROT_RESET_MASK,
 							 CDC_WSA_TX_SPKR_PROT_NO_RESET, false);
+		if (!ret)
+			ret = wsa_macro_fullio_v33_vi_order(wsa);
 		if (!ret)
 			ret = verify_ready(ctx);
 		if (!ret)
