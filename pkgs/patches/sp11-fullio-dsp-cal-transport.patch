+static int q6apm_fullio_validate_frames(const void *data, size_t bytes, bool single)
+{
+	const u8 *frame = data;
+	unsigned int count = 0;
+
+	if (!data || !bytes || bytes > SZ_16K || !IS_ALIGNED(bytes, 8))
+		return -EINVAL;
+	while (bytes) {
+		u32 size;
+		size_t step;
+
+		if (bytes < APM_MODULE_PARAM_DATA_SIZE ||
+		    !get_unaligned_le32(frame) || !get_unaligned_le32(frame + 4) ||
+		    get_unaligned_le32(frame + 12))
+			return -EINVAL;
+		size = get_unaligned_le32(frame + 8);
+		if (!size || size > bytes - APM_MODULE_PARAM_DATA_SIZE)
+			return -EINVAL;
+		step = ALIGN(APM_MODULE_PARAM_DATA_SIZE + (size_t)size, 8);
+		if (step > bytes)
+			return -EINVAL;
+		frame += step;
+		bytes -= step;
+		count++;
+	}
+	return single && count != 1 ? -EINVAL : 0;
+}
+
+int q6apm_fullio_set_cfg_oob(struct q6apm_graph *graph,
+			   struct q6apm_fullio_oob_region *region, void *buffer,
+			   const void *data, size_t bytes, bool use_graph_port)
+{
+	struct apm_cmd_header *cmd;
+	int ret;
+
+	if (!graph->ar_graph || !buffer || !region->handle || region->poisoned ||
+	    bytes > region->size || (use_graph_port && !graph->port))
+		return -EINVAL;
+	ret = q6apm_fullio_validate_frames(data, bytes, false);
+	if (ret)
+		return ret;
+	if (!q6apm_fullio_transport_enabled(graph->apm))
+		return -EAGAIN;
+
+	struct gpr_pkt *pkt __free(kfree) = use_graph_port ?
+		audioreach_alloc_cmd_pkt(0, APM_CMD_SET_CFG, 0, graph->port->id,
+					APM_MODULE_INSTANCE_ID) :
+		audioreach_alloc_apm_cmd_pkt(0, APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	cmd = (void *)pkt + GPR_HDR_SIZE;
+	cmd->payload_address_lsw = lower_32_bits(region->dsp_addr);
+	cmd->payload_address_msw = upper_32_bits(region->dsp_addr);
+	cmd->mem_map_handle = region->handle;
+	cmd->payload_size = bytes;
+
+	memset(buffer, 0, region->size);
+	memcpy(buffer, data, bytes);
+	dma_wmb();
+	ret = q6apm_fullio_oob_rpc(graph->apm, use_graph_port ? graph->port : NULL,
+				 pkt, NULL);
+	if (ret)
+		region->poisoned = true;
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_set_cfg_oob);
+
+int q6apm_fullio_set_cfg_inband(struct q6apm_graph *graph, const void *data,
+			      size_t bytes)
+{
+	int ret;
+
+	if (!graph->ar_graph || !graph->port)
+		return -EINVAL;
+	ret = q6apm_fullio_validate_frames(data, bytes, true);
+	if (ret)
+		return ret;
+	if (!q6apm_fullio_transport_enabled(graph->apm))
+		return -EAGAIN;
+
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_cmd_pkt(bytes, APM_CMD_SET_CFG, 0, graph->port->id,
+					APM_MODULE_INSTANCE_ID);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	memcpy((void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE, data, bytes);
+	return q6apm_fullio_oob_rpc(graph->apm, graph->port, pkt, NULL);
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_set_cfg_inband);
