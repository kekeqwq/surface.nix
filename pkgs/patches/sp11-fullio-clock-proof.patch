Require a hardware clock-off proof without a tracked PM vote and avoid TX writes before admission.

--- a/sound/soc/codecs/lpass-wsa-macro.c
+++ b/sound/soc/codecs/lpass-wsa-macro.c
@@ -1681,6 +1681,8 @@
 /* Only a future card-local coordinator can supply hardware/mute verification.
  * There is deliberately no caller and no board opt-in in this patch.
  */
+static int wsa_macro_fullio_verify_clocks_off_locked(struct wsa_macro *wsa);
+
 int wsa_macro_fullio_protclk(struct snd_soc_component *component, bool enable,
 			    int (*verify_ready)(void *ctx), void *ctx);
 int wsa_macro_fullio_protclk(struct snd_soc_component *component, bool enable,
@@ -1695,7 +1697,7 @@
 	wsa = snd_soc_component_get_drvdata(component);
 	guard(mutex)(&wsa->fullio_clock_lock);
 	if (!enable && !wsa->fullio_clock_pm)
-		return 0;
+		return wsa_macro_fullio_verify_clocks_off_locked(wsa);
 	if (enable) {
 		if (wsa_macro_fullio_clock_audit(component->card) || !verify_ready || wsa->fullio_clock_fault)
 			return -EPERM;
@@ -1707,10 +1709,14 @@
 		ret = pm_runtime_resume_and_get(wsa->dev);
 		if (ret < 0)
 			return ret;
-		wsa->fullio_clock_pm = true;
 		ret = verify_ready(ctx);
-		if (!ret)
-			ret = wsa_macro_fullio_start_pair(wsa, 0);
+		if (ret) {
+			/* No TX lane was touched; drop only this transient vote. */
+			pm_runtime_put_autosuspend(wsa->dev);
+			return ret;
+		}
+		wsa->fullio_clock_pm = true;
+		ret = wsa_macro_fullio_start_pair(wsa, 0);
 		if (!ret)
 			ret = verify_ready(ctx);
 		if (!ret)
@@ -1741,13 +1747,12 @@
 /* No clock-control writes in the PA-off audit. Read all four lanes so
  * an unexpected enabling path is visible even when the DSP stays silent.
  */
-static int wsa_macro_fullio_verify_clocks_off(struct snd_soc_component *owner)
+static int wsa_macro_fullio_verify_clocks_off_locked(struct wsa_macro *wsa)
 {
-	struct wsa_macro *wsa = snd_soc_component_get_drvdata(owner);
 	unsigned int i, value, on = 0;
 	int ret;
 
-	guard(mutex)(&wsa->fullio_clock_lock);
+	lockdep_assert_held(&wsa->fullio_clock_lock);
 	if (wsa->fullio_clock_pm || wsa->fullio_clock_fault)
 		return -EBUSY;
 	ret = pm_runtime_resume_and_get(wsa->dev);
@@ -1772,6 +1777,14 @@
 	return 0;
 }
 
+static int wsa_macro_fullio_verify_clocks_off(struct snd_soc_component *owner)
+{
+	struct wsa_macro *wsa = snd_soc_component_get_drvdata(owner);
+
+	guard(mutex)(&wsa->fullio_clock_lock);
+	return wsa_macro_fullio_verify_clocks_off_locked(wsa);
+}
