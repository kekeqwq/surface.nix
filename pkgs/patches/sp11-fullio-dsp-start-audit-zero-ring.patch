Subject: [EXPERIMENT] ASoC: make FullIO silent-audit PCM ring deterministic

Disallow audit PCM mmap, clear only the DSP audio ring before START and
verify it is still zero after. Reject FullIO user start triggers.

diff --git a/sound/soc/qcom/qdsp6/q6apm-dai.c b/sound/soc/qcom/qdsp6/q6apm-dai.c
index 97e2270..349d9cd 100644
--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -560,9 +560,22 @@ static int wsa_macro_fullio_clock_off_for_feedback(struct snd_soc_card *card)
 
 struct q6apm_fullio_start_audit {
 	struct snd_soc_card *card;
+	struct snd_pcm_substream *substream;
 	struct q6apm_graph *graph;
+	size_t ring_bytes;
 };
 
+static bool q6apm_fullio_silent_ring_valid(struct q6apm_fullio_start_audit *audit)
+{
+	struct snd_pcm_substream *s = audit->substream;
+	struct snd_pcm_runtime *runtime = s->runtime;
+
+	return s->stream == SNDRV_PCM_STREAM_PLAYBACK &&
+	       runtime->access == SNDRV_PCM_ACCESS_RW_INTERLEAVED &&
+	       !(runtime->info & SNDRV_PCM_INFO_MMAP) && !atomic_read(&s->mmap_count) &&
+	       s->dma_buffer.area && audit->ring_bytes && audit->ring_bytes <= s->dma_buffer.bytes;
+}
+
 static int q6apm_fullio_verify_silent_audit(void *arg, bool started)
 {
 	struct q6apm_fullio_start_audit *audit = arg;
@@ -579,7 +592,21 @@ static int q6apm_fullio_verify_silent_audit(void *arg, bool started)
 			return ret;
 	}
 	/* The required clock-off audit marker makes this a read-only query. */
-	return wsa_macro_fullio_clock_off_for_feedback(audit->card);
+	ret = wsa_macro_fullio_clock_off_for_feedback(audit->card);
+	if (ret)
+		return ret;
+	if (!q6apm_fullio_silent_ring_valid(audit))
+		return -EPERM;
+	if (!started) {
+		/* ALSA is still in prepare; no trigger or data mmap is allowed.
+		 * Clear the actual DSP ring, without touching the position buffer.
+		 */
+		memset(audit->substream->dma_buffer.area, 0, audit->ring_bytes);
+		dma_wmb();
+	} else if (memchr_inv(audit->substream->dma_buffer.area, 0, audit->ring_bytes)) {
+		return -EILSEQ;
+	}
+	return 0;
 }
 
 static int q6apm_fullio_prepare_cal(struct q6apm_dai_data *pdata,
@@ -659,7 +686,13 @@ static int q6apm_fullio_prepare_cal(struct q6apm_dai_data *pdata,
 	if (ret)
 		return ret;
 	if (of_property_read_bool(card->dev->of_node, "microsoft,denali-fullio-dsp-start-audit")) {
-		struct q6apm_fullio_start_audit audit = { .card = card, .graph = prtd->graph };
+		struct q6apm_fullio_start_audit audit = {
+			.card = card,
+			.substream = prtd->substream,
+			.graph = prtd->graph,
+			.ring_bytes = pdata->has_reserved_mem ? pdata->reserved_buf_size :
+							       BUFFER_BYTES_MAX,
+		};
 
 		ret = q6apm_fullio_audit_start_stop(prtd->graph, card, q6apm_fullio_verify_silent_audit,
 						   &audit);
@@ -829,6 +862,8 @@ static int q6apm_dai_trigger(struct snd_soc_component *component,
 	case SNDRV_PCM_TRIGGER_START:
 	case SNDRV_PCM_TRIGGER_RESUME:
 	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		if (audioreach_fullio_graph(prtd->graph->info))
+			return -EOPNOTSUPP;
 		break;
 	case SNDRV_PCM_TRIGGER_STOP:
 		/* TODO support be handled via SoftPause Module */
@@ -888,6 +923,15 @@ static int q6apm_dai_open(struct snd_soc_component *component,
 		runtime->hw = q6apm_dai_hardware_playback;
 	else if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
 		runtime->hw = q6apm_dai_hardware_capture;
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK &&
+	    audioreach_fullio_graph(prtd->graph->info) &&
+	    of_property_read_bool(component->card->dev->of_node, "microsoft,denali-fullio-dsp-start-audit")) {
+		runtime->hw.info &= ~(SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_MMAP_VALID);
+		ret = snd_pcm_hw_constraint_mask64(runtime, SNDRV_PCM_HW_PARAM_ACCESS,
+						  BIT_ULL(SNDRV_PCM_ACCESS_RW_INTERLEAVED));
+		if (ret)
+			goto err;
+	}
 	if (probe_rate) {
 		runtime->hw.formats = SNDRV_PCM_FMTBIT_S32_LE;
 		runtime->hw.rates = probe_rate == 8000 ? SNDRV_PCM_RATE_8000 : SNDRV_PCM_RATE_24000;
