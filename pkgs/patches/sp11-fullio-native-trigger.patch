+static int q6apm_fullio_verify_start(void *arg)
+{
+	struct q6apm_graph *graph = arg;
+
+	if (!q6apm_fullio_mute_is_verified(graph))
+		return -ESTALE;
+	return 0;
+}
+
+/* The DSP graph is already running muted from PREPARE. Trigger START only
+ * coordinates the two PA transitions and the protection clocks, and never
+ * sends a second DSP transaction.
+ */
+static int q6apm_fullio_reference_start(struct q6apm_dai_rtd *prtd,
+					struct snd_soc_card *card)
+{
+	struct q6apm_fullio_amp_pair pair = {};
+	int ret, stop_error = 0;
+
+	ret = q6apm_fullio_amp_pair(card, "WSA Playback", &pair);
+	if (ret)
+		return ret;
+	return wsa884x_fullio_start_pair(pair.left, pair.right, q6apm_fullio_verify_start,
+					 prtd->graph, &stop_error);
+}
