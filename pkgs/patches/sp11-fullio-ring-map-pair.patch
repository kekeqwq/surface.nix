Preserve ring mapping errors and require both handles for FullIO.

--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -1159,8 +1159,14 @@
 {
 	struct audioreach_graph_info *info = graph->info;
 
-	return audioreach_setup_push_pull(graph, bphys, pphys, info->mem_map_handle,
-					  info->pos_buf_mem_map_handle, size);
+	u32 data_handle = READ_ONCE(info->mem_map_handle);
+	u32 pos_handle = READ_ONCE(info->pos_buf_mem_map_handle);
+
+	/* Presence is necessary, but does not prove current DSP ownership. */
+	if (audioreach_fullio_graph(info) && (!data_handle || !pos_handle))
+		return -ENODATA;
+
+	return audioreach_setup_push_pull(graph, bphys, pphys, data_handle, pos_handle, size);
 }
 EXPORT_SYMBOL_GPL(q6apm_push_pull_config);
 
