Subject: [EXPERIMENT] ASoC: start isolated CPS source before host read submissions

On the capture-only CPS fixture, start the native source after BE prepare
and before FE prepare queues read buffers. Unchanged VI and normal graphs.

diff --git a/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c b/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
index 8340df3..99dbe58 100644
--- a/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
+++ b/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
@@ -268,6 +268,7 @@ static int q6apm_lpass_dai_prepare(struct snd_pcm_substream *substream, struct s
 	struct q6apm_graph *graph;
 	struct device_node *node = dai->component->card->dev->of_node;
 	const char *probe;
+	bool start_cps_source = false;
 	int graph_id = dai->id;
 	int rc;
 
@@ -307,6 +308,7 @@ static int q6apm_lpass_dai_prepare(struct snd_pcm_substream *substream, struct s
 		    strcmp(probe, cps ? "cps" : "vi"))
 			return -EINVAL;
 		rc = audioreach_fullio_probe_endpoint(dai_data->graph[dai->id], cfg, cps);
+		start_cps_source = cps;
 	} else {
 		rc = q6apm_graph_media_format_pcm(dai_data->graph[dai->id], cfg);
 	}
@@ -320,6 +322,19 @@ static int q6apm_lpass_dai_prepare(struct snd_pcm_substream *substream, struct s
 		dev_err(dai->dev, "Failed to prepare Graph %d\n", rc);
 		goto err;
 	}
+	/* The diagnostic capture FE starts and queues reads in prepare,
+	 * ahead of BE trigger. Start the CPS source once, before those reads.
+	 * The existing trigger and shutdown share this started flag.
+	 */
+	if (start_cps_source) {
+		rc = q6apm_graph_start(dai_data->graph[dai->id]);
+		if (rc) {
+			dev_err(dai->dev, "FullIO CPS source-first start rejected: %d\n", rc);
+			goto err;
+		}
+		dai_data->is_port_started[dai->id] = true;
+		dev_info(dai->dev, "FullIO CPS source started before frontend reads\n");
+	}
 	return 0;
 err:
 	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
