ASoC: q6apm: sample the independent FullIO ring from PCM pointer

Hold the allocation with the open graph reference. Do not read an unrelated legacy DMA header for the independent ring.
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -516,8 +516,8 @@
 	/* Any failed SET_CFG may still have reached the DSP. Bind the lifetime
 	 * to the last graph reference before sending and even on failure.
 	 */
-	graph->ar_graph->fullio_ring = ring;
 	ring->config_bytes = config_bytes;
+	smp_store_release(&graph->ar_graph->fullio_ring, ring);
 	if (IS_ERR(pkt))
 		return PTR_ERR(pkt);
 	return q6apm_fullio_oob_rpc(graph->apm, direct ? graph->port : NULL, pkt, NULL, NULL);
@@ -595,6 +595,21 @@
 	return 0;
 }
 
+/* Nonblocking PCM accessor. The open PCM retains a graph reference, so
+ * the attached coherent allocation cannot be released during a sample.
+ */
+int q6apm_fullio_pcm_cursor(struct q6apm_graph *graph, u32 frame_bytes, u32 *offset)
+{
+	const struct q6apm_fullio_ring *ring;
+	u32 sequence;
+
+	ring = smp_load_acquire(&graph->ar_graph->fullio_ring);
+	if (!ring)
+		return -EAGAIN;
+	return q6apm_fullio_ring_cursor(ring, frame_bytes, &sequence, offset);
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_pcm_cursor);
+
 int q6apm_fullio_ring_position_audit(struct q6apm_graph *graph, bool started)
 {
 	struct q6apm_fullio_ring *ring = graph->ar_graph->fullio_ring;
