Subject: [EXPERIMENT] soundwire: qcom: record Denali clash before status dispatch

On an opted-in FullIO WSA controller capture the raw interrupt and slot
status before normal dispatch mutates cached status or acknowledges it.
No writes, retries, recovery, IRQ reordering, or actual fault injection.

--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -812,6 +812,20 @@
 	intr_sts_masked = intr_sts & ctrl->intr_mask;
 
 	do {
+		/* Capture raw slot state before lower numbered IRQ cases can
+		 * enumerate slaves, update cached status, or clear the IRQ.
+		 */
+		if ((intr_sts_masked & SWRM_INTERRUPT_STATUS_MASTER_CLASH_DET) &&
+		    (ctrl->fullio_link_gate || qcom_swrm_fullio_pm_audit(ctrl))) {
+			u32 slots = 0;
+			int rc = ctrl->reg_read(ctrl, SWRM_MCP_SLV_STATUS, &slots);
+
+			dev_warn_ratelimited(ctrl->dev,
+				"FullIO clash snapshot: irq=%#x unmasked=%#x slots=%#x rc=%d cached=%#x pm_active=%d pm_suspended=%d\n",
+				intr_sts, intr_sts_masked, slots, rc,
+				READ_ONCE(ctrl->slave_status), pm_runtime_active(ctrl->dev),
+				pm_runtime_suspended(ctrl->dev));
+		}
 		for (i = 0; i < SWRM_INTERRUPT_MAX; i++) {
