Subject: [EXPERIMENT] ASoC: lpass-wsa: port FullIO feedback DAIs

Adapt the VI and CPS LPASS endpoints from the Golden v32 overlay of
geocausa/SP11X1e-audio@3232e1dacdeb580a10a9cb8d4756a4518a7bd83e.
Do not change playback gains or the existing volume controls. The SoundWire
transport and readiness gate still need to be ported before enabling these DAIs.

diff --git a/sound/soc/codecs/lpass-wsa-macro.c b/sound/soc/codecs/lpass-wsa-macro.c
index 2b63954..52d0d02 100755
--- a/sound/soc/codecs/lpass-wsa-macro.c
+++ b/sound/soc/codecs/lpass-wsa-macro.c
@@ -373,6 +373,7 @@ enum {
 	WSA_MACRO_AIF_MIX1_PB,
 	WSA_MACRO_AIF_VI,
 	WSA_MACRO_AIF_ECHO,
+	WSA_MACRO_AIF_CPS,
 	WSA_MACRO_MAX_DAIS,
 };
 
@@ -1332,6 +1333,18 @@ static int wsa_macro_hw_params(struct snd_pcm_substream *substream,
 	struct wsa_macro *wsa = snd_soc_component_get_drvdata(component);
 	int ret;
 
+	if (dai->id == WSA_MACRO_AIF_VI) {
+		wsa->pcm_rate_vi = params_rate(params);
+		return 0;
+	}
+
+	/* CPS is already framed by the WSA8845 SoundWire DP6 source.  This
+	 * logical macro endpoint only carries it to WSA_CODEC_DMA_TX_1 and must
+	 * not reprogram the VI sensing rate/state machine.
+	 */
+	if (dai->id == WSA_MACRO_AIF_CPS)
+		return 0;
+
 	switch (substream->stream) {
 	case SNDRV_PCM_STREAM_PLAYBACK:
 		ret = wsa_macro_set_interpolator_rate(dai, params_rate(params));
@@ -1343,9 +1356,6 @@ static int wsa_macro_hw_params(struct snd_pcm_substream *substream,
 		}
 		break;
 	case SNDRV_PCM_STREAM_CAPTURE:
-		if (dai->id == WSA_MACRO_AIF_VI)
-			wsa->pcm_rate_vi = params_rate(params);
-
 		break;
 	default:
 		break;
@@ -1379,6 +1389,10 @@ static int wsa_macro_get_channel_map(const struct snd_soc_dai *dai,
 		*rx_slot = mask;
 		*rx_num = cnt;
 		break;
+	case WSA_MACRO_AIF_CPS:
+		*tx_num = 2;
+		*tx_slot = GENMASK(1, 0);
+		break;
 	case WSA_MACRO_AIF_ECHO:
 		val = snd_soc_component_read(component, CDC_WSA_RX_INP_MUX_RX_MIX_CFG0);
 		if (val & WSA_MACRO_EC_MIX_TX1_MASK) {
@@ -1436,6 +1450,19 @@ static struct snd_soc_dai_driver wsa_macro_dai[] = {
 	{
 		.name = "wsa_macro_vifeedback",
 		.id = WSA_MACRO_AIF_VI,
+		.playback = {
+			/*
+			 * Companion playback semantics make VI feedback start
+			 * atomically with the protected render graph.
+			 */
+			.stream_name = "WSA_AIF_VI Protection",
+			.rates = SNDRV_PCM_RATE_8000,
+			.formats = SNDRV_PCM_FMTBIT_S32_LE,
+			.rate_max = 8000,
+			.rate_min = 8000,
+			.channels_min = 1,
+			.channels_max = 4,
+		},
 		.capture = {
 			.stream_name = "WSA_AIF_VI Capture",
 			.rates = SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_48000,
@@ -1461,6 +1488,20 @@ static struct snd_soc_dai_driver wsa_macro_dai[] = {
 		},
 		.ops = &wsa_macro_dai_ops,
 	},
+	{
+		.name = "wsa_macro_cps",
+		.id = WSA_MACRO_AIF_CPS,
+		.playback = {
+			.stream_name = "WSA_AIF_CPS Protection",
+			.rates = SNDRV_PCM_RATE_24000,
+			.formats = SNDRV_PCM_FMTBIT_S32_LE,
+			.rate_max = 24000,
+			.rate_min = 24000,
+			.channels_min = 2,
+			.channels_max = 2,
+		},
+		.ops = &wsa_macro_dai_ops,
+	},
 };
 
 static void wsa_macro_mclk_enable(struct wsa_macro *wsa, bool mclk_enable)
@@ -2369,8 +2410,16 @@ static const struct snd_soc_dapm_widget wsa_macro_dapm_widgets[] = {
 			       SND_SOC_NOPM, WSA_MACRO_AIF_VI, 0,
 			       wsa_macro_enable_vi_feedback,
 			       SND_SOC_DAPM_POST_PMU | SND_SOC_DAPM_POST_PMD),
+	SND_SOC_DAPM_AIF_IN_E("WSA AIF_VI Protection",
+			      "WSA_AIF_VI Protection", 0,
+			      SND_SOC_NOPM, WSA_MACRO_AIF_VI, 0,
+			      wsa_macro_enable_vi_feedback,
+			      SND_SOC_DAPM_POST_PMU | SND_SOC_DAPM_POST_PMD),
 	SND_SOC_DAPM_AIF_OUT("WSA AIF_ECHO", "WSA_AIF_ECHO Capture", 0,
 			     SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_AIF_IN("WSA AIF_CPS Protection",
+			    "WSA_AIF_CPS Protection", 0,
+			    SND_SOC_NOPM, 0, 0),
 
 	SND_SOC_DAPM_MIXER("WSA_AIF_VI Mixer", SND_SOC_NOPM, WSA_MACRO_AIF_VI,
 			   0, aif_vi_mixer, ARRAY_SIZE(aif_vi_mixer)),
@@ -2433,6 +2482,7 @@ static const struct snd_soc_dapm_widget wsa_macro_dapm_widgets[] = {
 			     SND_SOC_DAPM_POST_PMD),
 
 	SND_SOC_DAPM_INPUT("VIINPUT_WSA"),
+	SND_SOC_DAPM_INPUT("CPSINPUT_WSA"),
 	SND_SOC_DAPM_OUTPUT("WSA_SPK1 OUT"),
 	SND_SOC_DAPM_OUTPUT("WSA_SPK2 OUT"),
 
@@ -2474,6 +2524,12 @@ static const struct snd_soc_dapm_route wsa_audio_map[] = {
 	{"WSA AIF_VI", NULL, "WSA_AIF_VI Mixer"},
 	{"WSA AIF_VI", NULL, "WSA_MCLK"},
 
+	/* CPS feedback is a distinct transport from VI; only the shared macro
+	 * clock is required here.  DP6 framing is programmed by SoundWire.
+	 */
+	{"WSA AIF_CPS Protection", NULL, "CPSINPUT_WSA"},
+	{"WSA AIF_CPS Protection", NULL, "WSA_MCLK"},
+
 	{"WSA RX_MIX EC0_MUX", "RX_MIX_TX0", "WSA_RX INT0 SEC MIX"},
 	{"WSA RX_MIX EC1_MUX", "RX_MIX_TX0", "WSA_RX INT0 SEC MIX"},
 	{"WSA RX_MIX EC0_MUX", "RX_MIX_TX1", "WSA_RX INT1 SEC MIX"},
