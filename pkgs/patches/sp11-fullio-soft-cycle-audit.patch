+static bool q6apm_fullio_soft_event(struct q6apm_graph *graph, const struct gpr_resp_pkt *data)
+{
+	const struct apm_module_event *event = data->payload;
+	u32 expected = READ_ONCE(graph->fullio_soft_event);
+
+	if (!expected || !event || data->payload_size != sizeof(*event) ||
+	    data->hdr.src_domain != GPR_DOMAIN_ID_ADSP || data->hdr.src_port != FULLIO_SOFT_PAUSE_IID ||
+	    data->hdr.dest_port != graph->port->id || event->event_payload_size ||
+	    event->event_id != expected)
+		return false;
+	if (cmpxchg(&graph->fullio_soft_event, expected, 0) != expected)
+		return false;
+	wake_up(&graph->cmd_wait);
+	return true;
+}
 
