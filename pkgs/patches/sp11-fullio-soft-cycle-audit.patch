+static int q6apm_fullio_soft_transition(struct q6apm_graph *graph, bool pause)
+{
+	struct apm_module_param_data *param;
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_cmd_pkt(APM_MODULE_PARAM_DATA_SIZE, APM_CMD_SET_CFG, 0,
+				       graph->port->id, FULLIO_SOFT_PAUSE_IID);
+	int ret;
+
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+	param = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	*param = (struct apm_module_param_data) {
+		.module_instance_id = FULLIO_SOFT_PAUSE_IID,
+		.param_id = pause ? 0x0800102e : 0x0800102f,
+	};
+	/* Events have no request token. Arm before send for event-before-ACK,
+	 * and never reuse the same event or retry an ambiguous transaction.
+	 */
+	WRITE_ONCE(graph->fullio_soft_event, pause ? FULLIO_SOFT_PAUSE_COMPLETE : FULLIO_SOFT_RESUME_COMPLETE);
+	ret = q6apm_fullio_oob_rpc(graph->apm, graph->port, pkt, NULL, NULL);
+	if (!ret && !wait_event_timeout(graph->cmd_wait, !READ_ONCE(graph->fullio_soft_event),
+				       msecs_to_jiffies(50)))
+		ret = -ETIMEDOUT;
+	WRITE_ONCE(graph->fullio_soft_event, 0);
+	if (ret)
+		return dev_err_probe(graph->dev, ret, "FullIO soft-%s unverified\n", pause ? "pause" : "resume");
+	dev_info(graph->dev, "FullIO soft-%s command and completion verified\n", pause ? "pause" : "resume");
+	return 0;
+}
+
+int q6apm_fullio_soft_cycle_audit(struct q6apm_graph *graph)
+{
+	const struct q6apm_fullio_ring *ring = graph->ar_graph->fullio_ring;
+	struct audioreach_module *pause;
+	int ret;
+
+	lockdep_assert_held(&graph->apm->graph_lock);
+	if (!ring || !ring->start_attempted || ring->stop_acked || graph->cb ||
+	    graph->fullio_soft_cycle_attempted || !q6apm_fullio_mute_is_verified(graph))
+		return -EPERM;
+	pause = q6apm_find_module_by_mid(graph, 0x07001019);
+	if (!pause || pause->instance_id != FULLIO_SOFT_PAUSE_IID)
+		return -EINVAL;
+	graph->fullio_soft_cycle_attempted = true;
+	ret = q6apm_fullio_soft_transition(graph, true);
+	return ret ?: q6apm_fullio_soft_transition(graph, false);
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_soft_cycle_audit);
