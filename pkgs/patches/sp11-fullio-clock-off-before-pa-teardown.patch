+	int clock_ret = 0;
 
 	if (dai->id != WSA884X_DAI_PLAYBACK)
 		return 0;
@@ -1977,7 +1988,15 @@ static int wsa884x_mute_stream(struct snd_soc_dai *dai, int mute, int stream)
 		if (wsa884x->feedback_enabled) {
 			atomic_inc_return(&wsa884x->fullio_pa_teardowns);
 			atomic64_inc_return(&wsa884x->fullio_pa_epoch);
+			if (component->card && of_machine_is_compatible("microsoft,denali") &&
+			    of_property_read_bool(component->card->dev->of_node,
+						  "microsoft,denali-fullio-post-pa-test"))
+				clock_ret = wsa_macro_fullio_clock_off_for_pa(component);
