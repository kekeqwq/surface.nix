 		snd_soc_component_write_field(component, WSA884X_DRE_CTL_1,
 					      WSA884X_DRE_CTL_1_CSR_GAIN_EN_MASK,
 					      0x0);
@@ -1995,7 +2014,7 @@ static int wsa884x_mute_stream(struct snd_soc_dai *dai, int mute, int stream)
 					      0x1);
 	}
 
-	return 0;
+	return clock_ret;
 }
 
