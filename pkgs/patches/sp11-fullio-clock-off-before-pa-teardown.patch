Subject: [EXPERIMENT] ASoC: request clock shutdown before the first FullIO PA teardown

Under the post-PA marker, revoke readiness and resolve the clock owner on
the emitting PA playback link. Even if shutdown is unverified, still mute
the amplifier. Default and muted fixtures do not enter this branch.

diff --git a/sound/soc/codecs/lpass-wsa-macro.c b/sound/soc/codecs/lpass-wsa-macro.c
index c5eecc1..8d15008 100755
--- a/sound/soc/codecs/lpass-wsa-macro.c
+++ b/sound/soc/codecs/lpass-wsa-macro.c
@@ -1697,6 +1697,45 @@ int wsa_macro_fullio_protclk(struct snd_soc_component *component, bool enable,
 }
 EXPORT_SYMBOL_GPL(wsa_macro_fullio_protclk);
 
+/* Called synchronously from playback mute, never from a SoundWire status
+ * notification. Resolve the clock owner from the emitter's own playback link.
+ */
+int wsa_macro_fullio_clock_off_for_pa(struct snd_soc_component *amp);
+int wsa_macro_fullio_clock_off_for_pa(struct snd_soc_component *amp)
+{
+	struct snd_soc_card *card = amp->card;
+	struct snd_soc_pcm_runtime *rtd, *target = NULL;
+	struct snd_soc_component *owner = NULL;
+	struct snd_soc_dai *codec;
+	unsigned int emitters = 0;
+	int i;
+
+	if (!wsa_macro_fullio_post_pa_probe(amp))
+		return -EOPNOTSUPP;
+	for_each_card_rtds(card, rtd) {
+		if (strcmp(rtd->dai_link->name, "WSA Playback"))
+			continue;
+		if (target)
+			return -EEXIST;
+		target = rtd;
+	}
+	if (!target)
+		return -ENODEV;
+	for_each_rtd_codec_dais(target, i, codec) {
+		if (codec->component == amp)
+			emitters++;
+		if (codec->component->driver != &wsa_macro_component_drv)
+			continue;
+		if (owner)
+			return -EEXIST;
+		owner = codec->component;
+	}
+	if (emitters != 1 || !owner || owner->card != card)
+		return -ENODEV;
+	return wsa_macro_fullio_protclk(owner, false, NULL, NULL);
+}
+EXPORT_SYMBOL_GPL(wsa_macro_fullio_clock_off_for_pa);
+
 static void wsa_macro_enable_disable_vi_feedback(struct snd_soc_component *component,
 						 bool enable, u32 rate)
 {
