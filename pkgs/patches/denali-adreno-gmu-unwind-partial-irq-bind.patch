drm/msm/a6xx: Unwind only acquired GMU IRQs on bind failure

Preserve platform_get_irq_byname() errors, including -EPROBE_DEFER,
and never pass them to request_irq(). Acquire the two IRQs in order
and release only those acquired before a later failure. Keep the GMU
MMIO mapping alive until the acquired handlers have been released.

--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -2133,6 +2133,8 @@ static int a6xx_gmu_get_irq(struct a6xx_gmu *gmu, struct platform_device *pdev,
 	int irq, ret;
 
 	irq = platform_get_irq_byname(pdev, name);
+	if (irq < 0)
+		return irq;
 
 	ret = request_irq(irq, handler, IRQF_TRIGGER_HIGH | IRQF_NO_AUTOEN, name, gmu);
 	if (ret) {
@@ -2462,16 +2464,20 @@
 	/* Get the HFI and GMU interrupts */
 	gmu->hfi_irq = a6xx_gmu_get_irq(gmu, pdev, "hfi", a6xx_hfi_irq);
-	gmu->gmu_irq = a6xx_gmu_get_irq(gmu, pdev, "gmu", a6xx_gmu_irq);
-
-	if (gmu->hfi_irq < 0 || gmu->gmu_irq < 0) {
-		ret = -ENODEV;
+	if (gmu->hfi_irq < 0) {
+		ret = gmu->hfi_irq;
 		goto err_mmio;
 	}
 
+	gmu->gmu_irq = a6xx_gmu_get_irq(gmu, pdev, "gmu", a6xx_gmu_irq);
+	if (gmu->gmu_irq < 0) {
+		ret = gmu->gmu_irq;
+		goto err_hfi_irq;
+	}
+
 	gmu->cxpd = dev_pm_domain_attach_by_name(gmu->dev, "cx");
 	if (IS_ERR(gmu->cxpd)) {
 		ret = PTR_ERR(gmu->cxpd);
-		goto err_mmio;
+		goto err_gmu_irq;
 	}
 
 	cx_link = device_link_add(gmu->dev, gmu->cxpd,
@@ -2550,10 +2555,12 @@
 detach_cxpd:
 	dev_pm_domain_detach(gmu->cxpd, false);
 
-err_mmio:
-	iounmap(gmu->mmio);
+err_gmu_irq:
 	free_irq(gmu->gmu_irq, gmu);
+err_hfi_irq:
 	free_irq(gmu->hfi_irq, gmu);
+err_mmio:
+	iounmap(gmu->mmio);
 
 err_memory:
 	a6xx_gmu_memory_free(gmu);
