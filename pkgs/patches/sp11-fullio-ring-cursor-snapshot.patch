ASoC: split FullIO ring cursor sampling from audit polling

Use a bounded non-sleeping cursor read for the firmware publication protocol.

Audit progress separately and accept sequence wrap, not regression.

--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -568,19 +568,44 @@
 }
 EXPORT_SYMBOL_GPL(q6apm_fullio_ring_map_audit);
 
+/* One non-sleeping sample. The firmware writes zero, then index and time,
+ * then the next sequence. Do not use a transient index to report PCM progress.
+ * The caller holds the backing alive; no pointer escapes this function.
+ */
+static int q6apm_fullio_ring_cursor(const struct q6apm_fullio_ring *ring,
+				    u32 frame_bytes, u32 *sequence, u32 *offset)
+{
+	const __le32 *pos = ring->cpu + ring->data.size;
+	u32 seq, bytes;
+
+	seq = le32_to_cpu(READ_ONCE(pos[0]));
+	if (!seq)
+		return -EAGAIN;
+	dma_rmb();
+	bytes = le32_to_cpu(READ_ONCE(pos[1]));
+	dma_rmb();
+	if (seq != le32_to_cpu(READ_ONCE(pos[0])))
+		return -EAGAIN;
+	if (!frame_bytes || bytes >= ring->config_bytes || bytes % frame_bytes)
+		return -ERANGE;
+	*sequence = seq;
+	*offset = bytes;
+	return 0;
+}
+
