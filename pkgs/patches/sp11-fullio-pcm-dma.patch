ASoC: q6apm: borrow the independent pull ring as ALSA sample backing

Expose a sample-only view of the confirmed graph-owned ring, never its position page. Do not allocate or map a second PCM buffer for this path.
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -390,6 +390,7 @@
 	dma_addr_t dma;
 	size_t bytes;
 	u32 config_bytes;
+	struct snd_dma_buffer pcm_buffer;
 	int sid;
 	bool start_attempted, stop_acked;
 	struct q6apm_fullio_oob_region data, pos;
@@ -512,6 +513,7 @@
 	struct gpr_pkt *pkt __free(kfree) =
 		audioreach_alloc_push_pull_pkt(graph, ring->data.dsp_addr, ring->pos.dsp_addr,
 					      ring->data.handle, ring->pos.handle, config_bytes, direct);
+	int ret;
 
 	/* Any failed SET_CFG may still have reached the DSP. Bind the lifetime
 	 * to the last graph reference before sending and even on failure.
@@ -520,7 +522,16 @@
 	smp_store_release(&graph->ar_graph->fullio_ring, ring);
 	if (IS_ERR(pkt))
 		return PTR_ERR(pkt);
-	return q6apm_fullio_oob_rpc(graph->apm, direct ? graph->port : NULL, pkt, NULL, NULL);
+	ret = q6apm_fullio_oob_rpc(graph->apm, direct ? graph->port : NULL, pkt, NULL, NULL);
+	if (ret)
+		return ret;
+
+	ring->pcm_buffer.dev.type = SNDRV_DMA_TYPE_DEV;
+	ring->pcm_buffer.dev.dev = ring->dev;
+	ring->pcm_buffer.area = ring->cpu;
+	ring->pcm_buffer.addr = ring->dma;
+	smp_store_release(&ring->pcm_buffer.bytes, config_bytes);
+	return 0;
 }
 
 /* Mapping-only or never-started attachment, selected by the fixture DT. */
@@ -595,6 +606,19 @@
 	return 0;
 }
 
+/* A borrowed sample-only view. ALSA never owns or frees the allocation;
+ * the FE must detach the view before dropping its graph reference.
+ */
+struct snd_dma_buffer *q6apm_fullio_pcm_buffer(struct q6apm_graph *graph, size_t bytes)
+{
+	struct q6apm_fullio_ring *ring = smp_load_acquire(&graph->ar_graph->fullio_ring);
+
+	if (!ring || !bytes || bytes != smp_load_acquire(&ring->pcm_buffer.bytes))
+		return NULL;
+	return &ring->pcm_buffer;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_pcm_buffer);
+
 /* Nonblocking PCM accessor. The open PCM retains a graph reference, so
  * the attached coherent allocation cannot be released during a sample.
  */
