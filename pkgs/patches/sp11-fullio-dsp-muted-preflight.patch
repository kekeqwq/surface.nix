+/* Only the two known Denali WSA codecs on the playback link count. */
+#if IS_REACHABLE(CONFIG_SND_SOC_WSA884X)
+int wsa884x_fullio_pa_off(struct snd_soc_component *component);
+#else
+static int wsa884x_fullio_pa_off(struct snd_soc_component *component)
+{
+	return -EOPNOTSUPP;
+}
+#endif
+
+static int q6apm_fullio_both_pa_off(void *ctx)
+{
+	struct snd_soc_card *card = ctx;
+	struct snd_soc_pcm_runtime *rtd;
+	struct snd_soc_dai *codec;
+	unsigned int seen = 0, bit;
+	int i, ret;
+
+	for_each_card_rtds(card, rtd) {
+		if (strcmp(rtd->dai_link->name, "WSA Playback"))
+			continue;
+		for_each_rtd_codec_dais(rtd, i, codec) {
+			const char *prefix = codec->component->name_prefix;
+
+			if (!prefix)
+				continue;
+			if (!strcmp(prefix, "SpkrLeft"))
+				bit = BIT(0);
+			else if (!strcmp(prefix, "SpkrRight"))
+				bit = BIT(1);
+			else
+				continue;
+			if (seen & bit)
+				return -EEXIST;
+			ret = wsa884x_fullio_pa_off(codec->component);
+			if (ret)
+				return ret;
+			seen |= bit;
+		}
+	}
+	return seen == (BIT(0) | BIT(1)) ? 0 : -ENODEV;
+}
+
 static int q6apm_fullio_prepare_cal(struct q6apm_dai_data *pdata,
-				   struct q6apm_dai_rtd *prtd)
