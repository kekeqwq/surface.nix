Subject: [EXPERIMENT] ASoC: WSA884x: declare Denali FullIO SIMPLE render fields

Mirror Golden patches 0065/0067 on the Denali FullIO codec instances:
DAC BlockCtrl3, COMP and BOOST OffsetCtrl2. Values come from the
existing SoundWire schedule. Keep the global table unchanged and
do not perform register writes in this property initialization.

--- a/sound/soc/codecs/wsa884x.c
+++ b/sound/soc/codecs/wsa884x.c
@@ -2539,6 +2539,26 @@
 
 	pm_runtime_disable(dev);
 	pm_runtime_dont_use_autosuspend(dev);
+}
+
+static int wsa884x_fullio_init_sink_fields(struct wsa884x_priv *amp)
+{
+	struct sdw_dpn_prop *ports;
+
+	amp->slave->prop.sink_dpn_prop = wsa884x_sink_dpn_prop;
+	if (!amp->feedback_enabled || !of_machine_is_compatible("microsoft,denali"))
+		return 0;
+
+	/* The board schedule supplies the actual values, not an init table. */
+	ports = devm_kmemdup(amp->dev, wsa884x_sink_dpn_prop,
+			    sizeof(wsa884x_sink_dpn_prop), GFP_KERNEL);
+	if (!ports)
+		return -ENOMEM;
+	ports[WSA884X_PORT_DAC].simple_transport_registers |= SDW_DPN_SIMPLE_TRANSPORT_BLOCKCTRL3;
+	ports[WSA884X_PORT_COMP].simple_transport_registers |= SDW_DPN_SIMPLE_TRANSPORT_OFFSETCTRL2;
+	ports[WSA884X_PORT_BOOST].simple_transport_registers |= SDW_DPN_SIMPLE_TRANSPORT_OFFSETCTRL2;
+	amp->slave->prop.sink_dpn_prop = ports;
+	return 0;
 }
 
 static int wsa884x_probe(struct sdw_slave *pdev,
@@ -2618,7 +2638,9 @@
 		pdev->prop.src_dpn_prop = wsa884x->feedback_ports;
 	}
 	pdev->prop.simple_clk_stop_capable = true;
-	pdev->prop.sink_dpn_prop = wsa884x_sink_dpn_prop;
+	ret = wsa884x_fullio_init_sink_fields(wsa884x);
+	if (ret)
+		return ret;
 	pdev->prop.scp_int1_mask = SDW_SCP_INT1_BUS_CLASH | SDW_SCP_INT1_PARITY;
 
 	wsa884x_reset_deassert(wsa884x);
