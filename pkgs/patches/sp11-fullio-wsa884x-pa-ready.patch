+
+/* The pinned reference observed 0x2f with a working channel and 0x2a
+ * with an enabled but silent channel. This is a diagnostic allowlist,
+ * not a documented FSM enumeration or evidence of working protection.
+ */
+static int wsa884x_fullio_check_ready(const struct wsa884x_fullio_pa_snapshot *snapshot)
+{
+	if (snapshot->sta1 || snapshot->err0 || snapshot->err1)
+		return -EIO;
+	if (!(snapshot->enable & WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK) || snapshot->sta0 != 0x2f)
+		return -EAGAIN;
+	return 0;
+}
+
+int wsa884x_fullio_pa_ready(struct snd_soc_component *component, s64 *epoch);
+int wsa884x_fullio_pa_ready(struct snd_soc_component *component, s64 *epoch)
+{
+	struct wsa884x_fullio_pa_snapshot snapshot;
+	int ret = wsa884x_fullio_read_pa(component, true, &snapshot);
+
+	if (!ret)
+		ret = wsa884x_fullio_check_ready(&snapshot);
+	if (!ret)
+		*epoch = snapshot.epoch;
+	return ret;
+}
+EXPORT_SYMBOL_GPL(wsa884x_fullio_pa_ready);
 
