+int q6apm_capture_retire(struct q6apm_graph *graph)
+{
+	struct audioreach_graph *ar = graph->ar_graph;
+	int ret = -EIO;
+
+	mutex_lock(&graph->lock);
+	if (graph->capture_draining) {
+		mutex_unlock(&graph->lock);
+		return -EIO;
+	}
+	graph->capture_draining = true;
+	mutex_unlock(&graph->lock);
+
+	/* A shared/no-op STOP cannot prove this ring was drained. Never wait
+	 * for the token-scoped response with the callback mutex held.
+	 */
+	q6apm_fullio_mute_invalidate(graph);
+	if (READ_ONCE(ar->start_count) == 1) {
+		WRITE_ONCE(ar->start_count, 0);
+		ret = audioreach_graph_mgmt_transaction(ar, APM_CMD_GRAPH_STOP, true);
+	}
+
+	guard(mutex)(&graph->lock);
+	if (ret || graph->capture_send_seq != graph->capture_done_seq)
+		graph->capture_fault = true;
+	return ret ?: (graph->capture_fault ? -EIO : 0);
+}
+EXPORT_SYMBOL_GPL(q6apm_capture_retire);
 
