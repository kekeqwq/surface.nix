+static u32 q6apm_capture_done(struct q6apm_graph *graph, u32 token,
+			     const struct data_cmd_rsp_rd_sh_mem_ep_data_buffer_done_v2 *done)
+{
+	struct audioreach_graph_data *port = &graph->tx_data;
+	struct audio_buffer *buf;
+	u32 slot;
+
+	guard(mutex)(&graph->lock);
+	slot = graph->capture_done_slot;
+	if (graph->capture_fault && !graph->capture_draining)
+		return 0;
+	if (!done || !port->buf || slot >= port->num_periods ||
+	    graph->capture_done_seq == graph->capture_send_seq || token != graph->capture_done_seq)
+		goto fault;
+
+	buf = &port->buf[slot];
+	if (done->mem_map_handle != graph->info->mem_map_handle ||
+	    done->buf_addr_lsw != lower_32_bits(buf->phys) ||
+	    done->buf_addr_msw != upper_32_bits(buf->phys))
+		goto fault;
+
+	graph->capture_done_seq++;
+	graph->capture_done_slot = (slot + 1) % port->num_periods;
+	if (graph->capture_draining)
+		return 0;
+
+	if (done->status)
+		goto fault;
+	if (!done->data_size) {
+		if (graph->capture_full || graph->capture_empty++ >= port->num_periods)
+			goto fault;
+		return APM_CLIENT_EVENT_CAPTURE_RECLAIM;
+	}
+	if (done->data_size != buf->size || (!graph->capture_full && slot))
+		goto fault;
+
+	graph->capture_full = true;
+	atomic_set(&port->hw_ptr, slot + 1);
+	return APM_CLIENT_EVENT_DATA_READ_DONE;
+
+fault:
+	graph->capture_fault = true;
+	return graph->capture_draining ? 0 : APM_CLIENT_EVENT_CAPTURE_FAULT;
+}
