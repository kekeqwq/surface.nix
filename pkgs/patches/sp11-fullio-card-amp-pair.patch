 	const char *link = "WSA Playback";
-	unsigned int seen = 0, bit;
-	int i, ret, probe_rate = q6apm_feedback_probe_rate(card);
+	int ret, probe_rate = q6apm_feedback_probe_rate(card);
 
 	if (probe_rate < 0)
