Subject: [EXPERIMENT] ASoC: q6apm: give the silent feedback fixture native capture formats

Only a separate Denali muted probe card can use native VI/CPS S32 stereo.
Reject render before opening a DSP graph. The stock and calibrated-muted
cards retain their old PCM capabilities. No test DT enables the probe yet.

diff --git a/sound/soc/qcom/qdsp6/q6apm-dai.c b/sound/soc/qcom/qdsp6/q6apm-dai.c
index 533ee51..4cb69ff 100644
--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -639,6 +639,25 @@ static int q6apm_dai_trigger(struct snd_soc_component *component,
 	return ret;
 }
 
+static int q6apm_feedback_probe_rate(struct snd_soc_card *card)
+{
+	struct device_node *node = card->dev->of_node;
+	const char *probe;
+	const char *property = "microsoft,denali-fullio-feedback-probe";
+
+	if (!of_property_present(node, property))
+		return 0;
+	if (!of_machine_is_compatible("microsoft,denali") ||
+	    !of_property_read_bool(node, "microsoft,denali-fullio-muted-test") ||
+	    of_property_read_string(node, property, &probe))
+		return -EINVAL;
+	if (!strcmp(probe, "vi"))
+		return 8000;
+	if (!strcmp(probe, "cps"))
+		return 24000;
+	return -EINVAL;
+}
+
 static int q6apm_dai_open(struct snd_soc_component *component,
 			  struct snd_pcm_substream *substream)
 {
@@ -648,9 +667,14 @@ static int q6apm_dai_open(struct snd_soc_component *component,
 	struct device *dev = component->dev;
 	struct q6apm_dai_data *pdata;
 	struct q6apm_dai_rtd *prtd;
-	int graph_id, ret;
+	int graph_id, probe_rate, ret;
 
 	graph_id = cpu_dai->driver->id;
+	probe_rate = q6apm_feedback_probe_rate(component->card);
+	if (probe_rate < 0)
+		return probe_rate;
+	if (probe_rate && (substream->stream != SNDRV_PCM_STREAM_CAPTURE || graph_id != 2))
+		return -EOPNOTSUPP;
 
 	pdata = snd_soc_component_get_drvdata(component);
 	if (!pdata) {
@@ -675,6 +699,12 @@ static int q6apm_dai_open(struct snd_soc_component *component,
 		runtime->hw = q6apm_dai_hardware_playback;
 	else if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
 		runtime->hw = q6apm_dai_hardware_capture;
+	if (probe_rate) {
+		runtime->hw.formats = SNDRV_PCM_FMTBIT_S32_LE;
+		runtime->hw.rates = probe_rate == 8000 ? SNDRV_PCM_RATE_8000 : SNDRV_PCM_RATE_24000;
+		runtime->hw.rate_min = runtime->hw.rate_max = probe_rate;
+		runtime->hw.channels_min = runtime->hw.channels_max = 2;
+	}
 
 	/* Ensure that buffer size is a multiple of period size */
 	ret = snd_pcm_hw_constraint_integer(runtime, SNDRV_PCM_HW_PARAM_PERIODS);
@@ -810,6 +840,15 @@ static int q6apm_dai_hw_params(struct snd_soc_component *component,
 	case SNDRV_PCM_FORMAT_S24_LE:
 		prtd->bits_per_sample = 24;
 		break;
+	case SNDRV_PCM_FORMAT_S32_LE: {
+		int rate = q6apm_feedback_probe_rate(component->card);
+
+		if (rate <= 0 || params_rate(params) != rate || params_channels(params) != 2 ||
+		    substream->stream != SNDRV_PCM_STREAM_CAPTURE)
+			return -EINVAL;
+		prtd->bits_per_sample = 32;
+		break;
+	}
 	default:
 		return -EINVAL;
 	}
