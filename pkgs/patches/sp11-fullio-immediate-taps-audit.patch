Subject: [EXPERIMENT] ASoC: measure immediate VI/CPS taps with PAs off

Only the protected graph feedback loggers receive the fixed diagnostic
configuration. Keep RX ring zero, clocks off and PA unmute prohibited.
The APM lifetime still allows one bounded START/STOP observation.

diff --git a/sound/soc/qcom/qdsp6/q6apm-dai.c b/sound/soc/qcom/qdsp6/q6apm-dai.c
index 349d9cd..36b8326 100644
--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -4,6 +4,7 @@
 #include <dt-bindings/firmware/qcom,scm.h>
 #include <dt-bindings/soc/qcom,gpr.h>
 #include <dt-bindings/sound/qcom,q6afe.h>
+#include <linux/delay.h>
 #include <linux/dma-mapping.h>
 #include <linux/err.h>
 #include <linux/firmware/qcom/qcom_scm.h>
@@ -576,6 +577,34 @@ static bool q6apm_fullio_silent_ring_valid(struct q6apm_fullio_start_audit *audi
 	       s->dma_buffer.area && audit->ring_bytes && audit->ring_bytes <= s->dma_buffer.bytes;
 }
 
+static int q6apm_fullio_audit_configure_taps(struct q6apm_graph *graph)
+{
+	/* AudioReach data_logging_api.h: mode 1 is immediate logging;
+	 * 0x08001313 with value 1 allows the logger to exit island.
+	 * Never retarget the render or microphone loggers.
+	 */
+	static const u32 iid[] = {0x4025, 0x402a};
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(iid); i++) {
+		__le32 config[8] = {
+			cpu_to_le32(iid[i]), cpu_to_le32(0x08001031), cpu_to_le32(12), 0,
+			cpu_to_le32(0x1586), cpu_to_le32(i + 2), cpu_to_le32(1), 0,
+		};
+		__le32 island[6] = {
+			cpu_to_le32(iid[i]), cpu_to_le32(0x08001313), cpu_to_le32(4), 0,
+			cpu_to_le32(1), 0,
+		};
+		int ret = q6apm_fullio_set_cfg_inband(graph, config, sizeof(config));
+
+		if (!ret)
+			ret = q6apm_fullio_set_cfg_inband(graph, island, sizeof(island));
+		if (ret)
+			return dev_err_probe(graph->dev, ret, "FullIO immediate tap %u rejected\n", i + 2);
+	}
+	dev_info(graph->dev, "FullIO immediate VI/CPS taps configured\n");
+	return 0;
+}
+
 static int q6apm_fullio_verify_silent_audit(void *arg, bool started)
 {
 	struct q6apm_fullio_start_audit *audit = arg;
@@ -584,6 +613,9 @@ static int q6apm_fullio_verify_silent_audit(void *arg, bool started)
 	if (ret)
 		return ret;
 	if (started) {
+		if (of_property_read_bool(audit->card->dev->of_node,
+					  "microsoft,denali-fullio-immediate-taps-audit"))
+			msleep(150); /* PA-off, clocks-off observation only. */
 		ret = audioreach_fullio_verify_mute(audit->graph);
 		if (ret)
 			return ret;
@@ -603,6 +635,13 @@ static int q6apm_fullio_verify_silent_audit(void *arg, bool started)
 		 */
 		memset(audit->substream->dma_buffer.area, 0, audit->ring_bytes);
 		dma_wmb();
+		if (of_property_read_bool(audit->card->dev->of_node,
+					  "microsoft,denali-fullio-immediate-taps-audit")) {
+			ret = q6apm_fullio_audit_configure_taps(audit->graph);
+			if (!ret)
+				ret = q6apm_fullio_both_pa_off(audit->card);
+			return ret ?: wsa_macro_fullio_clock_off_for_feedback(audit->card);
+		}
 	} else if (memchr_inv(audit->substream->dma_buffer.area, 0, audit->ring_bytes)) {
 		return -EILSEQ;
 	}
