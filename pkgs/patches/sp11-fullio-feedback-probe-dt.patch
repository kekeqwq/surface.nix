Subject: [EXPERIMENT] arm64: dts: add capture-only Denali VI and CPS fixtures

Reuse the normal OLED board and preserve its display/input configuration.
Remove the WSA playback link and other capture links for these diagnostics.

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 1931087..f05abc6 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -547,6 +547,8 @@ x1e80100-medion-sprchrgd-14-s1-el2-dtbs	:= x1e80100-medion-sprchrgd-14-s1.dtb x1
 dtb-$(CONFIG_ARCH_QCOM)	+= x1e80100-medion-sprchrgd-14-s1.dtb x1e80100-medion-sprchrgd-14-s1-el2.dtb
 x1e80100-microsoft-denali-oled-el2-dtbs	:= x1e80100-microsoft-denali-oled.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1e80100-microsoft-denali-oled.dtb x1e80100-microsoft-denali-oled-el2.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= x1e80100-microsoft-denali-oled-feedback-vi.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= x1e80100-microsoft-denali-oled-feedback-cps.dtb
 x1e80100-microsoft-romulus13-el2-dtbs	:= x1e80100-microsoft-romulus13.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1e80100-microsoft-romulus13.dtb x1e80100-microsoft-romulus13-el2.dtb
 x1e80100-microsoft-romulus15-el2-dtbs	:= x1e80100-microsoft-romulus15.dtb x1-el2.dtbo
diff --git a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-denali-oled-feedback-cps.dts b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-denali-oled-feedback-cps.dts
new file mode 100644
index 0000000..9be3963
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-denali-oled-feedback-cps.dts
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "x1e80100-microsoft-denali-oled.dts"
+
+&{/sound} {
+	model = "Denali-FullIO-CPS-Probe";
+	microsoft,denali-fullio-feedback-probe = "cps";
+
+	/delete-node/ displayport-0-dai-link;
+	/delete-node/ displayport-1-dai-link;
+	/delete-node/ wsa-dai-link;
+	/delete-node/ va-dai-link;
+	/delete-node/ tx-dmic-dai-link;
+	/delete-node/ wsa-vi-dai-link;
+};
+
+&swr0 {
+	qcom,denali-fullio-feedback-capture-test;
+};
diff --git a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-denali-oled-feedback-vi.dts b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-denali-oled-feedback-vi.dts
new file mode 100644
index 0000000..6ef75c7
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-denali-oled-feedback-vi.dts
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "x1e80100-microsoft-denali-oled.dts"
+
+&{/sound} {
+	model = "Denali-FullIO-VI-Probe";
+	microsoft,denali-fullio-feedback-probe = "vi";
+
+	/delete-node/ displayport-0-dai-link;
+	/delete-node/ displayport-1-dai-link;
+	/delete-node/ wsa-dai-link;
+	/delete-node/ va-dai-link;
+	/delete-node/ tx-dmic-dai-link;
+	/delete-node/ wsa-cps-dai-link;
+};
+
+&swr0 {
+	qcom,denali-fullio-feedback-capture-test;
+};
