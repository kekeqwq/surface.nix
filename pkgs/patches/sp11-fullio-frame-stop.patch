Wait for frame-generator stop before gating a scoped Denali SoundWire iface.

--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -1016,7 +1016,32 @@
 	clk_disable_unprepare(ctrl->hclk);
 	return ret;
 }
+
+static int swrm_fullio_wait_for_frame_stop(struct qcom_swrm_ctrl *ctrl)
+{
+	const int max_reads = 30;
+	u32 status;
+	int i, ret;
 
+	/* ClockStopNow's command ACK does not describe controller frame state.
+	 * Keep iface enabled until the frame generator is observed stopped.
+	 */
+	for (i = 0; i < max_reads; i++) {
+		ret = ctrl->reg_read(ctrl, SWRM_COMP_STATUS, &status);
+		if (ret != SDW_CMD_OK)
+			return ret < 0 ? ret : -EIO;
+		if (!(status & SWRM_FRM_GEN_ENABLED)) {
+			dev_info_ratelimited(ctrl->dev,
+					     "FullIO frame generator stopped before iface gate: reads=%d status=%#x\n",
+					     i + 1, status);
+			return 0;
+		}
+		if (i + 1 < max_reads)
+			usleep_range(1000, 1100);
+	}
+	return -ETIMEDOUT;
+}
+
 static bool swrm_wait_for_frame_gen_enabled(struct qcom_swrm_ctrl *ctrl)
 {
 	int retry = SWRM_LINK_STATUS_RETRY_CNT;
@@ -2382,6 +2407,16 @@
 			dev_err(dev, "bus clock stop failed %d", ret);
 			return ret;
 		}
+		/* An empty bus (-ENODATA) did not send ClockStopNow. */
+		if (!ret && ctrl->fullio_link_gate &&
+		    of_property_read_bool(dev->of_node, "qcom,denali-fullio-wait-frame-stop")) {
+			ret = swrm_fullio_wait_for_frame_stop(ctrl);
+			if (ret) {
+				qcom_swrm_fullio_latch_link_error(ctrl, ret);
+				dev_err(dev, "FullIO frame stop unverified; iface kept on: %d\n", ret);
+				return ret;
+			}
+		}
 	}
 
 	disable_irq(ctrl->irq);
