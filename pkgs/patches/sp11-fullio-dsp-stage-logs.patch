Subject: [EXPERIMENT] ASoC: distinguish FullIO media, mapping and stage errors

Run media before the calibration map, publish stage and raw DSP status on
failure. Do not allow a rejected bootstrap to proceed or free uncertain DMA.

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index 3e96769..97b7e70 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -353,7 +353,9 @@ int audioreach_fullio_calibrate(struct q6apm_graph *graph,
 			break;
 		}
 		if (ret)
-			return ret;
+			return dev_err_probe(graph->dev, ret,
+					     "FullIO calibration step %d (stage %d, op %d) failed\n",
+					     i + 1, steps[i].stage, steps[i].op);
 	}
 	return assert_pa_off(ctx);
 }
diff --git a/sound/soc/qcom/qdsp6/q6apm-dai.c b/sound/soc/qcom/qdsp6/q6apm-dai.c
index 5db1f66..533ee51 100644
--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -458,9 +458,13 @@ static int q6apm_fullio_prepare_cal(struct q6apm_dai_data *pdata,
 	if (pdata->sid >= 0)
 		buf->region.dsp_addr |= (u64)pdata->sid << 32;
 	prtd->fullio_cal = buf;
-	ret = q6apm_fullio_oob_map(apm, &buf->region);
-	if (!ret)
-		ret = audioreach_fullio_media_prelude(prtd->graph, cfg);
+	ret = audioreach_fullio_media_prelude(prtd->graph, cfg);
+	if (!ret) {
+		dev_info(dev, "FullIO PCM_CNV and MFC media accepted\n");
+		ret = q6apm_fullio_oob_map(apm, &buf->region);
+		if (ret)
+			dev_err(dev, "FullIO calibration DMA map failed: %d\n", ret);
+	}
 	if (!ret)
 		ret = audioreach_fullio_calibrate(prtd->graph, &stages, &buf->region,
 						 buf->cpu, q6apm_fullio_both_pa_off, card);
diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 5f315ec..160c87b 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -132,6 +132,10 @@ static bool q6apm_fullio_oob_reply(struct q6apm *apm, const struct gpr_resp_pkt
 		if (!basic->status && (apm->fullio_oob_op == APM_CMD_SHARED_MEM_MAP_REGIONS ||
 				       apm->fullio_oob_op == APM_CMD_GET_CFG))
 			goto out; /* Wait for the handle or readback, not just BASIC success. */
+		if (basic->status)
+			dev_err_ratelimited(&apm->gdev->dev,
+					    "FullIO command %#x rejected, DSP status %#x\n",
+					    basic->opcode, basic->status);
 		status = basic->status ? -EIO : 0;
 	}
 
