+static int q6apm_lpass_check_integrated(struct snd_soc_dai *dai)
+{
+	int owner, ret;
+
+	ret = q6apm_find_integrated_backend(dai->dev, dai->id, &owner);
+	if (ret == -ENOENT)
+		return 0;
+	if (ret)
