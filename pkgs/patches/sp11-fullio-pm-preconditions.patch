Subject: [EXPERIMENT] soundwire: qcom: honor FullIO clock-stop preconditions

A failed interface clock enable must not arm the controller IRQ or
permit MMIO. Never enter clock stop with a write FIFO that failed to
drain. Scope the policy to the explicit FullIO link gate. This does
not claim either known discarded result caused the observed clash.

--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -2143,12 +2143,21 @@
 	struct qcom_swrm_ctrl *ctrl = dev_get_drvdata(dev);
 	int ret;
 
+	/* On FullIO preserve the suspended IRQ state if iface cannot start. */
+	if (ctrl->fullio_link_gate) {
+		ret = clk_prepare_enable(ctrl->hclk);
+		if (ret) {
+			qcom_swrm_fullio_latch_link_error(ctrl, ret);
+			return ret;
+		}
+	}
 	if (ctrl->wake_irq > 0) {
 		if (!irqd_irq_disabled(irq_get_irq_data(ctrl->wake_irq)))
 			disable_irq_nosync(ctrl->wake_irq);
 	}
 
-	clk_prepare_enable(ctrl->hclk);
+	if (!ctrl->fullio_link_gate)
+		clk_prepare_enable(ctrl->hclk);
 	enable_irq(ctrl->irq);
 
 	if (ctrl->clock_stop_not_supported) {
@@ -2219,7 +2228,11 @@
 	struct qcom_swrm_ctrl *ctrl = dev_get_drvdata(dev);
 	int ret;
 
-	swrm_wait_for_wr_fifo_done(ctrl);
+	if (!swrm_wait_for_wr_fifo_done(ctrl) && ctrl->fullio_link_gate) {
+		/* Keep the IRQ/clock ownership unchanged, and do not retry here. */
+		qcom_swrm_fullio_latch_link_error(ctrl, -ETIMEDOUT);
+		return -ETIMEDOUT;
+	}
 	if (!ctrl->clock_stop_not_supported) {
 		/* Mask bus clash interrupt */
 		ctrl->intr_mask &= ~SWRM_INTERRUPT_STATUS_MASTER_CLASH_DET;
