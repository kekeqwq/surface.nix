Subject: [PATCH] drm/msm/dp: refresh eDP stream depth after link training

On Denali OLED the first pre-enable can select 18 bpp before the eDP
sink link caps are read. Four HBR3 lanes are then trained successfully,
but the stream retains the already reduced depth until the next modeset.

Recompute the RGB stream depth from the EDID and the negotiated eDP
link before programming the video stream. Keep the existing depth
selection for external DP, YCbCr and compliance patterns. Do not force
30 bpp or bypass bandwidth limits when training downshifts.

--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -629,6 +629,28 @@
 	return 0;
 }
 
+static void msm_dp_display_update_edp_bpp(struct msm_dp_display_private *dp)
+{
+	struct msm_dp_panel *panel = dp->panel;
+	u32 clock = panel->msm_dp_mode.drm_mode.clock;
+	u32 bpp, payload;
+
+	if (!clock || panel->video_test || panel->msm_dp_mode.out_fmt_is_yuv_420 ||
+	    (dp->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN))
+		return;
+
+	bpp = panel->connector->display_info.bpc * 3 ?: 24;
+	bpp = msm_dp_panel_get_mode_bpp(panel, bpp, clock);
+
+	/* Link training can reduce the lane count or rate below the sink caps. */
+	payload = dp->link->link_params.num_lanes * dp->link->link_params.rate * 8;
+	while (bpp > 18 && bpp * clock > payload)
+		bpp -= 6;
+
+	if (bpp >= 18 && bpp * clock <= payload)
+		panel->msm_dp_mode.bpp = bpp;
+}
+
 static int msm_dp_display_prepare_link(struct msm_dp_display_private *dp)
 {
 	struct msm_dp *msm_dp_display = &dp->msm_dp_display;
@@ -661,7 +683,11 @@
 		return rc;
 	}
 
-	return msm_dp_ctrl_prepare_stream_on(dp->ctrl, dp->panel, force_link_train);
+	rc = msm_dp_ctrl_prepare_stream_on(dp->ctrl, dp->panel, force_link_train);
+	if (!rc && msm_dp_display->is_edp)
+		msm_dp_display_update_edp_bpp(dp);
+
+	return rc;
 }
 
 static int msm_dp_display_enable(struct msm_dp_display_private *dp,
