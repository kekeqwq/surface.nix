+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -1361,6 +1361,12 @@ int q6apm_fullio_audit_start_stop(struct q6apm_graph *graph, struct snd_soc_card *card,
 		ret = verify(ctx, true);
 		if (!ret && !q6apm_fullio_mute_is_verified(graph))
