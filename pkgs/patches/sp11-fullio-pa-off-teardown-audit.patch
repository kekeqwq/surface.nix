+static int q6apm_fullio_stop_pair_audit(struct snd_soc_card *card)
+{
+	struct q6apm_fullio_amp_pair pair = {};
+	int left, right;
+
+	left = q6apm_fullio_amp_pair(card, "WSA Playback", &pair);
+	if (left)
+		return left;
+	left = wsa884x_fullio_stop_audit(pair.left);
+	right = wsa884x_fullio_stop_audit(pair.right);
+	if (left || right)
+		dev_err(card->dev, "FullIO PA-off teardown failed: left=%d right=%d\n", left, right);
+	return left ?: right;
+}
