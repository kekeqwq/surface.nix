ASoC: scope Denali FullIO watermarks and retire PCM callbacks before CLOSE

Treat watermarks as wakeups, never as cursor values. Leave generic PCM event decoding unchanged.
Drain the per-stream port before releasing the referenced graph; CLOSE uses the shared APM service port.
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -26,6 +26,7 @@
 #include "q6apm.h"
 
 #define FULLIO_SOFT_PAUSE_IID		0x466b
+#define FULLIO_PULL_PERIOD_BYTES	1920U
 #define FULLIO_SOFT_PAUSE_COMPLETE	0x0800103f
 #define FULLIO_SOFT_RESUME_COMPLETE	0x08001043
 
@@ -1381,6 +1382,26 @@
 	return true;
 }
 
+/* In FullIO, only the registered pull module and its two configured levels
+ * can wake the PCM consumer. The body is one little-endian u32, not a cursor.
+ */
+static bool q6apm_fullio_pull_watermark(const struct q6apm_graph *graph,
+					 const struct gpr_resp_pkt *data)
+{
+	const struct apm_module_event *event = data->payload;
+	u32 level;
+
+	if (!event || data->payload_size < (int)(sizeof(*event) + sizeof(__le32)) ||
+	    data->hdr.src_domain != GPR_DOMAIN_ID_ADSP || graph->shm_iid != 0x4660 ||
+	    data->hdr.src_port != graph->shm_iid || data->hdr.dest_port != graph->port->id ||
+	    event->event_id != EVENT_ID_SH_MEM_PULL_PUSH_MODE_WATERMARK ||
+	    event->event_payload_size != sizeof(__le32))
+		return false;
+
+	level = get_unaligned_le32(event + 1);
+	return level == FULLIO_PULL_PERIOD_BYTES || level == 2 * FULLIO_PULL_PERIOD_BYTES;
+}
+
 static int graph_callback(const struct gpr_resp_pkt *data, void *priv, int op)
 {
 	struct data_cmd_rsp_rd_sh_mem_ep_data_buffer_done_v2 *rd_done;
@@ -1417,6 +1438,9 @@
 			return -EINVAL;
 		switch (event->event_id) {
 		case EVENT_ID_SH_MEM_PULL_PUSH_MODE_WATERMARK:
+			if (audioreach_fullio_graph(graph->info) &&
+			    !q6apm_fullio_pull_watermark(graph, data))
+				break;
 			client_event = APM_CLIENT_EVENT_WATERMARK_EVENT;
 			graph->cb(client_event, hdr->token, data->payload, graph->priv);
 			break;
@@ -1538,7 +1562,7 @@
 	int ret;
 
 	if (!audioreach_fullio_graph(graph->info) || graph->shm_iid != 0x4660 ||
-	    !ring || period_bytes != 1920 || ring->config_bytes != 2 * period_bytes)
+	    !ring || period_bytes != FULLIO_PULL_PERIOD_BYTES || ring->config_bytes != 2 * period_bytes)
 		return -EINVAL;
 	pause = q6apm_find_module_by_mid(graph, 0x07001019);
 	if (!pause || pause->instance_id != FULLIO_SOFT_PAUSE_IID)
@@ -1773,9 +1797,12 @@
 	struct audioreach_graph *ar_graph = graph->ar_graph;
 
 	q6apm_fullio_mute_invalidate(graph);
+	/* CLOSE and ring release use the APM service port. First retire this
+	 * PCM port and drain its callbacks while their graph state still lives.
+	 */
+	gpr_free_port(graph->port);
 	graph->ar_graph = NULL;
 	q6apm_release_audioreach_graph(ar_graph);
-	gpr_free_port(graph->port);
 	kfree(graph);
 
 	return 0;
