drm/msm: Keep the scheduler parked on terminal suspend failure

Normal system suspend can recover from an error by restarting the
scheduler. Terminal teardown must not submit new work after failure.
Also prevent the Adreno unbind callback from retrying suspend if the
DRM master already attempted it before the GMU was torn down.

This only fences scheduler submissions. It does not stop already
running DMA or make destruction after a failed suspend safe. Keep the
candidate build-only until the hardware stop and lifetime are handled.

--- a/drivers/gpu/drm/msm/msm_gpu.h
+++ b/drivers/gpu/drm/msm/msm_gpu.h
@@ -243,6 +243,7 @@
 	struct kthread_work recover_work;
 	spinlock_t recovery_lock;
 	bool recovery_closed;
+	bool terminal_suspend_started;
 	bool retire_closed;
 
 	/** retire_event: notified when submits are retired: */
@@ -761,6 +762,7 @@
 
 struct msm_gpu *adreno_load_gpu(struct drm_device *dev);
 int adreno_system_suspend(struct device *dev);
+int adreno_terminal_suspend(struct device *dev);
 bool adreno_has_gpu(struct device_node *node);
 void __init adreno_register(void);
 void __exit adreno_unregister(void);
--- a/drivers/gpu/drm/msm/msm_drv.c
+++ b/drivers/gpu/drm/msm/msm_drv.c
@@ -186,7 +186,7 @@
 			msm_iommu_gpu_close_faults(to_msm_vm(gpu->vm)->mmu);
 		msm_gpu_close_recovery(gpu);
 		if (pm_runtime_enabled(gpu_dev) &&
-		    !WARN_ON_ONCE(adreno_system_suspend(gpu_dev))) {
+		    !WARN_ON_ONCE(adreno_terminal_suspend(gpu_dev))) {
 			msm_gpu_release_irq(gpu);
 			msm_gpu_close_retire(gpu);
 		}
--- a/drivers/gpu/drm/msm/adreno/adreno_device.c
+++ b/drivers/gpu/drm/msm/adreno/adreno_device.c
@@ -256,8 +256,8 @@
 	struct msm_drm_private *priv = msm_drm_get_priv(master);
 	struct msm_gpu *gpu = dev_to_gpu(dev);
 
-	if (pm_runtime_enabled(dev))
-		WARN_ON_ONCE(adreno_system_suspend(dev));
+	if (pm_runtime_enabled(dev) && !gpu->terminal_suspend_started)
+		WARN_ON_ONCE(adreno_terminal_suspend(dev));
 	gpu->funcs->destroy(gpu);
 
 	priv->gpu_pdev = NULL;
@@ -370,13 +370,16 @@
 	}
 }
 
-int adreno_system_suspend(struct device *dev)
+static int adreno_suspend(struct device *dev, bool terminal)
 {
 	struct msm_gpu *gpu = dev_to_gpu(dev);
 	int remaining, ret;
 
 	if (!gpu)
 		return 0;
+
+	if (terminal)
+		gpu->terminal_suspend_started = true;
 
 	suspend_scheduler(gpu);
 
@@ -391,10 +394,21 @@
 
 	ret = pm_runtime_force_suspend(dev);
 out:
-	if (ret)
+	/* Final removal must never feed more jobs to a departing GMU. */
+	if (ret && !terminal)
 		resume_scheduler(gpu);
 
 	return ret;
+}
+
+int adreno_system_suspend(struct device *dev)
+{
+	return adreno_suspend(dev, false);
+}
+
+int adreno_terminal_suspend(struct device *dev)
+{
+	return adreno_suspend(dev, true);
 }
 
 static int adreno_system_resume(struct device *dev)
