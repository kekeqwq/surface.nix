+int q6apm_fullio_get_cfg(struct q6apm_graph *graph, u32 instance, u32 param,
+			void *data, size_t bytes)
+{
+	struct q6apm_fullio_get get = {
+		.instance = instance, .param = param, .bytes = bytes, .data = data,
+	};
+	struct apm_module_param_data *request;
+	size_t payload_size;
+
+	if (!graph->ar_graph || !graph->port || !data ||
+	    !((instance == 0x4027 && param == 0x080011e8 && bytes == 68) ||
+	      (instance == 0x4024 && param == 0x080011f6 && bytes == 44)))
+		return -EINVAL;
+	if (!q6apm_fullio_transport_enabled(graph->apm))
+		return -EAGAIN;
+
+	payload_size = ALIGN(APM_MODULE_PARAM_DATA_SIZE + bytes, 8);
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_cmd_pkt(payload_size, APM_CMD_GET_CFG, 0, graph->port->id,
+					instance);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	request = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	request->module_instance_id = instance;
+	request->param_id = param;
+	request->param_size = bytes;
+	return q6apm_fullio_oob_rpc(graph->apm, graph->port, pkt, NULL, &get);
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_get_cfg);
