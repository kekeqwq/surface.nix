Subject: [EXPERIMENT] ASoC: q6apm: reverify FullIO protection tags after PREPARE

Recheck the exact SP and SPVI payloads on the same graph after
PREPARE, before committing the mute ticket or any audit START.
Configuration equality does not imply feedback liveness.

--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -635,7 +635,8 @@
 	return -ECANCELED;
 }
 
-static int q6apm_fullio_dsp_prepare_audit(struct q6apm_graph *graph, struct snd_soc_card *card)
+static int q6apm_fullio_dsp_prepare_audit(struct q6apm_graph *graph, struct snd_soc_card *card,
+				       const struct audioreach_fullio_stages *stages)
 {
 	struct device_node *node = card->dev->of_node;
 	int ret;
@@ -654,12 +655,19 @@
 	ret = q6apm_graph_prepare(graph);
 	if (ret)
 		return dev_err_probe(graph->dev, ret, "FullIO muted GRAPH_PREPARE rejected\n");
+	ret = audioreach_fullio_verify_tag(graph, stages, AR_FULLIO_SP_TAG);
+	if (!ret)
+		ret = audioreach_fullio_verify_tag(graph, stages, AR_FULLIO_SPVI_TAG);
+	if (ret)
+		return dev_err_probe(graph->dev, ret, "FullIO protection tag mismatch after GRAPH_PREPARE\n");
 	ret = audioreach_fullio_verify_mute(graph);
 	if (ret)
 		return ret;
 	ret = q6apm_fullio_both_pa_off(card);
-	if (!ret)
+	if (!ret) {
 		dev_info(graph->dev, "FullIO mute survived GRAPH_PREPARE\n");
+		dev_info(graph->dev, "FullIO SP/SPVI tags survived GRAPH_PREPARE byte-for-byte\n");
+	}
 	return ret;
 }
 
@@ -835,7 +843,7 @@
 	unmap_ret = q6apm_fullio_release_cal(prtd);
 	if (ret || unmap_ret)
 		return ret ?: unmap_ret;
-	ret = q6apm_fullio_dsp_prepare_audit(prtd->graph, card);
+	ret = q6apm_fullio_dsp_prepare_audit(prtd->graph, card, &stages);
 	if (ret)
 		return ret;
 	ret = q6apm_fullio_mute_commit(prtd->graph, &ticket);
