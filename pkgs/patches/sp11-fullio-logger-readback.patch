+static int q6apm_fullio_verify_logger_tags(struct q6apm_graph *graph, bool started,
+					   bool rx0_log_off, u32 feedback_log_off)
+{
+	static const struct { u32 iid, tag; } rows[] = {
+		{ 0x4003, 4 }, { 0x4025, 2 }, { 0x402a, 3 },
+	};
+	const char *phase = started ? "post-START" : "pre-START";
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(rows); i++) {
+		bool off = i ? feedback_log_off & BIT(i - 1) : rx0_log_off;
+		u32 code = off ? 0 : Q6APM_FULLIO_DIAG_LOG_CODE;
+		__le32 cfg[3];
+		int ret = q6apm_fullio_get_cfg(graph, rows[i].iid, Q6APM_FULLIO_LOG_CFG,
+					      cfg, sizeof(cfg));
+
+		if (ret)
+			return dev_err_probe(graph->dev, ret < 0 ? ret : -EPROTO,
+					     "FullIO %s logger %#x GET_CFG unverified\n", phase, rows[i].iid);
+		if (le32_to_cpu(cfg[0]) != code || le32_to_cpu(cfg[1]) != rows[i].tag ||
+		    le32_to_cpu(cfg[2]) != 1)
+			return dev_err_probe(graph->dev, -EILSEQ,
+					     "FullIO %s logger %#x config mismatch: code=%#x tap=%u mode=%u\n",
+					     phase, rows[i].iid, le32_to_cpu(cfg[0]), le32_to_cpu(cfg[1]),
+					     le32_to_cpu(cfg[2]));
+		dev_info(graph->dev, "FullIO %s logger %#x GET_CFG verified: code=0x%x tap=%u mode=1\n",
+			 phase, rows[i].iid, code, rows[i].tag);
+	}
+	return 0;
+}
