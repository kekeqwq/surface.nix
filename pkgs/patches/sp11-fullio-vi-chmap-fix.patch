--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -1952,7 +1952,10 @@
 
 	op_sz = APM_SP_VI_OP_MODE_CFG_PSIZE(num_channels);
 	/* Channel mapping for Isense and Vsense, thus twice number of speakers. */
-	cm_sz = APM_SP_VI_CH_MAP_CFG_PSIZE(num_channels * 2);
+	/* One VI pair (Vsense, Isense) per physical 32-bit channel pair;
+	 * do not read past the 2-channel DMA buffer into adjacent memory.
+	 */
+	cm_sz = APM_SP_VI_CH_MAP_CFG_PSIZE(num_channels);
 	ex_sz = APM_SP_VI_EX_MODE_CFG_PSIZE;
 
 	payload_size = op_sz + cm_sz + ex_sz;
@@ -1981,18 +1984,17 @@
 	param_data->param_id = PARAM_ID_SP_VI_CHANNEL_MAP_CFG;
 	param_data->param_size = cm_sz - APM_MODULE_PARAM_DATA_SIZE;
 
-	cm_cfg->cfg.num_channels = num_channels * 2;
-	/* Convert the physical mapping to a logical mapping of the channels */
+	cm_cfg->cfg.num_channels = num_channels;
+	/* One logical VI signal per physical channel; never read more than
+	 * the 2-channel buffer provides.
+	 */
 	for (i = 0, j = 0; i < AR_PCM_MAX_NUM_CHANNEL && j < num_channels; i++) {
 		if (!mcfg->channel_map[i])
 			continue;
-		/*
-		 * Map speakers into Vsense and then Isense of each channel.
-		 * E.g. for PCM_CHANNEL_FL and PCM_CHANNEL_FR to:
-		 * [1, 2, 3, 4]
+		/* Two physical channels carry V-sense and I-sense for the
+		 * paired amplifier: logical [Vsense, Isense].
 		 */
-		cm_cfg->cfg.channel_mapping[2 * j] = (mcfg->channel_map[i] - 1) * 2 + 1;
-		cm_cfg->cfg.channel_mapping[2 * j + 1] = (mcfg->channel_map[i] - 1) * 2 + 2;
+		cm_cfg->cfg.channel_mapping[j] = j + 1;
 
 		++j;
 	}
