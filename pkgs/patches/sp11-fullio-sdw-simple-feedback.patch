Subject: [EXPERIMENT] soundwire: support optional SIMPLE feedback port registers

Adapt the optional SIMPLE register writes from the Golden v32 overlay of
geocausa/SP11X1e-audio@3232e1dacdeb580a10a9cb8d4756a4518a7bd83e.
Keep the slave OffsetCtrl1 override in per-port properties, without changing
the master schedule or requiring new initialized fields in every caller.
No existing port enables these properties.

diff --git a/drivers/soundwire/stream.c b/drivers/soundwire/stream.c
index 31db368..e48ce10 100755
--- a/drivers/soundwire/stream.c
+++ b/drivers/soundwire/stream.c
@@ -62,6 +62,57 @@ int sdw_find_row_index(int row)
 }
 EXPORT_SYMBOL(sdw_find_row_index);
 
+static int sdw_program_simple_ext(struct sdw_bus *bus, struct sdw_slave *slave,
+				  struct sdw_transport_params *t_params,
+				  u32 registers)
+{
+	u32 blockctrl3, samplectrl2, hctrl, offsetctrl2;
+	u16 wbuf;
+	int ret;
+
+	if (bus->params.next_bank) {
+		blockctrl3 = SDW_DPN_BLOCKCTRL3_B1(t_params->port_num);
+		samplectrl2 = SDW_DPN_SAMPLECTRL2_B1(t_params->port_num);
+		hctrl = SDW_DPN_HCTRL_B1(t_params->port_num);
+		offsetctrl2 = SDW_DPN_OFFSETCTRL2_B1(t_params->port_num);
+	} else {
+		blockctrl3 = SDW_DPN_BLOCKCTRL3_B0(t_params->port_num);
+		samplectrl2 = SDW_DPN_SAMPLECTRL2_B0(t_params->port_num);
+		hctrl = SDW_DPN_HCTRL_B0(t_params->port_num);
+		offsetctrl2 = SDW_DPN_OFFSETCTRL2_B0(t_params->port_num);
+	}
+
+	if (registers & SDW_DPN_SIMPLE_TRANSPORT_BLOCKCTRL3) {
+		ret = sdw_write_no_pm(slave, blockctrl3, t_params->blk_pkg_mode);
+		if (ret < 0)
+			return ret;
+	}
+
+	if (registers & SDW_DPN_SIMPLE_TRANSPORT_SAMPLECTRL2) {
+		wbuf = FIELD_GET(SDW_DPN_SAMPLECTRL_HIGH,
+				 t_params->sample_interval - 1);
+		ret = sdw_write_no_pm(slave, samplectrl2, wbuf);
+		if (ret < 0)
+			return ret;
+	}
+
+	if (registers & SDW_DPN_SIMPLE_TRANSPORT_HCTRL) {
+		wbuf = FIELD_PREP(SDW_DPN_HCTRL_HSTART, t_params->hstart);
+		wbuf |= FIELD_PREP(SDW_DPN_HCTRL_HSTOP, t_params->hstop);
+		ret = sdw_write_no_pm(slave, hctrl, wbuf);
+		if (ret < 0)
+			return ret;
+	}
+
+	if (registers & SDW_DPN_SIMPLE_TRANSPORT_OFFSETCTRL2) {
+		ret = sdw_write_no_pm(slave, offsetctrl2, t_params->offset2);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
 static int _sdw_program_slave_port_params(struct sdw_bus *bus,
 					  struct sdw_slave *slave,
 					  struct sdw_transport_params *t_params,
@@ -139,6 +190,8 @@ static int sdw_program_slave_port_params(struct sdw_bus *bus,
 	enum sdw_dpn_type port_type;
 	bool read_only_wordlength;
 	int ret;
+	u32 simple_transport_registers = 0;
+	u8 offset1 = t_params->offset1;
 	u8 wbuf;
 
 	if (s_rt->slave->is_mockup_device)
@@ -154,6 +207,11 @@ static int sdw_program_slave_port_params(struct sdw_bus *bus,
 
 		read_only_wordlength = dpn_prop->read_only_wordlength;
 		port_type = dpn_prop->type;
+		if (port_type == SDW_DPN_SIMPLE) {
+			simple_transport_registers = dpn_prop->simple_transport_registers;
+			if (dpn_prop->override_offset1)
+				offset1 = dpn_prop->offset1;
+		}
 	} else {
 		read_only_wordlength = false;
 		port_type = SDW_DPN_FULL;
@@ -209,7 +267,7 @@ static int sdw_program_slave_port_params(struct sdw_bus *bus,
 	}
 
 	/* Program DPN_OffsetCtrl1 registers */
-	ret = sdw_write_no_pm(s_rt->slave, addr4, t_params->offset1);
+	ret = sdw_write_no_pm(s_rt->slave, addr4, offset1);
 	if (ret < 0) {
 		dev_err(&s_rt->slave->dev,
 			"DPN_OffsetCtrl1 register write failed for port %d\n",
@@ -248,6 +306,10 @@ static int sdw_program_slave_port_params(struct sdw_bus *bus,
 				t_params->port_num);
 	}
 
+	if (simple_transport_registers)
+		return sdw_program_simple_ext(bus, s_rt->slave, t_params,
+						 simple_transport_registers);
+
 	return ret;
 }
 
diff --git a/include/linux/soundwire/sdw.h b/include/linux/soundwire/sdw.h
index f710e59..dcc9d37 100755
--- a/include/linux/soundwire/sdw.h
+++ b/include/linux/soundwire/sdw.h
@@ -274,6 +274,11 @@ struct sdw_dp0_prop {
 	u32 *lane_list;
 };
 
+#define SDW_DPN_SIMPLE_TRANSPORT_BLOCKCTRL3	BIT(0)
+#define SDW_DPN_SIMPLE_TRANSPORT_SAMPLECTRL2	BIT(1)
+#define SDW_DPN_SIMPLE_TRANSPORT_HCTRL		BIT(2)
+#define SDW_DPN_SIMPLE_TRANSPORT_OFFSETCTRL2	BIT(3)
+
 /**
  * struct sdw_dpn_prop - Data Port DPn properties
  * @num: port number
@@ -303,6 +308,9 @@ struct sdw_dp0_prop {
  * @port_encoding: Payload Channel Sample encoding schemes supported
  * @block_pack_mode: Type of block port mode supported
  * @read_only_wordlength: Read Only wordlength field in DPN_BlockCtrl1 register
+ * @simple_transport_registers: Optional banked registers of a SIMPLE port
+ * @override_offset1: Use the slave-specific OffsetCtrl1 value
+ * @offset1: Slave OffsetCtrl1 when override_offset1 is set
  * @simple_ch_prep_sm: If the port supports simplified channel prepare state
  * machine
  */
@@ -330,6 +338,9 @@ struct sdw_dpn_prop {
 	bool block_pack_mode;
 	bool read_only_wordlength;
 	bool simple_ch_prep_sm;
+	u32 simple_transport_registers;
+	bool override_offset1;
+	u8 offset1;
 };
 
