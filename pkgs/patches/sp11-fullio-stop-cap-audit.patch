Subject: [EXPERIMENT] ASoC: WSA884x: verify PA-off DRE cap retention in gain audit

Compare uncached DRE1 before and after verified PA shutdown only on
the PA-off gain-audit fixture. Report only when the same device/epoch
survived. No new writes or PA-on configuration.

--- a/sound/soc/codecs/wsa884x.c
+++ b/sound/soc/codecs/wsa884x.c
@@ -2181,7 +2181,10 @@
 int wsa884x_fullio_stop_audit(struct snd_soc_component *component)
 {
 	struct wsa884x_priv *amp;
+	unsigned int dre_before = 0, dre_after;
 	int ret, before;
+	bool check_cap;
+	u64 epoch;
 
 	if (!component || component->driver != &wsa884x_component_drv ||
 	    !wsa884x_fullio_pa_stop_audit(component))
@@ -2192,9 +2195,26 @@
 	ret = pm_runtime_resume_and_get(amp->dev);
 	if (ret < 0)
 		return ret;
+	check_cap = of_property_read_bool(component->card->dev->of_node,
+					  "microsoft,denali-fullio-pa-off-gain-audit");
+	epoch = atomic64_read_acquire(&amp->fullio_pa_epoch);
 	before = wsa884x_fullio_pa_off(component);
+	if (!before && check_cap)
+		before = regmap_read_bypassed(amp->regmap, WSA884X_DRE_CTL_1, &dre_before);
 	/* Always attempt shutdown even if the precheck cannot prove PA off. */
 	ret = wsa884x_fullio_verified_stop(component, amp);
+	if (!ret && !before && check_cap) {
+		ret = regmap_read_bypassed(amp->regmap, WSA884X_DRE_CTL_1, &dre_after);
+		if (!ret && (epoch + 1 != (u64)atomic64_read_acquire(&amp->fullio_pa_epoch) ||
+			     READ_ONCE(amp->slave->status) != SDW_SLAVE_ATTACHED))
+			ret = -ESTALE;
+		if (!ret && (dre_after != dre_before ||
+			     !(dre_after & WSA884X_DRE_CTL_1_CSR_GAIN_EN_MASK)))
+			ret = -EIO;
+		if (!ret)
+			dev_info(component->dev, "FullIO PA-off DRE cap retained: before=%#x after=%#x\n",
+				 dre_before, dre_after);
+	}
 	pm_runtime_mark_last_busy(amp->dev);
 	pm_runtime_put_autosuspend(amp->dev);
 	if (before || ret)
