drm/msm: Return the GBIF/VBIF acknowledgement result to callers

Return -ETIMEDOUT if any existing acknowledgement poll timed out.
Preserve all polls, writes and halt release regardless of the result.
The status is not a DMA fence: the bus helper still clears GBIF halt,
and callers must separately establish engine stop and handle failure.

No change to caller PM behavior; Denali build-only candidate.

--- a/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
@@ -2082,46 +2082,59 @@
 #define VBIF_RESET_ACK_MASK		0xF0
 #define GPR0_GBIF_HALT_REQUEST		0x1E0
 
-void a6xx_bus_clear_pending_transactions(struct adreno_gpu *adreno_gpu, bool gx_off)
+int a6xx_bus_clear_pending_transactions(struct adreno_gpu *adreno_gpu, bool gx_off)
 {
 	struct msm_gpu *gpu = &adreno_gpu->base;
+	int ret = 0;
 
 	if (adreno_is_a619_holi(adreno_gpu)) {
 		gpu_write(gpu, REG_A6XX_RBBM_GPR0_CNTL, GPR0_GBIF_HALT_REQUEST);
 		if (spin_until((gpu_read(gpu, REG_A6XX_RBBM_VBIF_GX_RESET_STATUS) &
-				VBIF_RESET_ACK_MASK) == VBIF_RESET_ACK_MASK))
+				VBIF_RESET_ACK_MASK) == VBIF_RESET_ACK_MASK)) {
+			ret = -ETIMEDOUT;
 			dev_err_ratelimited(&gpu->pdev->dev, "Timed out waiting for GX reset ACK\n");
+		}
 	} else if (!a6xx_has_gbif(adreno_gpu)) {
 		gpu_write(gpu, REG_A6XX_VBIF_XIN_HALT_CTRL0, VBIF_XIN_HALT_CTRL0_MASK);
 		if (spin_until((gpu_read(gpu, REG_A6XX_VBIF_XIN_HALT_CTRL1) &
-				VBIF_XIN_HALT_CTRL0_MASK) == VBIF_XIN_HALT_CTRL0_MASK))
+				VBIF_XIN_HALT_CTRL0_MASK) == VBIF_XIN_HALT_CTRL0_MASK)) {
+			ret = -ETIMEDOUT;
 			dev_err_ratelimited(&gpu->pdev->dev, "Timed out waiting for VBIF halt ACK\n");
+		}
 		gpu_write(gpu, REG_A6XX_VBIF_XIN_HALT_CTRL0, 0);
 
-		return;
+		return ret;
 	}
 
 	if (gx_off) {
 		/* Halt the gx side of GBIF */
 		gpu_write(gpu, REG_A6XX_RBBM_GBIF_HALT, 1);
-		if (spin_until(gpu_read(gpu, REG_A6XX_RBBM_GBIF_HALT_ACK) & 1))
+		if (spin_until(gpu_read(gpu, REG_A6XX_RBBM_GBIF_HALT_ACK) & 1)) {
+			ret = -ETIMEDOUT;
 			dev_err_ratelimited(&gpu->pdev->dev, "Timed out waiting for GX GBIF halt ACK\n");
+		}
 	}
 
 	/* Halt new client requests on GBIF */
 	gpu_write(gpu, REG_A6XX_GBIF_HALT, GBIF_CLIENT_HALT_MASK);
 	if (spin_until((gpu_read(gpu, REG_A6XX_GBIF_HALT_ACK) &
-			GBIF_CLIENT_HALT_MASK) == GBIF_CLIENT_HALT_MASK))
+			GBIF_CLIENT_HALT_MASK) == GBIF_CLIENT_HALT_MASK)) {
+		ret = -ETIMEDOUT;
 		dev_err_ratelimited(&gpu->pdev->dev, "Timed out waiting for GBIF client halt ACK\n");
+	}
 
 	/* Halt all AXI requests on GBIF */
 	gpu_write(gpu, REG_A6XX_GBIF_HALT, GBIF_ARB_HALT_MASK);
 	if (spin_until((gpu_read(gpu, REG_A6XX_GBIF_HALT_ACK) &
-			GBIF_ARB_HALT_MASK) == GBIF_ARB_HALT_MASK))
+			GBIF_ARB_HALT_MASK) == GBIF_ARB_HALT_MASK)) {
+		ret = -ETIMEDOUT;
 		dev_err_ratelimited(&gpu->pdev->dev, "Timed out waiting for GBIF arbiter halt ACK\n");
+	}
 
 	/* The GBIF halt needs to be explicitly cleared */
 	gpu_write(gpu, REG_A6XX_GBIF_HALT, 0x0);
+
+	return ret;
 }
 
