Subject: [EXPERIMENT] ASoC: AudioReach: compare FullIO tag data to DSP readback

The captured SP and SPVI replies match their pinned tag payloads byte for
byte. A successful envelope alone does not count as accepted calibration.
Keep the frontend playback gate closed; no live caller is enabled here.

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index 2c4d72a..a9df753 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -193,6 +193,47 @@ int audioreach_fullio_collect_stages(const struct audioreach_graph_info *info,
 }
 EXPORT_SYMBOL_GPL(audioreach_fullio_collect_stages);
 
+int audioreach_fullio_verify_tag(struct q6apm_graph *graph,
+				const struct audioreach_fullio_stages *stages,
+				enum ar_fullio_stage_id stage)
+{
+	const struct audioreach_module_priv_data *tag;
+	const u8 *expected;
+	u32 instance, param, bytes;
+	u8 actual[68];
+	int ret;
+
+	switch (stage) {
+	case AR_FULLIO_SP_TAG:
+		instance = 0x4027;
+		param = 0x080011e8;
+		bytes = 68;
+		break;
+	case AR_FULLIO_SPVI_TAG:
+		instance = 0x4024;
+		param = 0x080011f6;
+		bytes = 44;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	tag = stages->stage[stage];
+	if (!tag || le32_to_cpu(tag->size) < APM_MODULE_PARAM_DATA_SIZE + bytes ||
+	    get_unaligned_le32(tag->data) != instance ||
+	    get_unaligned_le32(tag->data + 1) != param ||
+	    get_unaligned_le32(tag->data + 2) != bytes ||
+	    get_unaligned_le32(tag->data + 3))
+		return -EINVAL;
+
+	expected = (const u8 *)tag->data + APM_MODULE_PARAM_DATA_SIZE;
+	ret = q6apm_fullio_get_cfg(graph, instance, param, actual, bytes);
+	if (ret)
+		return ret;
+	return memcmp(expected, actual, bytes) ? -EILSEQ : 0;
+}
+EXPORT_SYMBOL_GPL(audioreach_fullio_verify_tag);
+
 struct apm_pcm_module_media_fmt_cmd {
 	struct apm_module_param_data param_data;
 	struct param_id_pcm_output_format_cfg header;
diff --git a/sound/soc/qcom/qdsp6/audioreach.h b/sound/soc/qcom/qdsp6/audioreach.h
index e227fb8..977e18a 100644
--- a/sound/soc/qcom/qdsp6/audioreach.h
+++ b/sound/soc/qcom/qdsp6/audioreach.h
@@ -1048,6 +1048,9 @@ void *audioreach_alloc_graph_pkt(struct q6apm *apm,
 				 const struct audioreach_graph_info *info);
 int audioreach_fullio_collect_stages(const struct audioreach_graph_info *info,
 				    struct audioreach_fullio_stages *stages);
+int audioreach_fullio_verify_tag(struct q6apm_graph *graph,
+				const struct audioreach_fullio_stages *stages,
+				enum ar_fullio_stage_id stage);
 /* Topology specific */
 int audioreach_tplg_init(struct snd_soc_component *component);
 
