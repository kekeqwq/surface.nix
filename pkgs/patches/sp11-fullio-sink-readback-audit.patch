+static int q6apm_fullio_verify_sink(struct q6apm_graph *graph)
+{
+	static const struct {
+		u32 param;
+		__le32 expected[3];
+	} rows[] = {
+		/* rate, packed bits/channels, fixed-point PCM */
+		{ PARAM_ID_HW_EP_MF_CFG,
+		  { cpu_to_le32(48000), cpu_to_le32((2 << 16) | 16), cpu_to_le32(1) } },
+		/* WSA type, interface 1, both DMA slots */
+		{ PARAM_ID_CODEC_DMA_INTF_CFG, { cpu_to_le32(2), cpu_to_le32(1), cpu_to_le32(3) } },
+	};
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(rows); i++) {
+		__le32 actual[3];
+
+		ret = q6apm_fullio_get_cfg(graph, 0x4157, rows[i].param, actual, sizeof(actual));
+		if (ret)
+			return dev_err_probe(graph->dev, ret < 0 ? ret : -EPROTO,
+					     "FullIO sink GET_CFG %#x unverified\n", rows[i].param);
+		if (memcmp(actual, rows[i].expected, sizeof(actual)))
+			return dev_err_probe(graph->dev, -EILSEQ,
+					     "FullIO sink %#x differs from Golden\n", rows[i].param);
+	}
+	return 0;
 }
 
