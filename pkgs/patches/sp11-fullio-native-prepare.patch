+int q6apm_fullio_pcm_configure(struct q6apm_graph *graph, struct snd_soc_card *card, int sid)
+{
+	struct q6apm_fullio_ring *ring;
+
+	if (!q6apm_fullio_reference_render(card) || graph->id || graph->shm_iid != 0x4660 ||
+	    !q6apm_is_graph_in_push_pull_mode(graph) || !audioreach_fullio_graph(graph->info))
+		return -EPERM;
+	guard(mutex)(&graph->apm->graph_lock);
