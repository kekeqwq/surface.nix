Subject: [EXPERIMENT] ASoC: Denali: track VI and CPS transport lifetime per DSP

Publish an enabled state only after a real SoundWire runtime is enabled;
clear it before hardware free or shutdown. Track VI and CPS independently
on the owning APM device rather than process-global booleans. This does not
certify samples, apply calibration or select a higher gain.

diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index e833362..337a080 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -30,6 +30,28 @@ struct apm_graph_mgmt_cmd {
 
 static struct q6apm *g_apm;
 
+void q6apm_fullio_set_transport(struct device *dev, enum q6apm_fullio_feedback path,
+			      bool enabled)
+{
+	struct q6apm *apm = dev_get_drvdata(dev->parent);
+
+	if (!apm || (path != Q6APM_FULLIO_VI && path != Q6APM_FULLIO_CPS))
+		return;
+	if (enabled)
+		set_bit(path, &apm->fullio_transport);
+	else
+		clear_bit(path, &apm->fullio_transport);
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_set_transport);
+
+bool q6apm_fullio_transport_enabled(struct q6apm *apm)
+{
+	unsigned long required = BIT(Q6APM_FULLIO_VI) | BIT(Q6APM_FULLIO_CPS);
+
+	return (READ_ONCE(apm->fullio_transport) & required) == required;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_transport_enabled);
+
 int q6apm_send_cmd_sync(struct q6apm *apm, struct gpr_pkt *pkt,
 			uint32_t rsp_opcode)
 {
