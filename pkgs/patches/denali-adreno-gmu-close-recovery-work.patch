+
+void msm_gpu_queue_recovery(struct msm_gpu *gpu)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&gpu->recovery_lock, flags);
+	if (!gpu->recovery_closed)
+		kthread_queue_work(gpu->worker, &gpu->recover_work);
+	spin_unlock_irqrestore(&gpu->recovery_lock, flags);
+}
+
+void msm_gpu_close_recovery(struct msm_gpu *gpu)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&gpu->recovery_lock, flags);
+	gpu->recovery_closed = true;
+	spin_unlock_irqrestore(&gpu->recovery_lock, flags);
+
+	/* The worker can take gpu->lock; the caller must not hold it. */
+	kthread_cancel_work_sync(&gpu->recover_work);
 }
 
