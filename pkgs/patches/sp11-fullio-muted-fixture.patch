Subject: [EXPERIMENT] ASoC: allow FullIO topology in the muted Denali fixture

Require an explicit property on the Denali sound node. Keep validation,
PA lockout and the graph-start gate; the normal Denali queue is unchanged.

diff --git a/sound/soc/qcom/qdsp6/topology.c b/sound/soc/qcom/qdsp6/topology.c
index 80b5f3b..84db182 100755
--- a/sound/soc/qcom/qdsp6/topology.c
+++ b/sound/soc/qcom/qdsp6/topology.c
@@ -9,6 +9,7 @@
 #include <sound/control.h>
 #include <sound/asound.h>
 #include <linux/firmware.h>
+#include <linux/of.h>
 #include <sound/soc-topology.h>
 #include <sound/soc-dpcm.h>
 #include <uapi/sound/snd_ar_tokens.h>
@@ -311,7 +312,8 @@ static int audioreach_validate_fullio_links(const u8 *data, size_t size)
 	return size ? -EINVAL : 0;
 }
 
-static int audioreach_validate_private(const struct snd_soc_tplg_private *private)
+static int audioreach_validate_private(const struct snd_soc_tplg_private *private,
+				       bool muted_fixture)
 {
 	const u8 *data = private->data;
 	size_t remaining = le32_to_cpu(private->size), size;
@@ -338,8 +340,8 @@ static int audioreach_validate_private(const struct snd_soc_tplg_private *privat
 		remaining -= size;
 	}
 
-	/* Never partially load a FullIO graph before its DSP transactions exist. */
-	return fullio ? -EOPNOTSUPP : 0;
+	/* Accept these records only for the separate, silent Denali fixture. */
+	return fullio && !muted_fixture ? -EOPNOTSUPP : 0;
 }
 
 static const struct snd_soc_tplg_vendor_array *
@@ -1182,7 +1184,10 @@ static int audioreach_widget_ready(struct snd_soc_component *component,
 				   int index, struct snd_soc_dapm_widget *w,
 				   struct snd_soc_tplg_dapm_widget *tplg_w)
 {
-	int ret = audioreach_validate_private(&tplg_w->priv);
+	bool muted_fixture = of_machine_is_compatible("microsoft,denali") &&
+		of_property_read_bool(component->card->dev->of_node,
+				      "microsoft,denali-fullio-muted-test");
+	int ret = audioreach_validate_private(&tplg_w->priv, muted_fixture);
 
 	if (ret)
 		return dev_err_probe(component->dev, ret,
