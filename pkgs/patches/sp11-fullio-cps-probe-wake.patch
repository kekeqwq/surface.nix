Subject: [EXPERIMENT] soundwire: measure Denali CPS controller wake parity

Port the two pinned v19c wake values only for a capture-only CPS A/B fixture.
Verify both readbacks and restore saved settings at teardown. This does not
change amplitude, protection, regular feedback paths or the VI control.

diff --git a/drivers/soundwire/qcom.c b/drivers/soundwire/qcom.c
index 7d1f6b8..341644b 100755
--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -213,6 +213,9 @@ struct qcom_swrm_ctrl {
 	int cols_index;
 	int rows_index;
 	unsigned long port_mask;
+	bool cps_wake_active;
+	u32 cps_saved_route;
+	u32 cps_saved_pcm;
 	u32 intr_mask;
 	u8 rcmd_id;
 	u8 wcmd_id;
@@ -1105,6 +1108,63 @@ static int qcom_swrm_port_params(struct sdw_bus *bus,
 				p_params->bps - 1);
 }
 
+#define DENALI_CPS_WAKE_ROUTE_REG 0x105c
+#define DENALI_CPS_WAKE_PCM_REG   0x1d54
+
+static bool qcom_swrm_cps_wake_probe(struct qcom_swrm_ctrl *ctrl)
+{
+	return ctrl->bus.controller_id == MASTER_ID_WSA &&
+	       of_machine_is_compatible("microsoft,denali") &&
+	       of_property_read_bool(ctrl->dev->of_node, "qcom,denali-fullio-feedback-capture-test") &&
+	       of_property_read_bool(ctrl->dev->of_node, "qcom,denali-cps-probe-wake-test");
+}
+
+static int qcom_swrm_restore_cps_wake(struct qcom_swrm_ctrl *ctrl)
+{
+	int pcm, route;
+
+	if (!ctrl->cps_wake_active)
+		return 0;
+	pcm = ctrl->reg_write(ctrl, DENALI_CPS_WAKE_PCM_REG, ctrl->cps_saved_pcm);
+	route = ctrl->reg_write(ctrl, DENALI_CPS_WAKE_ROUTE_REG, ctrl->cps_saved_route);
+	if (pcm || route) {
+		dev_err(ctrl->dev, "CPS probe wake restore failed: %d/%d\n", pcm, route);
+		return pcm ?: route;
+	}
+	ctrl->cps_wake_active = false;
+	return 0;
+}
+
+static int qcom_swrm_apply_cps_wake(struct qcom_swrm_ctrl *ctrl)
+{
+	u32 route, pcm;
+	int ret;
+
+	if (!ctrl->cps_wake_active) {
+		ret = ctrl->reg_read(ctrl, DENALI_CPS_WAKE_ROUTE_REG, &ctrl->cps_saved_route);
+		if (ret)
+			return ret;
+		ret = ctrl->reg_read(ctrl, DENALI_CPS_WAKE_PCM_REG, &ctrl->cps_saved_pcm);
+		if (ret)
+			return ret;
+		ctrl->cps_wake_active = true;
+	}
+	ret = ctrl->reg_write(ctrl, DENALI_CPS_WAKE_ROUTE_REG, 0x0005000f);
+	if (!ret)
+		ret = ctrl->reg_write(ctrl, DENALI_CPS_WAKE_PCM_REG, 0x3);
+	if (!ret)
+		ret = ctrl->reg_read(ctrl, DENALI_CPS_WAKE_ROUTE_REG, &route);
+	if (!ret)
+		ret = ctrl->reg_read(ctrl, DENALI_CPS_WAKE_PCM_REG, &pcm);
+	if (!ret && (route != 0x0005000f || pcm != 0x3))
+		ret = -EIO;
+	if (ret)
+		qcom_swrm_restore_cps_wake(ctrl);
+	else
+		dev_info_ratelimited(ctrl->dev, "CPS probe route and DP13 PCM wake readback verified\n");
+	return ret;
+}
+
 static int qcom_swrm_transport_params(struct sdw_bus *bus,
 				      struct sdw_transport_params *params,
 				      enum sdw_reg_bank bank)
@@ -1119,6 +1179,12 @@ static int qcom_swrm_transport_params(struct sdw_bus *bus,
 
 	pcfg = &ctrl->pconfig[params->port_num];
 
+	if (params->port_num == 13 && qcom_swrm_cps_wake_probe(ctrl)) {
+		ret = qcom_swrm_apply_cps_wake(ctrl);
+		if (ret)
+			goto err;
+	}
+
 	value = pcfg->off1 << SWRM_DP_PORT_CTRL_OFFSET1_SHFT;
 	value |= pcfg->off2 << SWRM_DP_PORT_CTRL_OFFSET2_SHFT;
 	value |= pcfg->si & 0xff;
@@ -1498,6 +1564,8 @@ static int qcom_swrm_hw_free(struct snd_pcm_substream *substream,
 	qcom_swrm_stream_free_ports(ctrl, sruntime);
 	sdw_stream_remove_master(&ctrl->bus, sruntime);
 
+	if (dai->id == 10 && qcom_swrm_cps_wake_probe(ctrl))
+		return qcom_swrm_restore_cps_wake(ctrl);
 	return 0;
 }
 
@@ -1541,6 +1609,8 @@ static void qcom_swrm_shutdown(struct snd_pcm_substream *substream,
 {
 	struct qcom_swrm_ctrl *ctrl = dev_get_drvdata(dai->dev);
 
+	if (dai->id == 10 && qcom_swrm_cps_wake_probe(ctrl))
+		qcom_swrm_restore_cps_wake(ctrl);
 	swrm_wait_for_wr_fifo_done(ctrl);
 	pm_runtime_mark_last_busy(ctrl->dev);
 	pm_runtime_put_autosuspend(ctrl->dev);
