+static int wsa884x_fullio_read_sink_bank(struct wsa884x_priv *amp,
+					 struct wsa884x_fullio_pa_snapshot *snapshot)
+{
+	struct sdw_slave *slave = amp->slave;
+	unsigned int bank, dp;
+	int ret;
+
+	if (READ_ONCE(amp->fullio_sink_bank_observed))
+		return 0;
+	for (dp = 0; dp < 3; dp++)
+		if (!READ_ONCE(amp->port_prepared[dp]))
+			return 0; /* No active triplet to observe yet. */
+	bank = READ_ONCE(slave->bus->params.curr_bank);
+	for (dp = 1; dp <= 3; dp++) {
+		u32 reg = bank ? SDW_DPN_CHANNELEN_B1(dp) : SDW_DPN_CHANNELEN_B0(dp);
+
+		ret = sdw_read_no_pm(slave, reg);
+		if (ret < 0)
+			return ret;
+		if (!(ret & BIT(0)))
+			return 0; /* Prepared, not active yet. */
+		if (dp == 1)
+			reg = bank ? SDW_DPN_BLOCKCTRL3_B1(dp) : SDW_DPN_BLOCKCTRL3_B0(dp);
+		else
+			reg = bank ? SDW_DPN_OFFSETCTRL2_B1(dp) : SDW_DPN_OFFSETCTRL2_B0(dp);
+		ret = sdw_read_no_pm(slave, reg);
+		if (ret < 0)
+			return ret;
+		if (ret != (dp == 1 ? 0 : dp == 2 ? 7 : 0x1f))
+			return -EIO;
+	}
+	if (bank != READ_ONCE(slave->bus->params.curr_bank))
+		return -EAGAIN;
+	snapshot->sink_bank = bank;
+	snapshot->sink_sampled = true;
+	return 0;
+}
