Subject: [PATCH] soundwire: qcom: allow the highest explicitly mapped port

The port table and DT mappings are 1-based, but the automatic
bitmap search reports maxport as the exhaustion sentinel. Check the
two ranges separately. The Denali Linux 7.3 reference uses the same
bounds (ooaklee/linux_ms_dev_kit-sp11@54c026b31fa1).

--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -1514,6 +1514,20 @@
 	}
 
 	mutex_unlock(&ctrl->port_lock);
+}
+
+static int qcom_swrm_select_master_port(const unsigned long *mask,
+				       unsigned int maxport, unsigned int mapped)
+{
+	unsigned int port;
+
+	/* Explicit maps are 1-based; maxport is a valid mapped port. */
+	if (mapped)
+		return mapped <= maxport ? (int)mapped : -EBUSY;
+
+	/* Unlike an explicit map, bitmap search returns maxport on exhaustion. */
+	port = find_first_zero_bit(mask, maxport);
+	return port < maxport ? (int)port : -EBUSY;
 }
 
 static int qcom_swrm_stream_alloc_ports(struct qcom_swrm_ctrl *ctrl,
@@ -1564,15 +1578,10 @@
 			slave = s_rt->slave;
 			list_for_each_entry(p_rt, &s_rt->port_list, port_node) {
 				m_port = slave->m_port_map[p_rt->num];
-				/* Port numbers start from 1 - 14*/
-				if (m_port)
-					pn = m_port;
-				else
-					pn = find_first_zero_bit(port_mask, maxport);
-
-				if (pn >= maxport) {
-					dev_err(ctrl->dev, "All ports busy\n");
-					return -EBUSY;
+				pn = qcom_swrm_select_master_port(port_mask, maxport, m_port);
+				if (pn < 0) {
+					dev_err(ctrl->dev, "No usable master port\n");
+					return pn;
 				}
 				set_bit(pn, port_mask);
 				pconfig[nports].num = pn;
