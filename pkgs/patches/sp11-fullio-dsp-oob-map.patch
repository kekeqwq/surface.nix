+/* The caller serializes access and owns the DMA allocation. A poisoned
+ * region stays pinned and untouched until the owning DSP has been reset.
+ */
+struct q6apm_fullio_oob_region {
+	u64 dsp_addr;
+	size_t size;
+	u32 handle;
+	bool poisoned;
+};
