Subject: [EXPERIMENT] soundwire: qcom: check FullIO slots after clock-stop exit

The generic clock-stop exit can succeed without a reachable slave.
Feed a fresh raw status word into the existing opt-in loss latch.
Do not change PM unwind, masks, recovery, or codec register access.

--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -686,7 +686,24 @@
 			set_bit(i, &ctrl->fullio_seen_attached);
 		else if (status == SDW_SLAVE_UNATTACHED && test_bit(i, &ctrl->fullio_seen_attached))
 			qcom_swrm_fullio_latch_link_error(ctrl, -ENODEV);
+	}
+}
+
+/* The core's exit helper can return zero after skipping every slave.
+ * Keep resume/cleanup semantics, but do not admit a new FullIO stream
+ * on a controller that no longer sees its previously attached slots.
+ */
+static void qcom_swrm_fullio_check_resumed_slots(struct qcom_swrm_ctrl *ctrl)
+{
+	u32 slots;
+
+	if (!ctrl->fullio_link_gate)
+		return;
+	if (ctrl->reg_read(ctrl, SWRM_MCP_SLV_STATUS, &slots) != SDW_CMD_OK) {
+		qcom_swrm_fullio_latch_link_error(ctrl, -EIO);
+		return;
 	}
+	qcom_swrm_fullio_observe_slots(ctrl, slots);
 }
 
 static int qcom_swrm_get_alert_slave_dev_num(struct qcom_swrm_ctrl *ctrl)
@@ -2271,6 +2288,7 @@
 
 		swrm_fullio_pm_snapshot(ctrl, "before-exit-clock-stop", 0);
 		ret = sdw_bus_exit_clk_stop(&ctrl->bus);
+		qcom_swrm_fullio_check_resumed_slots(ctrl);
 		swrm_fullio_pm_snapshot(ctrl, "after-exit-clock-stop", ret);
 		if (ret < 0) {
 			qcom_swrm_fullio_latch_link_error(ctrl, ret);
