Avoid legacy DSP PCM mappings when the independent FullIO audit owns backing.

--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -904,6 +904,16 @@
 release_claim:
 	atomic_set(&apm->fullio_oob_claimed, 0);
 	return ret;
+}
+
+static bool q6apm_fullio_independent_pcm(struct snd_soc_component *component,
+					 unsigned int graph_id, int stream)
+{
+	/* MultiMedia1 is graph 0 in the pinned Denali FullIO topology. */
+	return stream == SNDRV_PCM_STREAM_PLAYBACK && graph_id == 0 && component->card &&
+	       of_machine_is_compatible("microsoft,denali") &&
+	       of_property_read_bool(component->card->dev->of_node,
+				     "microsoft,denali-fullio-ring-map-audit");
 }
 
 static int q6apm_dai_prepare(struct snd_soc_component *component,
@@ -947,13 +957,12 @@
 		if (ret)
 			return dev_err_probe(dev, ret, "FullIO feedback probe requires both PAs off\n");
 	}
-	if (audioreach_fullio_graph(prtd->graph->info) &&
-	    of_property_read_bool(component->card->dev->of_node, "microsoft,denali-fullio-ring-map-audit")) {
+	if (q6apm_fullio_independent_pcm(component, prtd->graph->id, substream->stream)) {
 		const unsigned int audit_period = 1920; /* Golden: 10 ms stereo S16_LE. */
 		bool dma_audit = of_property_read_bool(component->card->dev->of_node,
 						       "microsoft,denali-fullio-ring-dma-audit");
 
-		if (substream->stream != SNDRV_PCM_STREAM_PLAYBACK || prtd->state ||
+		if (!audioreach_fullio_graph(prtd->graph->info) || prtd->state ||
 		    pdata->has_reserved_mem || pdata->use_scm_assign ||
 		    pdata->sid < -1 || pdata->sid > SID_MASK_DEFAULT)
 			return -EPERM;
@@ -1390,6 +1399,7 @@
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct q6apm_dai_data *pdata;
 	struct snd_pcm *pcm = rtd->pcm;
+	struct device *dev = component->dev;
 	int size = BUFFER_BYTES_MAX + PAGE_SIZE;
 	int graph_id, ret;
 	bool is_push_pull;
@@ -1420,6 +1430,15 @@
 		ret = snd_pcm_set_fixed_buffer_all(pcm, SNDRV_DMA_TYPE_DEV, component->dev, size);
 		if (ret)
 			return ret;
+
+		if (q6apm_fullio_independent_pcm(component, graph_id, substream->stream)) {
+			if (!is_push_pull || pdata->has_reserved_mem || pdata->use_scm_assign ||
+			    pcm->streams[SNDRV_PCM_STREAM_CAPTURE].substream)
+				return -EPERM;
+			/* ALSA backing is local only; the audit separately owns DSP DMA. */
+			dev_info(dev, "FullIO independent PCM: no legacy DSP map\n");
+			return 0;
+		}
 
 		if (pdata->use_scm_assign && !pdata->has_reserved_mem) {
 			ret = q6apm_dai_scm_assign(pdata,
@@ -1483,6 +1502,11 @@
 
 	substream = pcm->streams[SNDRV_PCM_STREAM_PLAYBACK].substream;
 	if (substream) {
+		struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+		struct snd_soc_dai *cpu = rtd ? snd_soc_rtd_to_cpu(rtd, 0) : NULL;
+
+		if (cpu && q6apm_fullio_independent_pcm(component, cpu->driver->id, substream->stream))
+			return;
 		q6apm_dai_memory_unmap(component, substream);
 		if (pdata && pdata->use_scm_assign && !pdata->has_reserved_mem)
 			q6apm_dai_scm_unassign(pdata,
@@ -1506,6 +1530,8 @@
 		return -EOPNOTSUPP;
 
 	graph_id = cpu_dai->driver->id;
+	if (q6apm_fullio_independent_pcm(component, graph_id, SNDRV_PCM_STREAM_PLAYBACK))
+		return -EOPNOTSUPP;
 	pdata = snd_soc_component_get_drvdata(component);
 	if (!pdata)
 		return -EINVAL;
