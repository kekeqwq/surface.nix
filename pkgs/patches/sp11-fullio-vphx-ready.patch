Subject: [EXPERIMENT] ASoC: WSA884x: require a fresh Denali 2S reading for PA-ready

Read VPHX status in the same epoch as PA state. Reject invalid or
changed supply status rather than relying on a previous attachment.
This adds no caller, writes, profile changes or power control.

--- a/sound/soc/codecs/wsa884x.c
+++ b/sound/soc/codecs/wsa884x.c
@@ -1962,6 +1962,8 @@
 		ret = regmap_read_bypassed(wsa884x->regmap, WSA884X_PA_FSM_ERR_COND1, &snapshot.err1);
 	if (!ret && read_faults)
 		ret = regmap_read_bypassed(wsa884x->regmap, WSA884X_PDM_WD_CTL, &snapshot.pdm_wd);
+	if (!ret && read_faults)
+		ret = regmap_read_bypassed(wsa884x->regmap, WSA884X_VPHX_SYS_EN_STATUS, &snapshot.vphx);
 	sound = component->card ? component->card->dev->of_node : NULL;
 	if (!ret && !read_faults && !(before & WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK) &&
 	    of_machine_is_compatible("microsoft,denali") &&
@@ -2019,6 +2021,9 @@
 		return -EIO;
 	if (!(snapshot->enable & WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK) || snapshot->sta0 != 0x2f)
 		return -EAGAIN;
+	/* Denali reference selects the 2S profile only with VPHX status 2. */
+	if (snapshot->vphx != 0x02)
+		return -EIO;
 	/* Match the reference watchdog configuration, not a cutoff guarantee. */
 	if ((snapshot->pdm_wd & (WSA884X_PDM_WD_CTL_PDM_WD_EN_MASK |
 				 WSA884X_PDM_WD_CTL_HOLD_OFF_MASK |
