-/* Stop path for a future, explicitly armed post-PA transaction. Never
- * invoked from an IRQ or a SoundWire status notifier. Check readback even
- * if the PA write failed: a write error is not evidence that PA is off.
+/* The reference STOP is ordered, beginning with PA off. Continue the
+ * remaining containment writes on error and report the first failure.
+ */
+static int wsa884x_fullio_reference_stop(struct wsa884x_priv *amp)
+{
+	static const struct reg_sequence sequence[] = {
+		{ WSA884X_PA_FSM_EN, 0x00 },
+		{ WSA884X_INTR_MASK0, 0xff },
+		{ WSA884X_INTR_MASK1, 0x03 },
+		{ WSA884X_INTR_CLEAR0, 0xff },
+		{ WSA884X_INTR_CLEAR1, 0x03 },
+		{ WSA884X_CLSH_CTL_0, 0x00 },
+	};
+	int first = 0;
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(sequence); ++i) {
+		int ret = regmap_write(amp->regmap, sequence[i].reg, sequence[i].def);
+
+		if (!first && ret)
+			first = ret;
+	}
+	return first;
+}
