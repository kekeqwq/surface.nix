index 0000000..f45500f
--- /dev/null
+++ b/drivers/hid/surface-hid/denali_hhkb.h
@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef _SURFACE_DENALI_HHKB_H
+#define _SURFACE_DENALI_HHKB_H
+
+#define DENALI_KBD_REPORT 0x01
+#define DENALI_KBD_SIZE 12
+#define DENALI_EJECT_REPORT 0x7f
+#define DENALI_EJECT_USAGE 0xff /* Internal only. */
+#define DENALI_RIGHT 0x4f
+
+struct denali_hhkb {
+	u8 held[256]; /* Mapping selected on physical key-down. */
+	bool enabled;
+	bool eject_sent;
+};
+
+/* Studio US Profile2, using the stock Surface number row and Backspace. */
+static inline u8 denali_hhkb_layer(u8 usage)
+{
+	static const u8 fn[] = {
+		[0x04] = 0x81, [0x07] = 0x7f, /* A: quieter, D: mute */
+		[0x09] = DENALI_EJECT_USAGE, /* F: Eject */
+		[0x0b] = 0x55, [0x0c] = 0x46, [0x0d] = 0x54, /* H I J */
+		[0x0e] = 0x4a, [0x0f] = 0x4b, [0x10] = 0x56, /* K L M */
+		[0x11] = 0x57, [0x12] = 0x47, [0x13] = 0x48, /* N O P */
+		[0x16] = 0x80, /* S: louder */
+		[0x28] = 0x58, [0x29] = 0x66, /* Enter: keypad, Esc: Power */
+		[0x2a] = 0x53, [0x2b] = 0x39, /* Backspace: keypad Clear, Tab: Caps */
+		[0x2f] = 0x52, [0x31] = 0x49, /* [: Up, backslash: Insert */
+		[0x33] = 0x50, [0x34] = 0x4f, /* ; ' */
+		[0x35] = 0x4c, /* Grave: Forward Delete */
+		[0x36] = 0x4d, [0x37] = 0x4e, [0x38] = 0x51, /* , . / */
+	};
+
+	if (usage >= 0x1e && usage <= 0x27)
+		return 0x3a + usage - 0x1e;
+	if (usage == 0x2d || usage == 0x2e)
+		return 0x44 + usage - 0x2d;
+	return usage < sizeof(fn) && fn[usage] ? fn[usage] : usage;
+}
+
+/* Translate one complete ten-slot keyboard snapshot. */
+static inline bool denali_hhkb_translate(struct denali_hhkb *state, const u8 *in,
+				  u8 *out, bool *eject)
+{
+	bool physical[256] = { false };
+	bool emitted[256] = { false };
+	bool fn;
+	u8 mods;
+	unsigned int i, n = 2;
+
+	for (i = 2; i < DENALI_KBD_SIZE; i++) {
+		if ((in[i] && in[i] < 4) || in[i] > 0x91)
+			return false; /* Rollover or unknown slot value. */
+		physical[in[i]] = true;
+	}
+	fn = physical[DENALI_RIGHT];
+	for (i = 4; i < sizeof(state->held); i++) {
+		if (!physical[i])
+			state->held[i] = 0;
+	}
+
+	out[0] = DENALI_KBD_REPORT;
+	mods = in[1];
+	/* Drop physical left Ctrl and exchange the two left Alt/Super keys. */
+	out[1] = (mods & ~0x0d) | ((mods & 0x04) << 1) | ((mods & 0x08) >> 1);
+	if (physical[0x39])
+		out[1] |= 0x01;
+	*eject = false;
+	for (i = 2; i < DENALI_KBD_SIZE; i++) {
+		u8 key = in[i];
+		u8 mapped;
+
+		/* Right is Fn; the other physical arrows never emit. */
+		if (!key || key == 0x39 || (key >= 0x4f && key <= 0x52))
+			continue;
+		mapped = state->held[key];
+		if (!mapped) {
+			mapped = fn ? denali_hhkb_layer(key) : key;
+			state->held[key] = mapped;
+		}
+		if (mapped == DENALI_EJECT_USAGE)
+			*eject = true;
+		else if (!emitted[mapped]) {
+			out[n++] = mapped;
+			emitted[mapped] = true;
+		}
+	}
+	while (n < DENALI_KBD_SIZE)
+		out[n++] = 0;
+	return true;
+}
+#endif
