diff --git a/drivers/hid/surface-hid/denali_hhkb.h b/drivers/hid/surface-hid/denali_hhkb.h
new file mode 100644
index 0000000..80c5bc6
--- /dev/null
+++ b/drivers/hid/surface-hid/denali_hhkb.h
@@ -0,0 +1,201 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef _SURFACE_DENALI_HHKB_H
+#define _SURFACE_DENALI_HHKB_H
+
+#define DENALI_KBD_REPORT 0x01
+#define DENALI_KBD_SIZE 12
+#define DENALI_KBD_OUT_SIZE (DENALI_KBD_SIZE + 12)
+#define DENALI_EJECT_REPORT 0x7f
+#define DENALI_EJECT_USAGE 0xff /* Internal only. */
+#define DENALI_RIGHT 0x4f
+
+struct denali_hhkb {
+	u8 held[256]; /* Mapping selected on physical key-down. */
+	u8 keyboard[DENALI_KBD_SIZE];
+	u16 row_keyboard, row_aux, row_held, row_fn;
+	u16 consumer_other, consumer_sent;
+	bool enabled, eject_sent, mic_sent, backlight_sent;
+};
+
+/* Studio US Profile2, using the stock Surface number row and Backspace. */
+static inline u8 denali_hhkb_layer(u8 usage)
+{
+	static const u8 fn[] = {
+		[0x04] = 0x81, [0x07] = 0x7f, /* A: quieter, D: mute */
+		[0x09] = DENALI_EJECT_USAGE, /* F: Eject */
+		[0x0b] = 0x55, [0x0c] = 0x46, [0x0d] = 0x54, /* H I J */
+		[0x0e] = 0x4a, [0x0f] = 0x4b, [0x10] = 0x56, /* K L M */
+		[0x11] = 0x57, [0x12] = 0x47, [0x13] = 0x48, /* N O P */
+		[0x16] = 0x80, /* S: louder */
+		[0x28] = 0x58, [0x29] = 0x66, /* Enter: keypad, Esc: Power */
+		[0x2a] = 0x53, [0x2b] = 0x39, /* Backspace: keypad Clear, Tab: Caps */
+		[0x2f] = 0x52, [0x31] = 0x49, /* [: Up, backslash: Insert */
+		[0x33] = 0x50, [0x34] = 0x4f, /* ; ' */
+		[0x35] = 0x4c, /* Grave: Forward Delete */
+		[0x36] = 0x4d, [0x37] = 0x4e, [0x38] = 0x51, /* , . / */
+	};
+
+	if (usage >= 0x1e && usage <= 0x27)
+		return 0x3a + usage - 0x1e;
+	if (usage == 0x2d || usage == 0x2e)
+		return 0x44 + usage - 0x2d;
+	return usage < sizeof(fn) && fn[usage] ? fn[usage] : usage;
+}
+
+/* Translate one complete ten-slot keyboard snapshot. */
+static inline bool denali_hhkb_translate(struct denali_hhkb *state, const u8 *in,
+				  u8 *out, bool *eject)
+{
+	bool physical[256] = { false };
+	bool emitted[256] = { false };
+	bool fn;
+	u8 mods;
+	unsigned int i, n = 2;
+
+	for (i = 2; i < DENALI_KBD_SIZE; i++) {
+		if ((in[i] && in[i] < 4) || in[i] > 0x91)
+			return false; /* Rollover or unknown slot value. */
+		physical[in[i]] = true;
+	}
+	fn = physical[DENALI_RIGHT];
+	for (i = 4; i < sizeof(state->held); i++) {
+		if (!physical[i])
+			state->held[i] = 0;
+	}
+
+	out[0] = DENALI_KBD_REPORT;
+	mods = in[1];
+	/* Drop physical left Ctrl and exchange the two left Alt/Super keys. */
+	out[1] = (mods & ~0x0d) | ((mods & 0x04) << 1) | ((mods & 0x08) >> 1);
+	if (physical[0x39])
+		out[1] |= 0x01;
+	*eject = false;
+	for (i = 2; i < DENALI_KBD_SIZE; i++) {
+		u8 key = in[i];
+		u8 mapped;
+
+		/* Right is Fn; the other physical arrows never emit. */
+		if (!key || key == 0x39 || (key >= 0x4f && key <= 0x52))
+			continue;
+		mapped = state->held[key];
+		if (!mapped) {
+			mapped = fn ? denali_hhkb_layer(key) : key;
+			state->held[key] = mapped;
+		}
+		if (mapped == DENALI_EJECT_USAGE)
+			*eject = true;
+		else if (!emitted[mapped]) {
+			out[n++] = mapped;
+			emitted[mapped] = true;
+		}
+	}
+	while (n < DENALI_KBD_SIZE)
+		out[n++] = 0;
+	return true;
+}
+
+/* Top-row positions on the matched transport. The physical row can be
+ * reported as keyboard F1–F12, or as a mix of keyboard and auxiliary usages.
+ */
+static inline bool denali_hhkb_snapshot(struct denali_hhkb *s, const u8 *data)
+{
+	static const u8 base[] = { 0x46, 0x4a, 0x4d, 0x4b, 0x4e };
+	u16 row = 0;
+	unsigned int i, j;
+
+	for (i = 2; i < DENALI_KBD_SIZE; i++)
+		if ((data[i] && data[i] < 4) || data[i] > 0x91)
+			return false;
+	for (i = 0; i < DENALI_KBD_SIZE; i++) {
+		u8 key = data[i];
+		int position = -1;
+
+		if (i >= 2) {
+			if (key >= 0x3a && key <= 0x45)
+				position = key - 0x3a;
+			else
+				for (j = 0; j < sizeof(base); j++)
+					if (key == base[j])
+						position = 7 + j;
+		}
+		s->keyboard[i] = position < 0 ? key : 0;
+		if (position >= 0)
+			row |= 1U << position;
+	}
+	s->row_keyboard = row;
+	return true;
+}
+
+static inline void denali_hhkb_consumer(struct denali_hhkb *s, u16 usage)
+{
+	static const u16 usages[] = { 0x00e2, 0x00ea, 0x00e9, 0, 0x0070, 0x006f };
+	unsigned int i;
+
+	s->row_aux &= ~0x006e;
+	s->consumer_other = usage;
+	for (i = 0; i < sizeof(usages) / sizeof(*usages); i++) {
+		if (!usage || usage != usages[i])
+			continue;
+		s->row_aux |= 1U << (i + 1);
+		s->consumer_other = 0;
+		break;
+	}
+}
+
+static inline void denali_hhkb_top_button(struct denali_hhkb *s, unsigned int pos, bool down)
+{
+	if (down)
+		s->row_aux |= 1U << pos;
+	else
+		s->row_aux &= ~(1U << pos);
+}
+
+static inline void denali_hhkb_outputs(struct denali_hhkb *s, u8 *out,
+				       bool *eject, bool *mic, bool *backlight, u16 *consumer)
+{
+	static const u16 base[] = { 0, 0xe2, 0xea, 0xe9, 0, 0x70, 0x6f,
+				    0x46, 0x4a, 0x4d, 0x4b, 0x4e };
+	u16 row = s->row_keyboard | s->row_aux;
+	u16 normal;
+	unsigned int i, j, n = 2;
+	bool fn = false;
+
+	for (i = 2; i < DENALI_KBD_SIZE; i++)
+		if (s->keyboard[i] == DENALI_RIGHT)
+			fn = true;
+	s->row_fn &= row;
+	if (fn)
+		s->row_fn |= row & ~s->row_held;
+	s->row_held = row;
+	normal = row & ~s->row_fn;
+	*mic = normal & 1;
+	*backlight = normal & 0x10;
+	*consumer = s->consumer_other;
+	denali_hhkb_translate(s, s->keyboard, out, eject);
+	while (n < DENALI_KBD_SIZE && out[n])
+		n++;
+	for (i = 0; i < sizeof(base) / sizeof(*base); i++) {
+		u8 key;
+		u16 bit = 1U << i;
+
+		if (!(row & bit))
+			continue;
+		if (s->row_fn & bit)
+			key = 0x3a + i;
+		else if (i >= 7)
+			key = base[i];
+		else {
+			if (!*consumer)
+				*consumer = base[i];
+			continue;
+		}
+		for (j = 2; j < n; j++)
+			if (out[j] == key)
+				break;
+		if (j == n)
+			out[n++] = key;
+	}
+	while (n < DENALI_KBD_OUT_SIZE)
+		out[n++] = 0;
+}
+#endif
