diff --git a/drivers/hid/surface-hid/surface_hid_core.c b/drivers/hid/surface-hid/surface_hid_core.c
index 6690c24..6a9b8b2 100644
--- a/drivers/hid/surface-hid/surface_hid_core.c
+++ b/drivers/hid/surface-hid/surface_hid_core.c
@@ -11,12 +11,109 @@
 #include <linux/hid.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/types.h>
 #include <linux/usb/ch9.h>
 
 #include <linux/surface_aggregator/controller.h>
 
 #include "surface_hid_core.h"
+#include "denali_hhkb_descriptor.h"
+
+static bool denali_hhkb;
+module_param(denali_hhkb, bool, 0444);
+MODULE_PARM_DESC(denali_hhkb, "Enable HHKB layer on the verified Denali OLED keyboard");
+
+/* Separate from the physical consumer-control report, so simultaneous
+ * top-row media keys cannot be released by Fn+F (or vice versa).
+ */
+static const u8 denali_hhkb_eject_descriptor[] = {
+	0x05, 0x0c, 0x09, 0x01, 0xa1, 0x01, 0x85, DENALI_EJECT_REPORT,
+	0x15, 0x00, 0x25, 0x01, 0x09, 0xb8, 0x75, 0x01, 0x95, 0x01,
+	0x81, 0x02, 0x75, 0x07, 0x81, 0x03, 0xc0,
+};
+
+static bool denali_hhkb_candidate(struct surface_hid_device *shid, size_t len)
+{
+	return denali_hhkb && shid->hid->vendor == 0x045e && shid->hid->product == 0x09ae &&
+	       shid->uid.domain == 0x01 && shid->uid.category == 0x15 &&
+	       shid->uid.target == 0x02 && shid->uid.instance == 0x01 &&
+	       shid->uid.function == 0x00 && len == sizeof(denali_hhkb_descriptor) &&
+	       of_machine_is_compatible("microsoft,denali-oled");
+}
+
+void surface_hid_input_report(struct surface_hid_device *shid, const u8 *data, size_t len)
+{
+	struct denali_hhkb *state = &shid->hhkb;
+	u8 out[DENALI_KBD_OUT_SIZE + 7] = { 0 };
+	u8 aux[3 + 7] = { 0 };
+	bool eject, mic, backlight;
+	u16 consumer;
+
+	if (!state->enabled || !len)
+		goto passthrough;
+
+	switch (data[0]) {
+	case DENALI_EJECT_REPORT:
+		return; /* This ID is generated only by the Fn layer. */
+	case DENALI_KBD_REPORT:
+		if (len != DENALI_KBD_SIZE || !denali_hhkb_snapshot(state, data))
+			return;
+		break;
+	case 0x03:
+		if (len != 3)
+			return;
+		denali_hhkb_consumer(state, get_unaligned_le16(data + 1));
+		break;
+	case 0x5e:
+	case 0xd5:
+		if (len != 2 || data[1] > 1)
+			return;
+		denali_hhkb_top_button(state, data[0] == 0x5e ? 0 : 4, data[1]);
+		break;
+	case 0x5b:
+		if (len != 2)
+			return;
+		aux[0] = 0x5b;
+		aux[1] = data[1] & ~1; /* Suppress old Fn, not adjacent system bits. */
+		hid_input_report(shid->hid, HID_INPUT_REPORT, aux, 2, 0);
+		return;
+	default:
+		goto passthrough;
+	}
+
+	denali_hhkb_outputs(state, out, &eject, &mic, &backlight, &consumer);
+	hid_input_report(shid->hid, HID_INPUT_REPORT, out, DENALI_KBD_OUT_SIZE, 0);
+	if (consumer != state->consumer_sent) {
+		aux[0] = 0x03;
+		put_unaligned_le16(consumer, aux + 1);
+		if (!hid_input_report(shid->hid, HID_INPUT_REPORT, aux, 3, 0))
+			state->consumer_sent = consumer;
+	}
+	if (mic != state->mic_sent) {
+		aux[0] = 0x5e;
+		aux[1] = mic;
+		if (!hid_input_report(shid->hid, HID_INPUT_REPORT, aux, 2, 0))
+			state->mic_sent = mic;
+	}
+	if (backlight != state->backlight_sent) {
+		aux[0] = 0xd5;
+		aux[1] = backlight;
+		if (!hid_input_report(shid->hid, HID_INPUT_REPORT, aux, 2, 0))
+			state->backlight_sent = backlight;
+	}
+	if (eject != state->eject_sent) {
+		aux[0] = DENALI_EJECT_REPORT;
+		aux[1] = eject;
+		if (!hid_input_report(shid->hid, HID_INPUT_REPORT, aux, 2, 0))
+			state->eject_sent = eject;
+	}
+	return;
+
+passthrough:
+	hid_input_report(shid->hid, HID_INPUT_REPORT, (u8 *)data, len, 0);
+}
+EXPORT_SYMBOL_GPL(surface_hid_input_report);
 
 
 /* -- Utility functions. ---------------------------------------------------- */
@@ -136,17 +233,28 @@ static int surface_hid_parse(struct hid_device *hid)
 {
 	struct surface_hid_device *shid = hid->driver_data;
 	size_t len = get_unaligned_le16(&shid->hid_desc.report_desc_len);
+	bool candidate = denali_hhkb_candidate(shid, len);
+	size_t extra = candidate ? sizeof(denali_hhkb_eject_descriptor) : 0;
 	u8 *buf;
 	int status;
 
 	if (surface_hid_is_hot_removed(shid))
 		return -ENODEV;
 
-	buf = kzalloc(len, GFP_KERNEL);
+	buf = kzalloc(len + extra, GFP_KERNEL);
 	if (!buf)
 		return -ENOMEM;
 
 	status = shid->ops.get_descriptor(shid, SURFACE_HID_DESC_REPORT, buf, len);
+	if (!status && candidate && !memcmp(buf, denali_hhkb_descriptor, len)) {
+		/* Enlarge report 1's verified ten-slot array for synthetic F keys.
+		 * Keeping one keyboard array also deduplicates Fn+number and Fn+F.
+		 */
+		buf[27] = DENALI_KBD_OUT_SIZE - 2;
+		memcpy(buf + len, denali_hhkb_eject_descriptor, extra);
+		len += extra;
+		shid->hhkb.enabled = true;
+	}
 	if (!status)
 		status = hid_parse_report(hid, buf, len);
 
