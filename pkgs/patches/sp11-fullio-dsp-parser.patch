+static const struct snd_soc_tplg_vendor_array *
+audioreach_find_word_array(const struct snd_soc_tplg_private *private, u32 token)
+{
+	const u8 *data = private->data;
+	size_t remaining = le32_to_cpu(private->size), size;
+	u32 type;
+
+	while (remaining) {
+		const struct snd_soc_tplg_vendor_array *array = (const void *)data;
+		u32 i;
+
+		if (audioreach_private_record(data, remaining, &type, &size))
+			return NULL;
+		if (type == SND_SOC_TPLG_TUPLE_TYPE_WORD) {
+			for (i = 0; i < le32_to_cpu(array->num_elems); i++)
+				if (le32_to_cpu(array->value[i].token) == token)
+					return array;
+		}
+		data += size;
+		remaining -= size;
+	}
 	return NULL;
