+static int q6apm_fullio_dsp_prepare_audit(struct q6apm_graph *graph, struct snd_soc_card *card)
+{
+	struct device_node *node = card->dev->of_node;
+	int ret;
+
+	if (!of_property_read_bool(node, "microsoft,denali-fullio-dsp-prepare-audit"))
+		return 0;
+	if (!of_property_read_bool(node, "microsoft,denali-fullio-clock-off-audit") ||
+	    of_property_read_bool(node, "microsoft,denali-fullio-post-pa-test") ||
+	    !graph->ar_graph || READ_ONCE(graph->ar_graph->start_count) ||
+	    !q6apm_fullio_transport_enabled(graph->apm))
+		return -EPERM;
+	ret = q6apm_fullio_both_pa_off(card);
+	if (ret)
+		return ret;
+	/* No start, trigger, fragment writes or unmute, even on success. */
+	ret = q6apm_graph_prepare(graph);
+	if (ret)
+		return dev_err_probe(graph->dev, ret, "FullIO muted GRAPH_PREPARE rejected\n");
+	ret = audioreach_fullio_verify_mute(graph);
+	if (ret)
+		return ret;
+	ret = q6apm_fullio_both_pa_off(card);
+	if (!ret)
+		dev_info(graph->dev, "FullIO mute survived GRAPH_PREPARE; no GRAPH_START\n");
+	return ret;
+}
