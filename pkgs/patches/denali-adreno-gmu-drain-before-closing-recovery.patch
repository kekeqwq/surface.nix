drm/msm: Allow recovery during the terminal submit drain

Park the scheduler before waiting, but give in-flight jobs the existing
wait window with recovery still available. Close and synchronize the
worker before force suspend, and recheck active_submits: a6xx recovery
can temporarily set it to zero while the GPU is not idle. The recheck
is also authoritative if the final job retired while recovery drained.

This only avoids a premature software stop; a remaining active job is
still a teardown blocker. The candidate remains build-only.

--- a/drivers/gpu/drm/msm/msm_drv.c
+++ b/drivers/gpu/drm/msm/msm_drv.c
@@ -184,11 +184,13 @@
 		/* Stop fault dumps before suspending or releasing GMU resources. */
 		if (!IS_ERR_OR_NULL(gpu->vm))
 			msm_iommu_gpu_close_faults(to_msm_vm(gpu->vm)->mmu);
-		msm_gpu_close_recovery(gpu);
-		if (pm_runtime_enabled(gpu_dev) &&
-		    !WARN_ON_ONCE(adreno_terminal_suspend(gpu_dev))) {
-			msm_gpu_release_irq(gpu);
-			msm_gpu_close_retire(gpu);
+		if (pm_runtime_enabled(gpu_dev)) {
+			if (!WARN_ON_ONCE(adreno_terminal_suspend(gpu_dev))) {
+				msm_gpu_release_irq(gpu);
+				msm_gpu_close_retire(gpu);
+			}
+		} else {
+			msm_gpu_close_recovery(gpu);
 		}
 		msm_devfreq_cleanup(gpu);
 	}
--- a/drivers/gpu/drm/msm/adreno/adreno_device.c
+++ b/drivers/gpu/drm/msm/adreno/adreno_device.c
@@ -384,8 +384,20 @@
 	suspend_scheduler(gpu);
 
 	remaining = wait_event_timeout(gpu->retire_event,
-				       gpu->active_submits == 0,
+				       READ_ONCE(gpu->active_submits) == 0,
 				       msecs_to_jiffies(1000));
+	if (terminal) {
+		/*
+		 * Give in-flight jobs a chance to recover while draining.
+		 * The recovery path can temporarily zero active_submits.
+		 * Check it again after the worker is fenced.
+		 */
+		msm_gpu_close_recovery(gpu);
+		mutex_lock(&gpu->active_lock);
+		remaining = gpu->active_submits == 0;
+		mutex_unlock(&gpu->active_lock);
+	}
+
 	if (remaining == 0) {
 		dev_err(dev, "Timeout waiting for GPU to suspend\n");
 		ret = -EBUSY;
