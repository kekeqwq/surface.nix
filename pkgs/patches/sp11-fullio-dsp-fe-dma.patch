Subject: [EXPERIMENT] ASoC: q6apm-dai: own FullIO calibration DMA in the PCM frontend

Allocate only for the identified Denali pull-mode graph with both transports
enabled. Retain a possibly DSP-owned buffer until reboot and cap the number
per APM instance to one. Continue to refuse playback before calibration.

diff --git a/sound/soc/qcom/qdsp6/q6apm-dai.c b/sound/soc/qcom/qdsp6/q6apm-dai.c
index afa4bb0..bd785b7 100644
--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -3,6 +3,7 @@
 
 #include <dt-bindings/firmware/qcom,scm.h>
 #include <dt-bindings/soc/qcom,gpr.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
 #include <linux/dma-mapping.h>
 #include <linux/err.h>
 #include <linux/firmware/qcom/qcom_scm.h>
@@ -12,6 +13,7 @@
 #include <linux/of.h>
 #include <linux/of_reserved_mem.h>
 #include <linux/platform_device.h>
+#include <linux/sizes.h>
 #include <linux/slab.h>
 #include <linux/spinlock.h>
 #include <sound/pcm.h>
@@ -72,7 +74,18 @@ enum stream_state {
 	Q6APM_STREAM_RUNNING,
 };
 
+/* Larger than the longest pinned v19c OOB stage. */
+#define FULLIO_CAL_DMA_SIZE SZ_16K
+
+struct q6apm_fullio_cal_buffer {
+	struct q6apm_fullio_oob_region region;
+	struct device *dma_dev;
+	dma_addr_t dma;
+	void *cpu;
+};
+
 struct q6apm_dai_rtd {
+	struct q6apm_fullio_cal_buffer *fullio_cal;
 	struct snd_pcm_substream *substream;
 	struct snd_compr_stream *cstream;
 	struct snd_codec codec;
@@ -320,6 +333,83 @@ static void event_handler_compr(uint32_t opcode, uint32_t token,
 	}
 }
 
+static void q6apm_fullio_release_cal(struct q6apm_dai_rtd *prtd)
+{
+	struct q6apm_fullio_cal_buffer *buf = prtd->fullio_cal;
+	struct q6apm *apm = prtd->graph->apm;
+	int ret = 0;
+
+	if (!buf)
+		return;
+	prtd->fullio_cal = NULL;
+	if (buf->region.handle && !buf->region.poisoned)
+		ret = q6apm_fullio_oob_unmap(apm, &buf->region);
+	if (ret || buf->region.poisoned) {
+		/* DSP ownership is uncertain. Retain memory AND the DMA device
+		 * reference, and never hand out a new slot for this APM instance.
+		 * The experimental path has no DSP reset/reclaim hook yet.
+		 */
+		apm->fullio_oob_quarantine = buf;
+		dev_err(buf->dma_dev, "FullIO calibration buffer quarantined; reboot to reclaim\n");
+		return;
+	}
+
+	dma_free_coherent(buf->dma_dev, FULLIO_CAL_DMA_SIZE, buf->cpu, buf->dma);
+	put_device(buf->dma_dev);
+	kfree(buf);
+	atomic_set(&apm->fullio_oob_claimed, 0);
+}
+
+static int q6apm_fullio_prepare_cal(struct q6apm_dai_data *pdata,
+				   struct q6apm_dai_rtd *prtd)
+{
+	struct q6apm_fullio_cal_buffer *buf;
+	struct q6apm *apm = prtd->graph->apm;
+	struct device *dev = pdata->dev;
+	int owner, ret;
+
+	if (!of_machine_is_compatible("microsoft,denali"))
+		return 0;
+	ret = q6apm_find_integrated_backend(dev, WSA_CODEC_DMA_RX_0, &owner);
+	if (ret == -ENOENT || (!ret && prtd->graph->id != owner))
+		return 0;
+	if (ret)
+		return ret;
+	if (!q6apm_is_graph_in_push_pull_mode(prtd->graph) || pdata->use_scm_assign)
+		return -EOPNOTSUPP;
+	if (!q6apm_fullio_transport_enabled(apm))
+		return -EAGAIN;
+	if (atomic_cmpxchg(&apm->fullio_oob_claimed, 0, 1))
+		return -EBUSY;
+
+	buf = kzalloc_obj(*buf);
+	if (!buf) {
+		ret = -ENOMEM;
+		goto release_claim;
+	}
+	buf->cpu = dma_alloc_coherent(dev, FULLIO_CAL_DMA_SIZE, &buf->dma, GFP_KERNEL);
+	if (!buf->cpu) {
+		kfree(buf);
+		ret = -ENOMEM;
+		goto release_claim;
+	}
+	buf->dma_dev = get_device(dev);
+	buf->region.size = FULLIO_CAL_DMA_SIZE;
+	buf->region.dsp_addr = buf->dma;
+	if (pdata->sid >= 0)
+		buf->region.dsp_addr |= (u64)pdata->sid << 32;
+	prtd->fullio_cal = buf;
+	ret = q6apm_fullio_oob_map(apm, &buf->region);
+	if (!ret)
+		ret = -EOPNOTSUPP; /* Calibration transaction is not enabled yet. */
+	q6apm_fullio_release_cal(prtd);
+	return ret;
+
+release_claim:
+	atomic_set(&apm->fullio_oob_claimed, 0);
+	return ret;
+}
+
 static int q6apm_dai_prepare(struct snd_soc_component *component,
 			     struct snd_pcm_substream *substream)
 {
@@ -387,6 +477,10 @@ static int q6apm_dai_prepare(struct snd_soc_component *component,
 		return ret;
 	}
 
+	ret = q6apm_fullio_prepare_cal(pdata, prtd);
+	if (ret)
+		return ret;
+
 	/* rate and channels are sent to audio driver */
 	ret = q6apm_graph_media_format_shmem(prtd->graph, &cfg);
 	if (ret < 0) {
@@ -581,6 +675,7 @@ static int q6apm_dai_close(struct snd_soc_component *component,
 		q6apm_free_fragments(prtd->graph, substream->stream);
 	}
 
+	q6apm_fullio_release_cal(prtd);
 	q6apm_graph_close(prtd->graph);
 	prtd->graph = NULL;
 	kfree(prtd);
diff --git a/sound/soc/qcom/qdsp6/q6apm.h b/sound/soc/qcom/qdsp6/q6apm.h
index c47135d..7e07efe 100644
--- a/sound/soc/qcom/qdsp6/q6apm.h
+++ b/sound/soc/qcom/qdsp6/q6apm.h
@@ -76,6 +76,9 @@ struct q6apm {
 	u32 fullio_oob_op;
 	u32 fullio_oob_handle;
 	int fullio_oob_status;
+	/* One owner per DSP; a quarantined buffer keeps this slot claimed. */
+	atomic_t fullio_oob_claimed;
+	struct q6apm_fullio_cal_buffer *fullio_oob_quarantine;
 	struct idr graph_idr;
 	struct idr graph_info_idr;
 	struct idr sub_graphs_idr;
