+static void q6apm_fullio_mute_invalidate_locked(struct q6apm_graph *graph)
+{
+	graph->fullio_mute_verified = false;
+	if (graph->fullio_mute_epoch != U64_MAX)
+		graph->fullio_mute_epoch++;
+}
+
+void q6apm_fullio_mute_invalidate(struct q6apm_graph *graph)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&graph->apm->fullio_oob_lock, flags);
+	q6apm_fullio_mute_invalidate_locked(graph);
+	spin_unlock_irqrestore(&graph->apm->fullio_oob_lock, flags);
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_mute_invalidate);
+
+int q6apm_fullio_mute_begin(struct q6apm_graph *graph, struct q6apm_fullio_mute_ticket *ticket)
+{
+	struct q6apm *apm = graph->apm;
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&apm->fullio_oob_lock, flags);
+	q6apm_fullio_mute_invalidate_locked(graph);
+	if (graph->fullio_mute_epoch == U64_MAX || apm->fullio_transport_epoch == U64_MAX)
+		ret = -EOVERFLOW;
+	else if (!q6apm_fullio_transport_enabled(apm))
+		ret = -EAGAIN;
+	else
+		*ticket = (struct q6apm_fullio_mute_ticket) {
+			.graph = graph,
+			.graph_epoch = graph->fullio_mute_epoch,
+			.transport_epoch = apm->fullio_transport_epoch,
+		};
+	spin_unlock_irqrestore(&apm->fullio_oob_lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_mute_begin);
+
+/* Commit only after stereo readback, PA-off checks and successful unmap. */
+int q6apm_fullio_mute_commit(struct q6apm_graph *graph,
+			   const struct q6apm_fullio_mute_ticket *ticket)
+{
+	struct q6apm *apm = graph->apm;
+	unsigned long flags;
+	int ret = -ESTALE;
+
+	spin_lock_irqsave(&apm->fullio_oob_lock, flags);
+	if (ticket->graph == graph && ticket->graph_epoch == graph->fullio_mute_epoch &&
+	    ticket->transport_epoch == apm->fullio_transport_epoch &&
+	    q6apm_fullio_transport_enabled(apm)) {
+		graph->fullio_mute_verified = true;
+		graph->fullio_mute_transport_epoch = ticket->transport_epoch;
+		ret = 0;
+	}
+	spin_unlock_irqrestore(&apm->fullio_oob_lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_mute_commit);
+
+/* Evidence only: callers must not treat this as protection clock permission. */
+bool q6apm_fullio_mute_is_verified(struct q6apm_graph *graph)
+{
+	struct q6apm *apm = graph->apm;
+	unsigned long flags;
+	bool verified;
+
+	spin_lock_irqsave(&apm->fullio_oob_lock, flags);
+	verified = graph->fullio_mute_verified &&
+		   graph->fullio_mute_transport_epoch == apm->fullio_transport_epoch &&
+		   q6apm_fullio_transport_enabled(apm);
+	spin_unlock_irqrestore(&apm->fullio_oob_lock, flags);
+	return verified;
+}
+EXPORT_SYMBOL_GPL(q6apm_fullio_mute_is_verified);
