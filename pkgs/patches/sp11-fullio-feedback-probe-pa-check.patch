Subject: [EXPERIMENT] ASoC: verify both PAs off before feedback capture

Capture fixtures have only the selected feedback link, not a WSA Playback
link. Verify hardware PA-off for both codecs there before preparing.

diff --git a/sound/soc/qcom/qdsp6/q6apm-dai.c b/sound/soc/qcom/qdsp6/q6apm-dai.c
index 4cb69ff..7225abf 100644
--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -370,16 +370,41 @@ static int wsa884x_fullio_pa_off(struct snd_soc_component *component)
 }
 #endif
 
+static int q6apm_feedback_probe_rate(struct snd_soc_card *card)
+{
+	struct device_node *node = card->dev->of_node;
+	const char *probe;
+	const char *property = "microsoft,denali-fullio-feedback-probe";
+
+	if (!of_property_present(node, property))
+		return 0;
+	if (!of_machine_is_compatible("microsoft,denali") ||
+	    !of_property_read_bool(node, "microsoft,denali-fullio-muted-test") ||
+	    of_property_read_string(node, property, &probe))
+		return -EINVAL;
+	if (!strcmp(probe, "vi"))
+		return 8000;
+	if (!strcmp(probe, "cps"))
+		return 24000;
+	return -EINVAL;
+}
+
 static int q6apm_fullio_both_pa_off(void *ctx)
 {
 	struct snd_soc_card *card = ctx;
 	struct snd_soc_pcm_runtime *rtd;
 	struct snd_soc_dai *codec;
+	const char *link = "WSA Playback";
 	unsigned int seen = 0, bit;
-	int i, ret;
+	int i, ret, probe_rate = q6apm_feedback_probe_rate(card);
+
+	if (probe_rate < 0)
+		return probe_rate;
+	if (probe_rate)
+		link = probe_rate == 8000 ? "WSA VI Protection" : "WSA CPS Protection";
 
 	for_each_card_rtds(card, rtd) {
-		if (strcmp(rtd->dai_link->name, "WSA Playback"))
+		if (strcmp(rtd->dai_link->name, link))
 			continue;
 		for_each_rtd_codec_dais(rtd, i, codec) {
 			const char *prefix = codec->component->name_prefix;
@@ -505,6 +530,17 @@ static int q6apm_dai_prepare(struct snd_soc_component *component,
 	cfg.bit_width = prtd->bits_per_sample;
 	cfg.fmt = SND_AUDIOCODEC_PCM;
 	audioreach_set_default_channel_mapping(cfg.channel_map, runtime->channels);
+	ret = q6apm_feedback_probe_rate(component->card);
+	if (ret < 0)
+		return ret;
+	if (ret) {
+		if (substream->stream != SNDRV_PCM_STREAM_CAPTURE ||
+		    cfg.sample_rate != ret || cfg.bit_width != 32 || cfg.num_channels != 2)
+			return -EINVAL;
+		ret = q6apm_fullio_both_pa_off(component->card);
+		if (ret)
+			return dev_err_probe(dev, ret, "FullIO feedback probe requires both PAs off\n");
+	}
 	if (prtd->state) {
 		/* clear the previous setup if any  */
 		q6apm_graph_stop(prtd->graph);
@@ -639,25 +675,6 @@ static int q6apm_dai_trigger(struct snd_soc_component *component,
 	return ret;
 }
 
