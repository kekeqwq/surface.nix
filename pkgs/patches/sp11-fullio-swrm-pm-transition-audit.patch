 }
 
+/*
+ * Observe the original transition; never clear, suppress or retry a clash
+ * from the diagnostic. The status registers are distinct from IRQ CLEAR.
+ */
+static void swrm_fullio_pm_snapshot(struct qcom_swrm_ctrl *ctrl,
+				    const char *stage, int transition_ret)
+{
+	u32 irq_status, frame_status, slave_status;
+	int irq_ret, frame_ret, slave_ret;
+
+	if (!qcom_swrm_fullio_pm_audit(ctrl))
+		return;
+
+	irq_ret = ctrl->reg_read(ctrl, ctrl->reg_layout[SWRM_REG_INTERRUPT_STATUS],
+				 &irq_status);
+	frame_ret = ctrl->reg_read(ctrl, ctrl->reg_layout[SWRM_REG_FRAME_GEN_ENABLED],
+				   &frame_status);
+	slave_ret = ctrl->reg_read(ctrl, SWRM_MCP_SLV_STATUS, &slave_status);
+	if (irq_ret || frame_ret || slave_ret) {
+		dev_warn(ctrl->dev,
+			 "FullIO PM transition %s: status unavailable irq=%d frame=%d slave=%d result=%d\n",
+			 stage, irq_ret, frame_ret, slave_ret, transition_ret);
+		return;
+	}
+	dev_info(ctrl->dev, "FullIO PM transition %s: clash=%d frame=%d result=%d slaves=0x%08x\n",
+		 stage, !!(irq_status & SWRM_INTERRUPT_STATUS_MASTER_CLASH_DET),
+		 !!(frame_status & SWRM_FRM_GEN_ENABLED), transition_ret, slave_status);
+}
+
