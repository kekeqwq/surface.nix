Subject: [EXPERIMENT] soundwire: qcom: observe the Denali clock-stop transition

The idle WSA wake reported bus clash before codec regcache replay.
Sample latched clash, frame and slave state at existing clock-stop
boundaries, plus slave-status IRQ transitions. Do not change IRQ mask,
clock start, reset, PM policy, or status return behavior.

--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -636,6 +636,13 @@
 	return SDW_CMD_IGNORED;
 }
 
+static bool qcom_swrm_fullio_pm_audit(struct qcom_swrm_ctrl *ctrl)
+{
+	return !ctrl->clock_stop_not_supported &&
+	       of_machine_is_compatible("microsoft,denali") &&
+	       of_property_read_bool(ctrl->dev->of_node, "qcom,denali-fullio-pm-transition-audit");
+}
+
 static int qcom_swrm_get_alert_slave_dev_num(struct qcom_swrm_ctrl *ctrl)
 {
