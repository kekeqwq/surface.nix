@@ -647,6 +654,9 @@
 		status = (val >> (dev_num * SWRM_MCP_SLV_STATUS_SZ));
 
 		if ((status & SWRM_MCP_SLV_STATUS_MASK) == SDW_SLAVE_ALERT) {
+			if (qcom_swrm_fullio_pm_audit(ctrl))
+				dev_info_ratelimited(ctrl->dev, "FullIO PM transition alert: dev=%d slaves=0x%08x\n",
+						     dev_num, val);
 			ctrl->status[dev_num] = status & SWRM_MCP_SLV_STATUS_MASK;
 			return dev_num;
 		}
@@ -812,6 +822,10 @@
 					dev_dbg(ctrl->dev, "Slave status not changed %x\n",
 						slave_status);
 				} else {
+					if (qcom_swrm_fullio_pm_audit(ctrl))
+						dev_info_ratelimited(ctrl->dev,
+							"FullIO PM transition enum: slaves=0x%08x->0x%08x\n",
+							ctrl->slave_status, slave_status);
 					qcom_swrm_get_device_status(ctrl);
