Subject: [EXPERIMENT] ASoC: verify the final FullIO mute by readback

Try a single explicitly sized VOL_CTRL GET_CFG after acknowledged mute.
If unsupported or different, fail closed. No PA enable or start command.

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index d85221a..2a0a680 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -336,6 +336,7 @@ static int audioreach_fullio_acknowledge_mute(struct q6apm_graph *graph,
 		[10] = cpu_to_le32(1),
 	};
 	const struct audioreach_module_priv_data *stage = stages->stage[AR_FULLIO_MUTE];
+	u8 actual[sizeof(mute) - APM_MODULE_PARAM_DATA_SIZE];
 	int ret;
 
 	if (!stage || le32_to_cpu(stage->size) != sizeof(mute) ||
@@ -346,6 +347,13 @@ static int audioreach_fullio_acknowledge_mute(struct q6apm_graph *graph,
 	if (ret)
 		return dev_err_probe(graph->dev, ret, "FullIO endpoint stereo mute rejected\n");
 	dev_info(graph->dev, "FullIO endpoint stereo mute acknowledged\n");
+
+	ret = q6apm_fullio_get_cfg(graph, 0x4a63, 0x08001039, actual, sizeof(actual));
+	if (ret)
+		return dev_err_probe(graph->dev, ret, "FullIO endpoint stereo mute not readable\n");
+	if (memcmp((const u8 *)mute + APM_MODULE_PARAM_DATA_SIZE, actual, sizeof(actual)))
+		return dev_err_probe(graph->dev, -EILSEQ, "FullIO endpoint stereo mute mismatch\n");
+	dev_info(graph->dev, "FullIO endpoint stereo mute readback verified\n");
 	return 0;
 }
 
diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 160c87b..7681699 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -358,7 +358,8 @@ int q6apm_fullio_get_cfg(struct q6apm_graph *graph, u32 instance, u32 param,
 
 	if (!graph->ar_graph || !graph->port || !data ||
 	    !((instance == 0x4027 && param == 0x080011e8 && bytes == 68) ||
-	      (instance == 0x4024 && param == 0x080011f6 && bytes == 44)))
+	      (instance == 0x4024 && param == 0x080011f6 && bytes == 44) ||
+	      (instance == 0x4a63 && param == 0x08001039 && bytes == 104)))
 		return -EINVAL;
 	if (!q6apm_fullio_transport_enabled(graph->apm))
 		return -EAGAIN;
