Subject: [EXPERIMENT] ASoC: add checked post-PA protection clock transaction

Keep the WSA TX clock sequence card-local and require a readiness check
before and after writes. Verify readback and exhaust teardown on errors.
There is no caller or DT opt-in; this cannot release speaker mute.

diff --git a/sound/soc/codecs/lpass-wsa-macro.c b/sound/soc/codecs/lpass-wsa-macro.c
index 0f223df..c5eecc1 100755
--- a/sound/soc/codecs/lpass-wsa-macro.c
+++ b/sound/soc/codecs/lpass-wsa-macro.c
@@ -398,6 +398,9 @@ struct wsa_reg_layout {
 };
 
 struct wsa_macro {
+	struct mutex fullio_clock_lock;
+	bool fullio_clock_pm;
+	bool fullio_clock_fault;
 	struct device *dev;
 	int comp_enabled[WSA_MACRO_COMP_MAX];
 	int ec_hq[WSA_MACRO_RX1 + 1];
@@ -1598,6 +1601,102 @@ static void wsa_macro_enable_disable_vi_sense(struct snd_soc_component *componen
 	}
 }
 
+static const struct snd_soc_component_driver wsa_macro_component_drv;
+static const unsigned int fullio_tx_regs[] = {
+	CDC_WSA_TX0_SPKR_PROT_PATH_CTL, CDC_WSA_TX1_SPKR_PROT_PATH_CTL,
+	CDC_WSA_TX2_SPKR_PROT_PATH_CTL, CDC_WSA_TX3_SPKR_PROT_PATH_CTL,
+};
+
+static int wsa_macro_fullio_tx_update(struct wsa_macro *wsa, unsigned int mask,
+				     unsigned int value, bool exhaustive)
+{
+	int first_error = 0, ret;
+	unsigned int i, actual;
+
+	for (i = 0; i < ARRAY_SIZE(fullio_tx_regs); i++) {
+		ret = regmap_update_bits(wsa->regmap, fullio_tx_regs[i], mask, value);
+		if (!ret)
+			ret = regmap_read_bypassed(wsa->regmap, fullio_tx_regs[i], &actual);
+		if (!ret && (actual & mask) != value)
+			ret = -EIO;
+		if (ret && !first_error)
+			first_error = ret;
+		if (ret && !exhaustive)
+			break;
+	}
+	return first_error;
+}
+
+static bool wsa_macro_fullio_post_pa_probe(struct snd_soc_component *component)
+{
+	return component->card && of_machine_is_compatible("microsoft,denali") &&
+	       of_property_read_bool(component->card->dev->of_node,
+				     "microsoft,denali-fullio-post-pa-test");
+}
+
+/* Only a future card-local coordinator can supply hardware/mute verification.
+ * There is deliberately no caller and no board opt-in in this patch.
+ */
+int wsa_macro_fullio_protclk(struct snd_soc_component *component, bool enable,
+			    int (*verify_ready)(void *ctx), void *ctx);
+int wsa_macro_fullio_protclk(struct snd_soc_component *component, bool enable,
+			    int (*verify_ready)(void *ctx), void *ctx)
+{
+	struct wsa_macro *wsa;
+	int ret, cleanup;
+
+	if (!component || component->driver != &wsa_macro_component_drv ||
+	    !wsa_macro_fullio_post_pa_probe(component))
+		return -EOPNOTSUPP;
+	wsa = snd_soc_component_get_drvdata(component);
+	guard(mutex)(&wsa->fullio_clock_lock);
+	if (!enable && !wsa->fullio_clock_pm)
+		return 0;
+	if (enable) {
+		if (!verify_ready || wsa->fullio_clock_fault)
+			return -EPERM;
+		ret = verify_ready(ctx);
+		if (ret)
+			return ret;
+		if (wsa->fullio_clock_pm)
+			return -EBUSY;
+		ret = pm_runtime_resume_and_get(wsa->dev);
+		if (ret < 0)
+			return ret;
+		wsa->fullio_clock_pm = true;
+		ret = wsa_macro_fullio_tx_update(wsa, CDC_WSA_TX_SPKR_PROT_RESET_MASK,
+						 CDC_WSA_TX_SPKR_PROT_RESET, false);
+		if (!ret)
+			ret = wsa_macro_fullio_tx_update(wsa, CDC_WSA_TX_SPKR_PROT_PCM_RATE_MASK,
+							 CDC_WSA_TX_SPKR_PROT_PCM_RATE_8K, false);
+		if (!ret)
+			ret = wsa_macro_fullio_tx_update(wsa, CDC_WSA_TX_SPKR_PROT_CLK_EN_MASK,
+							 CDC_WSA_TX_SPKR_PROT_CLK_ENABLE, false);
+		if (!ret)
+			ret = wsa_macro_fullio_tx_update(wsa, CDC_WSA_TX_SPKR_PROT_RESET_MASK,
+							 CDC_WSA_TX_SPKR_PROT_NO_RESET, false);
+		if (!ret)
+			ret = verify_ready(ctx);
+		if (!ret)
+			return 0;
+	} else {
+		ret = 0;
+	}
+
+	cleanup = wsa_macro_fullio_tx_update(wsa, CDC_WSA_TX_SPKR_PROT_RESET_MASK |
+					     CDC_WSA_TX_SPKR_PROT_CLK_EN_MASK,
+					     CDC_WSA_TX_SPKR_PROT_RESET, true);
+	if (cleanup) {
+		wsa->fullio_clock_fault = true;
+		dev_err(wsa->dev, "FullIO protection clock shutdown unverified: %d\n", cleanup);
+		return ret ?: cleanup;
+	}
+	wsa->fullio_clock_pm = false;
+	pm_runtime_put_autosuspend(wsa->dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(wsa_macro_fullio_protclk);
+
