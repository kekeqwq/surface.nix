@@ -1632,6 +1731,10 @@ static int wsa_macro_enable_vi_feedback(struct snd_soc_dapm_widget *w,
 	struct wsa_macro *wsa = snd_soc_component_get_drvdata(component);
 	u32 rate_val;
 
+	/* The ordinary DAPM event is too early for the post-PA experiment. */
+	if (wsa_macro_fullio_post_pa_probe(component))
+		return 0;
+
 	switch (wsa->pcm_rate_vi) {
 	case 8000:
 		rate_val = CDC_WSA_TX_SPKR_PROT_PCM_RATE_8K;
@@ -2815,6 +2918,7 @@ static int wsa_macro_probe(struct platform_device *pdev)
 	wsa = devm_kzalloc_obj(dev, *wsa);
 	if (!wsa)
 		return -ENOMEM;
+	mutex_init(&wsa->fullio_clock_lock);
 
 	wsa->macro = devm_clk_get_optional(dev, "macro");
 	if (IS_ERR(wsa->macro))
