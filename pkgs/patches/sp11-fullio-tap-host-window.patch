Subject: [EXPERIMENT] ASoC: retain host time bounds of the FullIO taps audit

Use the host monotonic clock at START acknowledgement and before STOP.
Report bounds only for the taps fixture. No command or timing policy
changes; a matching receive interval does not itself prove DSP origin.

--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -15,6 +15,7 @@
 #include <linux/slab.h>
 #include <linux/sizes.h>
 #include <linux/soc/qcom/apr.h>
+#include <linux/timekeeping.h>
 #include <linux/wait.h>
 #include <sound/soc.h>
 #include <sound/soc-dapm.h>
@@ -1332,6 +1333,7 @@
 	struct device_node *node = card->dev->of_node;
 	struct audioreach_graph *ar = graph->ar_graph;
 	struct q6apm *apm = graph->apm;
+	u64 start_ack_ns = 0, stop_begin_ns;
 	int ret, stop;
 
 	if (!verify || !of_machine_is_compatible("microsoft,denali") ||
@@ -1354,6 +1356,7 @@
 	apm->fullio_start_audit_attempted = true;
 	ret = audioreach_graph_mgmt_transaction(ar, APM_CMD_GRAPH_START, true);
 	if (!ret) {
+		start_ack_ns = ktime_get_ns();
 		ret = verify(ctx, true);
 		if (!ret && !q6apm_fullio_mute_is_verified(graph))
 			ret = -ESTALE;
@@ -1368,7 +1371,12 @@
 	/* A START timeout can leave DSP execution uncertain. Attempt STOP
 	 * whenever START was attempted, even if verification or START failed.
 	 */
+	stop_begin_ns = ktime_get_ns();
 	stop = audioreach_graph_mgmt_transaction(ar, APM_CMD_GRAPH_STOP, true);
+	if (of_property_read_bool(node, "microsoft,denali-fullio-immediate-taps-audit"))
+		dev_info(graph->dev,
+			 "FullIO tap host window: start_ack_ns=%llu stop_begin_ns=%llu verify=%d stop=%d\n",
+			 start_ack_ns, stop_begin_ns, ret, stop);
 	if (stop)
 		return dev_err_probe(graph->dev, stop, "FullIO audit GRAPH_STOP unverified; no retry\n");
 	if (ret)
